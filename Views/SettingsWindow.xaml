<Window x:Class="Win11Notch.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Win11Notch Settings"
        Width="680" Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SubLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888C94"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="ColorSwatchBtn" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="swatchBd" Background="{TemplateBinding Background}" CornerRadius="12" BorderThickness="1.5" BorderBrush="#50FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="swatchBd" Property="BorderBrush" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Dock Edge Radio Pill -->
        <Style x:Key="DockRadioPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#A0A4AC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#16FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#28FF5E36"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#70FF5E36"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Coral-Orange Modern Slider -->
        <Style x:Key="ThumbStyle" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="Glow" Fill="#45FF5E36" Width="20" Height="20" Margin="-3" Visibility="Collapsed"/>
                            <Ellipse Fill="#FFFFFF" Stroke="#40000000" StrokeThickness="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" Background="#242730"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3" Background="#FF5E36"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark Acrylic ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="#1CFFFFFF" BorderBrush="#2CFFFFFF" BorderThickness="1" CornerRadius="9" Padding="10,5">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70D;" DockPanel.Dock="Right" Foreground="#90FFFFFF" FontSize="9.5" VerticalAlignment="Center" Margin="6,1,0,0"/>
                                                <ContentPresenter/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#28FFFFFF"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#48FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Margin="11,0,26,0"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#F51A1C20"
                                            BorderBrush="#38FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="4"
                                            Margin="0,4,0,4">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#38FF5E36"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill ToggleSwitch CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel LastChildFill="True">
                            <Border x:Name="track" DockPanel.Dock="Right" Width="36" Height="20" CornerRadius="10"
                                    Background="#28FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Ellipse x:Name="knob" Width="14" Height="14" Fill="White"
                                         HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#FF5E36"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="#FF7350"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="BorderBrush" Value="#60FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Left Sidebar Category Nav Item -->
        <Style x:Key="SidebarNavTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#9A9EA6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="11,9">
                            <Grid>
                                <Border x:Name="indicator" Width="3" Height="16" CornerRadius="1.5" Background="#FF5E36"
                                        HorizontalAlignment="Left" Margin="-5,0,0,0" Visibility="Collapsed"/>
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#16FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2CFFFFFF"/>
                                <Setter TargetName="indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal Translucent ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="2.5" Background="#35FFFFFF"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Frosted Bento Slate Shell -->
    <Border Background="#EC16181D"
            BorderBrush="#32FFFFFF"
            BorderThickness="1"
            CornerRadius="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="192"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left Navigation Sidebar ───────────────────────────────── -->
            <Border Grid.Column="0" Background="#0EFFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="0,0,1,0" CornerRadius="20,0,0,20" Padding="14,16">
                <DockPanel LastChildFill="True">
                    <!-- Brand Header (Draggable) -->
                    <StackPanel DockPanel.Dock="Top" Margin="4,0,4,18" MouseLeftButtonDown="OnTitleBarMouseDown" Background="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="8" Background="#28FF5E36" BorderBrush="#55FF5E36" BorderThickness="1" Margin="0,0,9,0">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" Foreground="#FF5E36" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Win11Notch" Foreground="White" FontSize="14.5" FontWeight="Bold"/>
                                <TextBlock Text="Control Center" Foreground="#75FFFFFF" FontSize="10.5"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Bottom RAM Badge & Reset Action -->
                    <Border DockPanel.Dock="Bottom" Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="12" Padding="11,10" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Working Set" Foreground="#80FFFFFF" FontSize="10.5" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentMemoryText}" DockPanel.Dock="Right" Foreground="#FF5E36" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Button Command="{Binding ResetDefaultsCommand}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#1AFFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="8" Padding="8,6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="10.5" Foreground="#D0FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Reset Defaults" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#28FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Category Selector List (synced with TabControl SelectedIndex) -->
                    <StackPanel>
                        <ListBox SelectedIndex="{Binding SelectedCategoryIndex, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                    <Setter Property="Foreground" Value="#9A9EA6"/>
                                    <Setter Property="FontSize" Value="12.5"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="10,9">
                                                    <Grid>
                                                        <Border x:Name="accent" Width="3" Height="15" CornerRadius="1.5" Background="#FF5E36"
                                                                HorizontalAlignment="Left" Visibility="Collapsed"/>
                                                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#20FFFFFF"/>
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#2EFFFFFF"/>
                                                        <Setter TargetName="accent" Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7F4;" FontSize="13" Foreground="#FF5E36" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="General &amp; Dock" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE790;" FontSize="13" Foreground="#FF5E36" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Appearance" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE916;" FontSize="13" Foreground="#FF5E36" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Timers &amp; Island" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="13" Foreground="#FF5E36" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="System &amp; Keys" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── Right Content Pane ─────────────────────────────────────── -->
            <Grid Grid.Column="1" Margin="18,14,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Draggable Top Bar + Close -->
                <DockPanel Grid.Row="0" Margin="2,0,0,14" MouseLeftButtonDown="OnTitleBarMouseDown" Background="Transparent">
                    <Button DockPanel.Dock="Right"
                            Click="OnCloseClick"
                            Cursor="Hand" FocusVisualStyle="{x:Null}"
                            ToolTip="Close Settings">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Width="28" Height="28" CornerRadius="14" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" Foreground="#B0FFFFFF" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#30FF5E36"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#60FF5E36"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Text="Preferences" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Category Pages -->
                <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedCategoryIndex}" Background="Transparent" BorderThickness="0" Padding="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <!-- PAGE 0: GENERAL & DOCK -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,6,0">
                                <!-- Dock Edge & Target Display -->
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Screen Dock Edge &amp; Display"/>
                                        <TextBlock Style="{StaticResource SubLabel}" Text="Anchor the notch cleanly to your preferred screen edge and display."/>

                                        <Border Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="11" Padding="3" Margin="0,12,0,12" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="RadioTop" Style="{StaticResource DockRadioPill}" Content="Top" Checked="OnDockTopChecked"/>
                                                <RadioButton x:Name="RadioLeft" Style="{StaticResource DockRadioPill}" Content="Left" Checked="OnDockLeftChecked" Margin="2,0"/>
                                                <RadioButton x:Name="RadioRight" Style="{StaticResource DockRadioPill}" Content="Right" Checked="OnDockRightChecked"/>
                                            </StackPanel>
                                        </Border>

                                        <DockPanel>
                                            <TextBlock Text="Target Display" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                            <ComboBox ItemsSource="{Binding Monitors}"
                                                      SelectedValue="{Binding TargetMonitorIndex}"
                                                      SelectedValuePath="Index"
                                                      DisplayMemberPath="Name"
                                                      DockPanel.Dock="Right"
                                                      Width="230"
                                                      HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Interaction Delays -->
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Interaction Timing"/>
                                        <TextBlock Style="{StaticResource SubLabel}" Text="Fine-tune hover dwell sensitivity and collapse delay."/>

                                        <DockPanel Margin="0,12,0,6">
                                            <TextBlock Text="Hover Dwell Delay" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding HoverDwellMs, StringFormat='{}{0} ms'}" Foreground="#FF5E36" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding HoverDwellMs}" Minimum="50" Maximum="500" Margin="14,0" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <DockPanel Margin="0,6,0,10">
                                            <TextBlock Text="Exit Grace Delay" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ExitGraceMs, StringFormat='{}{0} ms'}" Foreground="#FF5E36" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding ExitGraceMs}" Minimum="100" Maximum="1000" Margin="14,0" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <CheckBox Content="Expand automatically when dragging files to edge"
                                                  IsChecked="{Binding AutoExpandOnDrag}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- PAGE 1: APPEARANCE & HANDLE -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,6,0">
                                <!-- Idle Handle Customization -->
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Idle Handle Geometry &amp; Tint"/>
                                        <TextBlock Style="{StaticResource SubLabel}" Text="Customize resting pill size, opacity, and frosted glass tint."/>

                                        <DockPanel Margin="0,12,0,4">
                                            <TextBlock Text="Handle Width" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding HandleWidth, StringFormat='{}{0} px'}" Foreground="#FF5E36" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding HandleWidth}" Minimum="40" Maximum="180" Margin="14,0" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <DockPanel Margin="0,8,0,4">
                                            <TextBlock Text="Handle Thickness" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding HandleThickness, StringFormat='{}{0} px'}" Foreground="#FF5E36" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding HandleThickness}" Minimum="4" Maximum="16" Margin="14,0" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <DockPanel Margin="0,8,0,10">
                                            <TextBlock Text="Idle Opacity" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding IdleOpacityPercent, StringFormat='{}{0}%'}" Foreground="#FF5E36" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding IdleOpacityPercent}" Minimum="10" Maximum="50" Margin="14,0" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <TextBlock Text="Handle Tint Preset" Foreground="White" FontSize="12" Margin="0,2,0,8"/>
                                        <DockPanel LastChildFill="True">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                <Button Style="{StaticResource ColorSwatchBtn}" Background="#E61A1C20" ToolTip="Dark Slate Frost (Default)" Command="{Binding SelectHandleColorCommand}" CommandParameter="#E61A1C20"/>
                                                <Button Style="{StaticResource ColorSwatchBtn}" Background="#99282C35" ToolTip="Pure Glass" Command="{Binding SelectHandleColorCommand}" CommandParameter="#99282C35"/>
                                                <Button Style="{StaticResource ColorSwatchBtn}" Background="#E6122E22" ToolTip="Emerald Aurora" Command="{Binding SelectHandleColorCommand}" CommandParameter="#E6122E22"/>
                                                <Button Style="{StaticResource ColorSwatchBtn}" Background="#E6221435" ToolTip="Cyberpunk Neon" Command="{Binding SelectHandleColorCommand}" CommandParameter="#E6221435"/>
                                                <Button Style="{StaticResource ColorSwatchBtn}" Background="#E6102238" ToolTip="Deep Ocean" Command="{Binding SelectHandleColorCommand}" CommandParameter="#E6102238"/>
                                                <Button Style="{StaticResource ColorSwatchBtn}" Background="#E635181A" ToolTip="Sunset Ember" Command="{Binding SelectHandleColorCommand}" CommandParameter="#E635181A"/>
                                                <Button Style="{StaticResource ColorSwatchBtn}" Background="#C0E0E5FF" ToolTip="Specular White" Command="{Binding SelectHandleColorCommand}" CommandParameter="#C0E0E5FF"/>
                                            </StackPanel>
                                            <Border Background="#18FFFFFF" BorderBrush="#2CFFFFFF" BorderThickness="1" CornerRadius="8" Padding="6,3" HorizontalAlignment="Right">
                                                <TextBox Text="{Binding HandleColor, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="Transparent" Foreground="White" CaretBrush="#FF5E36"
                                                         BorderThickness="0" FontSize="11" Width="76" VerticalAlignment="Center"/>
                                            </Border>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Visual Effects & Borders -->
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Acrylic Glass &amp; Border Glow"/>
                                        <TextBlock Style="{StaticResource SubLabel}" Text="Configure animated outline presets and dark-slate backdrop tint."/>

                                        <DockPanel Margin="0,12,0,10">
                                            <TextBlock Text="Border Outline Preset" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                            <ComboBox SelectedValue="{Binding BorderAnimationPreset}"
                                                      SelectedValuePath="Tag"
                                                      DockPanel.Dock="Right"
                                                      Width="200"
                                                      HorizontalAlignment="Right">
                                                <ComboBoxItem Content="None (Specular Glass)" Tag="None"/>
                                                <ComboBoxItem Content="Breathing Glow" Tag="BreathingGlow"/>
                                                <ComboBoxItem Content="Rainbow Chroma Wave" Tag="RainbowWave"/>
                                                <ComboBoxItem Content="Cyberpunk Neon Glow" Tag="NeonGlow"/>
                                            </ComboBox>
                                        </DockPanel>

                                        <DockPanel Margin="0,4,0,10">
                                            <TextBlock Text="Acrylic Tint Opacity" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding AcrylicTintPercent, StringFormat='{}{0}%'}" Foreground="#FF5E36" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding AcrylicTintPercent}" Minimum="50" Maximum="90" Margin="14,0" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <CheckBox Content="Dynamically resize notch based on active music &amp; timers"
                                                  IsChecked="{Binding DynamicContentSizing}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- PAGE 2: TIMERS & ISLAND -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,6,0">
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Productivity &amp; Timers"/>
                                        <TextBlock Style="{StaticResource SubLabel}" Text="Default Pomodoro intervals, hydration goal, and multi-activity island."/>

                                        <DockPanel Margin="0,12,0,4">
                                            <TextBlock Text="Focus Session Duration" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DefaultFocusMinutes, StringFormat='{}{0} min'}" Foreground="#FF5E36" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding DefaultFocusMinutes}" Minimum="5" Maximum="60" SmallChange="5" LargeChange="10" Margin="14,0" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <DockPanel Margin="0,8,0,4">
                                            <TextBlock Text="Short Break Duration" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DefaultBreakMinutes, StringFormat='{}{0} min'}" Foreground="#FF5E36" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding DefaultBreakMinutes}" Minimum="1" Maximum="30" SmallChange="1" LargeChange="5" Margin="14,0" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <DockPanel Margin="0,8,0,12">
                                            <TextBlock Text="Daily Hydration Goal" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DailyWaterTargetCups, StringFormat='{}{0} cups'}" Foreground="#FF5E36" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding DailyWaterTargetCups}" Minimum="4" Maximum="16" SmallChange="1" LargeChange="2" Margin="14,0" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <CheckBox Content="Play chime alert when focus intervals complete"
                                                  IsChecked="{Binding TimerSoundChimesEnabled}" Margin="0,0,0,10"/>

                                        <CheckBox Content="Split-pill Dual Activity display (Music + Timer concurrently)"
                                                  IsChecked="{Binding DualActivityEnabled}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- PAGE 3: SYSTEM & KEYS -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,6,0">
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource HeaderLabel}" Text="System Integration &amp; Hotkeys"/>
                                        <TextBlock Style="{StaticResource SubLabel}" Text="Startup behavior, Dynamic Island toasts, and global shortcut."/>

                                        <CheckBox Content="Launch Win11Notch automatically at Windows startup"
                                                  IsChecked="{Binding LaunchAtStartup}" Margin="0,12,0,12"/>

                                        <CheckBox Content="Dynamic Island toast banner on song changes"
                                                  IsChecked="{Binding ShowMediaIslandNotifications}" Margin="0,0,0,14"/>

                                        <DockPanel>
                                            <TextBlock Text="Global Toggle Hotkey" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                            <ComboBox SelectedValue="{Binding HotkeyPreset}"
                                                      SelectedValuePath="Tag"
                                                      DockPanel.Dock="Right"
                                                      Width="180"
                                                      HorizontalAlignment="Right">
                                                <ComboBoxItem Content="Alt + Space" Tag="Alt+Space"/>
                                                <ComboBoxItem Content="Win + Z" Tag="Win+Z"/>
                                                <ComboBoxItem Content="Ctrl + Shift + Space" Tag="Ctrl+Shift+Space"/>
                                                <ComboBoxItem Content="Ctrl + ~" Tag="Ctrl+~"/>
                                            </ComboBox>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Border>
</Window>
