<Window x:Class="Win11Notch.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Win11Notch Settings"
        Width="460" Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SubLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#80FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <!-- Outer frosted window border matching IPS dark-slate acrylic -->
    <Border Background="#E61A1C20"
            BorderBrush="#35FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Titlebar -->
                <RowDefinition Height="*"/>    <!-- Settings Body -->
            </Grid.RowDefinitions>

            <!-- ── Custom Titlebar ──────────────────────────────────────── -->
            <DockPanel Grid.Row="0" Margin="4,0,4,14" MouseLeftButtonDown="OnTitleBarMouseDown">
                <Button DockPanel.Dock="Right"
                        Content="✕"
                        Click="OnCloseClick"
                        Foreground="#80FFFFFF"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="12"
                        Padding="6,4"
                        Cursor="Hand"/>
                <TextBlock Text="⚙ Win11Notch Settings"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- ── Settings Body ────────────────────────────────────────── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">

                    <!-- Card 1: Docking Position -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HeaderLabel}" Text="Screen Dock Edge"/>
                            <TextBlock Style="{StaticResource SubLabel}" Text="Choose which monitor border anchors the notch."/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                                <RadioButton Content="⬆ Top"
                                             Foreground="White" Margin="0,0,16,0"
                                             Checked="OnDockTopChecked" x:Name="RadioTop"/>
                                <RadioButton Content="⬅ Left" Foreground="White" Margin="0,0,16,0"
                                             Checked="OnDockLeftChecked" x:Name="RadioLeft"/>
                                <RadioButton Content="➡ Right" Foreground="White"
                                             Checked="OnDockRightChecked" x:Name="RadioRight"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Appearance & Opacity -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HeaderLabel}" Text="Appearance &amp; Glass Tint"/>
                            <TextBlock Style="{StaticResource SubLabel}" Text="Fine-tune frosted acrylic visibility on your IPS display."/>

                            <!-- Idle Opacity Slider -->
                            <DockPanel Margin="0,10,0,4">
                                <TextBlock Text="Idle Pill Opacity:" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding IdleOpacityPercent, StringFormat='{}{0}%'}" Foreground="#4CAF50" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                <Slider Value="{Binding IdleOpacityPercent}" Minimum="10" Maximum="50" Margin="12,0" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Acrylic Tint Opacity Slider -->
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Acrylic Tint Opacity:" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding AcrylicTintPercent, StringFormat='{}{0}%'}" Foreground="#2196F3" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                <Slider Value="{Binding AcrylicTintPercent}" Minimum="50" Maximum="90" Margin="12,0" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Interaction Timers -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HeaderLabel}" Text="Interaction Delays"/>
                            <TextBlock Style="{StaticResource SubLabel}" Text="Control hover sensitivity and exit timing."/>

                            <!-- Hover Dwell Delay -->
                            <DockPanel Margin="0,10,0,4">
                                <TextBlock Text="Hover Dwell Delay:" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding HoverDwellMs, StringFormat='{}{0} ms'}" Foreground="#FFC107" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                <Slider Value="{Binding HoverDwellMs}" Minimum="50" Maximum="500" Margin="12,0" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Exit Grace Delay -->
                            <DockPanel Margin="0,8,0,4">
                                <TextBlock Text="Exit Grace Delay:" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ExitGraceMs, StringFormat='{}{0} ms'}" Foreground="#FFC107" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                <Slider Value="{Binding ExitGraceMs}" Minimum="100" Maximum="1000" Margin="12,0" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Auto-expand on drag -->
                            <CheckBox Content="Expand automatically when dragging files to edge"
                                      IsChecked="{Binding AutoExpandOnDrag}"
                                      Foreground="White" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: System Integration -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource HeaderLabel}" Text="Launch on Startup"/>
                                    <TextBlock Style="{StaticResource SubLabel}" Text="Start Win11Notch automatically when you log in."/>
                                </StackPanel>
                                <CheckBox IsChecked="{Binding LaunchAtStartup}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <CheckBox Content="Dynamic Island song change notifications"
                                      IsChecked="{Binding ShowMediaIslandNotifications}"
                                      Foreground="White" FontSize="12" Margin="0,10,0,0"/>

                            <!-- Hotkey Preset Selector -->
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock Text="Global Hotkey Shortcut:" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                <ComboBox SelectedValue="{Binding HotkeyPreset}"
                                          SelectedValuePath="Tag"
                                          DockPanel.Dock="Right"
                                          Width="150"
                                          HorizontalAlignment="Right">
                                    <ComboBoxItem Content="Alt + Space" Tag="Alt+Space"/>
                                    <ComboBoxItem Content="Win + Z" Tag="Win+Z"/>
                                    <ComboBoxItem Content="Ctrl + Shift + Space" Tag="Ctrl+Shift+Space"/>
                                    <ComboBoxItem Content="Ctrl + ~" Tag="Ctrl+~"/>
                                </ComboBox>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 5: About & Memory Diagnostics -->
                    <Border Style="{StaticResource SettingsCard}">
                        <DockPanel LastChildFill="True">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource HeaderLabel}" Text="Diagnostics &amp; Memory"/>
                                <TextBlock Text="{Binding CurrentMemoryText, StringFormat='RAM Usage: {0}'}"
                                           Foreground="#80FFFFFF" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Content="Reset Defaults"
                                    Command="{Binding ResetDefaultsCommand}"
                                    DockPanel.Dock="Right"
                                    Foreground="White" Background="#20FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1"
                                    Padding="10,4" Cursor="Hand" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
