<Window x:Class="Win11Notch.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Win11Notch Settings"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="680" Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Thin Minimal Sleek Pill ScrollBar & Simple ScrollViewer -->
        <Style TargetType="ScrollBar">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="4"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Margin" Value="2,2,0,2"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="thumbBd" Width="4" CornerRadius="2" Background="#32FFFFFF"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="thumbBd" Property="Background" Value="#64FFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="thumbBd" Property="Background" Value="#88FF5E36"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="4"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Margin" Value="2,2,2,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" IsTabStop="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="thumbBd" Height="4" CornerRadius="2" Background="#32FFFFFF"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="thumbBd" Property="Background" Value="#64FFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="thumbBd" Property="Background" Value="#88FF5E36"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" IsTabStop="False"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter Grid.Row="0" Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Row="0" Grid.Column="1"
                                       Orientation="Vertical"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       AutomationProperties.AutomationId="VerticalScrollBar"/>

                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1" Grid.Column="0"
                                       Orientation="Horizontal"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       AutomationProperties.AutomationId="HorizontalScrollBar"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SubLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888C94"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="ColorSwatchBtn" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="swatchBd" Background="{TemplateBinding Background}" CornerRadius="12" BorderThickness="1.5" BorderBrush="#50FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="swatchBd" Property="BorderBrush" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Dock Edge Radio Pill -->
        <Style x:Key="DockRadioPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#A0A4AC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#16FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#28FF5E36"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#70FF5E36"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Coral-Orange Modern Slider -->
        <Style x:Key="ThumbStyle" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="Glow" Fill="#45FF5E36" Width="20" Height="20" Margin="-3" Visibility="Collapsed"/>
                            <Ellipse Fill="#FFFFFF" Stroke="#40000000" StrokeThickness="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" Background="#242730"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3" Background="#FF5E36"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark Acrylic ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1CFFFFFF"/>
            <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,0,28,0"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid MinHeight="{TemplateBinding MinHeight}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <ToggleButton x:Name="ToggleButton"
                                          Style="{x:Null}"
                                          OverridesDefaultStyle="True"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Cursor="Hand"
                                          FocusVisualStyle="{x:Null}"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Background="#1CFFFFFF"
                                                BorderBrush="#2EFFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                SnapsToDevicePixels="True">
                                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <TextBlock x:Name="Chevron"
                                                           FontFamily="Segoe Fluent Icons"
                                                           Text="&#xE70D;"
                                                           Foreground="#B8FFFFFF"
                                                           FontSize="9.5"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,1,11,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#48FFFFFF"/>
                                                <Setter TargetName="Chevron" Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#28FFFFFF"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#80FF5E36"/>
                                                <Setter TargetName="Chevron" Property="Foreground" Value="#FF5E36"/>
                                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#F51A1C20"
                                            BorderBrush="#38FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="4"
                                            Margin="0,4,0,4">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#38FF5E36"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill ToggleSwitch CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel LastChildFill="True">
                            <Border x:Name="track" DockPanel.Dock="Right" Width="36" Height="20" CornerRadius="10"
                                    Background="#28FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Ellipse x:Name="knob" Width="14" Height="14" Fill="White"
                                         HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#FF5E36"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="#FF7350"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="BorderBrush" Value="#60FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Frosted Bento Slate Shell -->
    <Border Background="#EC16181D"
            BorderBrush="#32FFFFFF"
            BorderThickness="1"
            CornerRadius="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="192"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left Navigation Sidebar ───────────────────────────────── -->
            <Border Grid.Column="0" Background="#0EFFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="0,0,1,0" CornerRadius="20,0,0,20" Padding="14,16">
                <DockPanel LastChildFill="True">
                    <!-- Brand Header (Draggable) -->
                    <StackPanel DockPanel.Dock="Top" Margin="4,0,4,18" MouseLeftButtonDown="OnTitleBarMouseDown" Background="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="8" Background="#28FF5E36" BorderBrush="#55FF5E36" BorderThickness="1" Margin="0,0,9,0">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" Foreground="#FF5E36" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Win11Notch" Foreground="White" FontSize="14.5" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SidebarGreetingText}" Foreground="#98FFFFFF" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Bottom RAM Badge & Reset Action -->
                    <Border DockPanel.Dock="Bottom" Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="12" Padding="11,10" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Working Set" Foreground="#80FFFFFF" FontSize="10.5" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentMemoryText}" DockPanel.Dock="Right" Foreground="#FF5E36" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Button Command="{Binding ResetDefaultsCommand}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#1AFFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="8" Padding="8,6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="10.5" Foreground="#D0FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Reset Defaults" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#28FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Category Selector List (synced with TabControl SelectedIndex) -->
                    <StackPanel>
                        <ListBox SelectedIndex="{Binding SelectedCategoryIndex, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                    <Setter Property="Foreground" Value="#9A9EA6"/>
                                    <Setter Property="FontSize" Value="12.5"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="10,9">
                                                    <Grid>
                                                        <Border x:Name="accent" Width="3" Height="15" CornerRadius="1.5" Background="#FF5E36"
                                                                HorizontalAlignment="Left" Visibility="Collapsed"/>
                                                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#20FFFFFF"/>
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#2EFFFFFF"/>
                                                        <Setter TargetName="accent" Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7F4;" FontSize="13" Foreground="#FF5E36" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="General &amp; Dock" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE790;" FontSize="13" Foreground="#FF5E36" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Appearance" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE916;" FontSize="13" Foreground="#FF5E36" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Timers &amp; Island" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="13" Foreground="#FF5E36" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="System &amp; Keys" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE946;" FontSize="13" Foreground="#FF5E36" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="About &amp; License" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── Right Content Pane ─────────────────────────────────────── -->
            <Grid Grid.Column="1" Margin="18,14,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Draggable Top Bar + Close -->
                <DockPanel Grid.Row="0" Margin="2,0,0,14" MouseLeftButtonDown="OnTitleBarMouseDown" Background="Transparent">
                    <Button DockPanel.Dock="Right"
                            Click="OnCloseClick"
                            Cursor="Hand" FocusVisualStyle="{x:Null}"
                            ToolTip="Close Settings">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Width="28" Height="28" CornerRadius="14" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" Foreground="#B0FFFFFF" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#30FF5E36"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#60FF5E36"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Text="Preferences" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Category Pages -->
                <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedCategoryIndex}" Background="Transparent" BorderThickness="0" Padding="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <!-- PAGE 0: GENERAL & DOCK -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,6,0">
                                <!-- Dock Edge & Target Display -->
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Screen Dock Edge &amp; Display"/>
                                        <TextBlock Style="{StaticResource SubLabel}" Text="Anchor the notch cleanly to your preferred screen edge and display."/>

                                        <Border Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="11" Padding="3" Margin="0,12,0,12" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource DockRadioPill}" Content="Top" IsChecked="{Binding IsDockTop, Mode=OneWay}" Command="{Binding SelectDockEdgeCommand}" CommandParameter="Top"/>
                                                <RadioButton Style="{StaticResource DockRadioPill}" Content="Left" IsChecked="{Binding IsDockLeft, Mode=OneWay}" Command="{Binding SelectDockEdgeCommand}" CommandParameter="Left" Margin="2,0"/>
                                                <RadioButton Style="{StaticResource DockRadioPill}" Content="Right" IsChecked="{Binding IsDockRight, Mode=OneWay}" Command="{Binding SelectDockEdgeCommand}" CommandParameter="Right"/>
                                            </StackPanel>
                                        </Border>

                                        <DockPanel>
                                            <TextBlock Text="Target Display" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                            <ComboBox ItemsSource="{Binding Monitors}"
                                                      SelectedValue="{Binding TargetMonitorIndex}"
                                                      SelectedValuePath="Index"
                                                      DisplayMemberPath="Name"
                                                      DockPanel.Dock="Right"
                                                      Width="230"
                                                      HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Interaction Delays -->
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Interaction Timing"/>
                                        <TextBlock Style="{StaticResource SubLabel}" Text="Fine-tune hover dwell sensitivity and collapse delay."/>

                                        <DockPanel Margin="0,12,0,6">
                                            <TextBlock Text="Hover Dwell Delay" Foreground="White" FontSize="12" Width="138" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding HoverDwellMs, StringFormat='{}{0} ms'}" Foreground="#FF5E36" FontWeight="Bold" FontSize="12" Width="54" TextAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding HoverDwellMs}" Minimum="50" Maximum="500" Margin="14,0" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <DockPanel Margin="0,6,0,10">
                                            <TextBlock Text="Exit Grace Delay" Foreground="White" FontSize="12" Width="138" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ExitGraceMs, StringFormat='{}{0} ms'}" Foreground="#FF5E36" FontWeight="Bold" FontSize="12" Width="54" TextAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding ExitGraceMs}" Minimum="100" Maximum="1000" Margin="14,0" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <CheckBox Content="Expand automatically when dragging files to edge"
                                                  IsChecked="{Binding AutoExpandOnDrag}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- PAGE 1: APPEARANCE & HANDLE -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,6,0">
                                <!-- Smart Desktop & Context Behavior -->
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Smart Desktop &amp; Context Behavior"/>
                                        <TextBlock Style="{StaticResource SubLabel}" Text="Control whether Live Preview and the Pill appear on Desktop vs active apps."/>

                                        <DockPanel Margin="0,12,0,10">
                                            <TextBlock Text="Handle Visibility Mode" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                            <ComboBox SelectedValue="{Binding HandleVisibilityMode}"
                                                      SelectedValuePath="Tag"
                                                      DockPanel.Dock="Right"
                                                      Width="255"
                                                      HorizontalAlignment="Right">
                                                <ComboBoxItem Content="Smart Desktop (Live on Desktop, Pill in Apps)" Tag="SmartDesktop"/>
                                                <ComboBoxItem Content="Desktop Only (Hide Pill Over Apps)" Tag="DesktopOnly"/>
                                                <ComboBoxItem Content="Always Show Live Preview" Tag="AlwaysLive"/>
                                            </ComboBox>
                                        </DockPanel>

                                        <CheckBox Content="Show Ambient Clock &amp; Battery glance when Desktop is idle"
                                                  IsChecked="{Binding ShowDesktopAmbientGlance}" Margin="0,0,0,8"/>

                                        <CheckBox Content="Always keep Hover Capsule visible instead of shrinking to resting pill"
                                                  IsChecked="{Binding AlwaysShowHoverCapsule}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Idle Handle Customization -->
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Idle Handle Geometry &amp; Tint"/>
                                        <TextBlock Style="{StaticResource SubLabel}" Text="Customize resting pill size, opacity, and frosted glass tint."/>

                                        <DockPanel Margin="0,12,0,4">
                                            <TextBlock Text="Handle Width" Foreground="White" FontSize="12" Width="138" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding HandleWidth, StringFormat='{}{0} px'}" Foreground="#FF5E36" FontWeight="Bold" FontSize="12" Width="54" TextAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding HandleWidth}" Minimum="40" Maximum="180" Margin="14,0" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <DockPanel Margin="0,8,0,4">
                                            <TextBlock Text="Handle Thickness" Foreground="White" FontSize="12" Width="138" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding HandleThickness, StringFormat='{}{0} px'}" Foreground="#FF5E36" FontWeight="Bold" FontSize="12" Width="54" TextAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding HandleThickness}" Minimum="4" Maximum="16" Margin="14,0" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <DockPanel Margin="0,8,0,10">
                                            <TextBlock Text="Idle Opacity" Foreground="White" FontSize="12" Width="138" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding IdleOpacityPercent, StringFormat='{}{0}%'}" Foreground="#FF5E36" FontWeight="Bold" FontSize="12" Width="54" TextAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding IdleOpacityPercent}" Minimum="10" Maximum="100" Margin="14,0" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <TextBlock Text="Handle Tint Preset" Foreground="White" FontSize="12" Margin="0,2,0,8"/>
                                        <DockPanel LastChildFill="True">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                <Button Style="{StaticResource ColorSwatchBtn}" Background="#E61A1C20" ToolTip="Dark Slate Frost (Default)" Command="{Binding SelectHandleColorCommand}" CommandParameter="#E61A1C20"/>
                                                <Button Style="{StaticResource ColorSwatchBtn}" Background="#99282C35" ToolTip="Pure Glass" Command="{Binding SelectHandleColorCommand}" CommandParameter="#99282C35"/>
                                                <Button Style="{StaticResource ColorSwatchBtn}" Background="#E6122E22" ToolTip="Emerald Aurora" Command="{Binding SelectHandleColorCommand}" CommandParameter="#E6122E22"/>
                                                <Button Style="{StaticResource ColorSwatchBtn}" Background="#E6221435" ToolTip="Cyberpunk Neon" Command="{Binding SelectHandleColorCommand}" CommandParameter="#E6221435"/>
                                                <Button Style="{StaticResource ColorSwatchBtn}" Background="#E6102238" ToolTip="Deep Ocean" Command="{Binding SelectHandleColorCommand}" CommandParameter="#E6102238"/>
                                                <Button Style="{StaticResource ColorSwatchBtn}" Background="#E635181A" ToolTip="Sunset Ember" Command="{Binding SelectHandleColorCommand}" CommandParameter="#E635181A"/>
                                                <Button Style="{StaticResource ColorSwatchBtn}" Background="#C0E0E5FF" ToolTip="Specular White" Command="{Binding SelectHandleColorCommand}" CommandParameter="#C0E0E5FF"/>
                                            </StackPanel>
                                            <Border Background="#18FFFFFF" BorderBrush="#2CFFFFFF" BorderThickness="1" CornerRadius="8" Padding="6,3" HorizontalAlignment="Right">
                                                <TextBox Text="{Binding HandleColor, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="Transparent" Foreground="White" CaretBrush="#FF5E36"
                                                         BorderThickness="0" FontSize="11" Width="76" VerticalAlignment="Center"/>
                                            </Border>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Visual Effects & Borders -->
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Acrylic Glass &amp; Border Glow"/>
                                        <TextBlock Style="{StaticResource SubLabel}" Text="Configure animated outline presets and dark-slate backdrop tint."/>

                                        <DockPanel Margin="0,12,0,10">
                                            <TextBlock Text="Border Outline Preset" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                            <ComboBox SelectedValue="{Binding BorderAnimationPreset}"
                                                      SelectedValuePath="Tag"
                                                      DockPanel.Dock="Right"
                                                      Width="200"
                                                      HorizontalAlignment="Right">
                                                <ComboBoxItem Content="None (Specular Glass)" Tag="None"/>
                                                <ComboBoxItem Content="Meteor White Line (Back &amp; Forth)" Tag="MeteorSweep"/>
                                                <ComboBoxItem Content="Mac Apple Glow (Iridescent Aura)" Tag="MacAppleGlow"/>
                                                <ComboBoxItem Content="Breathing Glow" Tag="BreathingGlow"/>
                                                <ComboBoxItem Content="Rainbow Chroma Wave" Tag="RainbowWave"/>
                                                <ComboBoxItem Content="Cyberpunk Neon Glow" Tag="NeonGlow"/>
                                            </ComboBox>
                                        </DockPanel>

                                        <DockPanel Margin="0,4,0,10">
                                            <TextBlock Text="Acrylic Tint Opacity" Foreground="White" FontSize="12" Width="138" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding AcrylicTintPercent, StringFormat='{}{0}%'}" Foreground="#FF5E36" FontWeight="Bold" FontSize="12" Width="54" TextAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding AcrylicTintPercent}" Minimum="50" Maximum="90" Margin="14,0" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <CheckBox Content="Dynamically resize notch based on active music &amp; timers"
                                                  IsChecked="{Binding DynamicContentSizing}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- PAGE 2: TIMERS & ISLAND -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,6,0">
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Productivity &amp; Timers"/>
                                        <TextBlock Style="{StaticResource SubLabel}" Text="Default Pomodoro intervals, hydration goal, and multi-activity island."/>

                                        <DockPanel Margin="0,12,0,4">
                                            <TextBlock Text="Focus Session Duration" Foreground="White" FontSize="12" Width="148" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DefaultFocusMinutes, StringFormat='{}{0} min'}" Foreground="#FF5E36" FontWeight="Bold" FontSize="12" Width="54" TextAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding DefaultFocusMinutes}" Minimum="5" Maximum="60" SmallChange="5" LargeChange="10" Margin="14,0" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <DockPanel Margin="0,8,0,4">
                                            <TextBlock Text="Short Break Duration" Foreground="White" FontSize="12" Width="148" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DefaultBreakMinutes, StringFormat='{}{0} min'}" Foreground="#FF5E36" FontWeight="Bold" FontSize="12" Width="54" TextAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding DefaultBreakMinutes}" Minimum="1" Maximum="30" SmallChange="1" LargeChange="5" Margin="14,0" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <DockPanel Margin="0,8,0,12">
                                            <TextBlock Text="Daily Hydration Goal" Foreground="White" FontSize="12" Width="148" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DailyWaterTargetCups, StringFormat='{}{0} cups'}" Foreground="#FF5E36" FontWeight="Bold" FontSize="12" Width="54" TextAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding DailyWaterTargetCups}" Minimum="4" Maximum="16" SmallChange="1" LargeChange="2" Margin="14,0" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <CheckBox Content="Play chime alert when focus intervals complete"
                                                  IsChecked="{Binding TimerSoundChimesEnabled}" Margin="0,0,0,10"/>

                                        <CheckBox Content="Split-pill Dual Activity display (Music + Timer concurrently)"
                                                  IsChecked="{Binding DualActivityEnabled}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Calendar, Clock &amp; Reminders"/>
                                        <TextBlock Style="{StaticResource SubLabel}" Text="Configure 12-hour AM/PM formatting, reminder chimes, and pill snooze duration."/>

                                        <CheckBox Content="Use 24-hour clock format (off = 12-hour AM/PM across Notch &amp; Calendar)"
                                                  IsChecked="{Binding Use24HourClock}" Margin="0,12,0,10"/>

                                        <CheckBox Content="Play chime alert when a calendar reminder triggers"
                                                  IsChecked="{Binding ReminderSoundChimesEnabled}" Margin="0,0,0,12"/>

                                        <DockPanel>
                                            <TextBlock Text="Default Pill Snooze Interval" Foreground="White" FontSize="12" Width="148" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DefaultReminderSnoozeMinutes, StringFormat='{}{0} min'}" Foreground="#FF5E36" FontWeight="Bold" FontSize="12" Width="54" TextAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                            <Slider Value="{Binding DefaultReminderSnoozeMinutes}" Minimum="5" Maximum="30" TickFrequency="5" IsSnapToTickEnabled="True" Margin="14,0" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- PAGE 3: SYSTEM & KEYS -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,6,0">
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource HeaderLabel}" Text="System Integration &amp; Hotkeys"/>
                                        <TextBlock Style="{StaticResource SubLabel}" Text="Startup behavior, Dynamic Island toasts, and global shortcut."/>

                                        <CheckBox Content="Launch Win11Notch automatically at Windows startup"
                                                  IsChecked="{Binding LaunchAtStartup}" Margin="0,12,0,12"/>

                                        <CheckBox Content="Dynamic Island toast banner on song changes"
                                                  IsChecked="{Binding ShowMediaIslandNotifications}" Margin="0,0,0,12"/>

                                        <CheckBox Content="Show time-aware Dynamic Island greeting on startup"
                                                  IsChecked="{Binding ShowStartupGreeting}" Margin="0,0,0,14"/>

                                        <DockPanel>
                                            <TextBlock Text="Global Toggle Hotkey" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                            <ComboBox SelectedValue="{Binding HotkeyPreset}"
                                                      SelectedValuePath="Tag"
                                                      DockPanel.Dock="Right"
                                                      Width="180"
                                                      HorizontalAlignment="Right">
                                                <ComboBoxItem Content="Alt + Space" Tag="Alt+Space"/>
                                                <ComboBoxItem Content="Win + Z" Tag="Win+Z"/>
                                                <ComboBoxItem Content="Ctrl + Shift + Space" Tag="Ctrl+Shift+Space"/>
                                                <ComboBoxItem Content="Ctrl + ~" Tag="Ctrl+~"/>
                                            </ComboBox>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- PAGE 4: ABOUT & LICENSE -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,6,0">
                                <!-- Hero Identity Card -->
                                <Border Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="14"
                                                Background="#18FFFFFF" BorderBrush="#2CFFFFFF" BorderThickness="1"
                                                Margin="0,0,14,0" VerticalAlignment="Center">
                                            <Image Source="pack://application:,,,/Assets/app.ico"
                                                   Width="44" Height="44"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Win11Notch" Foreground="White" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Border Background="#28FF5E36" BorderBrush="#60FF5E36" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="9,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AppVersionText}" Foreground="#FFFF8A65" FontSize="10.5" FontWeight="Bold"/>
                                                </Border>
                                                <Border Background="#2034D399" BorderBrush="#5034D399" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding LicenseTitle}" Foreground="#FF6EE7B7" FontSize="10.5" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Dynamic Island Overlay &amp; Productivity Hub for Windows 11"
                                                       Foreground="#B0B4BC" FontSize="11.5" Margin="0,4,0,2"/>
                                            <TextBlock Foreground="#78808C" FontSize="10.5">
                                                <Run Text="{Binding RuntimeInfoText, Mode=OneWay}"/>
                                                <Run Text="  •  RAM: "/>
                                                <Run Text="{Binding CurrentMemoryText, Mode=OneWay}" Foreground="#FF8A65"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Author & GitHub Repository Card -->
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource HeaderLabel}" Text="Author &amp; Source Code"/>
                                        <TextBlock Style="{StaticResource SubLabel}" Text="Open-source software created and maintained independently."/>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE77B;" Foreground="#FF5E36" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Author" Foreground="#9A9EA6" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding AuthorName}" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                           Foreground="White" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </DockPanel>

                                            <DockPanel Grid.Row="2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE774;" Foreground="#FF5E36" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="GitHub Repository" Foreground="#9A9EA6" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <Button Command="{Binding OpenGitHubCommand}" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                        Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="{Binding GitHubRepoUrl}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="ghBd" Background="#16FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,5">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock x:Name="ghTxt" Text="{Binding GitHubRepoDisplay}" Foreground="#FF8A65" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A7;" Foreground="#C0FFFFFF" FontSize="10.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ghBd" Property="Background" Value="#28FF5E36"/>
                                                                    <Setter TargetName="ghBd" Property="BorderBrush" Value="#70FF5E36"/>
                                                                    <Setter TargetName="ghTxt" Property="Foreground" Value="White"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DockPanel>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Command="{Binding OpenAppDataFolderCommand}" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,8,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bd" Background="#16FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" FontSize="11" Foreground="#D0FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Open Config &amp; Logs" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="#28FFFFFF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- License & Open-Source Attribution Card -->
                                <Border Style="{StaticResource SettingsCard}" Margin="0">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Style="{StaticResource HeaderLabel}" Text="Licensing &amp; Terms"/>
                                            <TextBlock Text="Copyright © 2026 Prakhar Singh" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                       Foreground="#9096A0" FontSize="11" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource SubLabel}" Text="Distributed under the permissive MIT License."/>

                                        <Border Background="#18000000" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,10,0,8">
                                            <TextBlock Foreground="#B8BCC4" FontSize="10.5" TextWrapping="Wrap" LineHeight="15.5">
                                                Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated documentation files (the "Software"), to deal in the Software without restriction, including without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, subject to the MIT copyright and permission notice. THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND.
                                            </TextBlock>
                                        </Border>

                                        <TextBlock Text="Built with open-source components: WPF-UI 4.3.0 (MIT), CommunityToolkit.Mvvm (MIT), Microsoft.Windows.CsWin32 (MIT)."
                                                   Foreground="#78808C" FontSize="10.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Border>
</Window>
