<Window x:Class="Win11Notch.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Win11Notch Settings"
        Width="480" Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SubLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#85FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="ColorSwatchBtn" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="swatchBd" Background="{TemplateBinding Background}" CornerRadius="12" BorderThickness="1.5" BorderBrush="#50FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="swatchBd" Property="BorderBrush" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark Acrylic ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="BorderBrush" Value="#35FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="#20FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Padding="8,4">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text=" ⌵" DockPanel.Dock="Right" Foreground="#90FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                <ContentPresenter/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#30FFFFFF"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#50FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Margin="10,0,24,0"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#F51A1C20"
                                            BorderBrush="#40FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4"
                                            Margin="0,4,0,4">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#35FF5E36"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark Fluent CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="checkBorder" Width="18" Height="18" CornerRadius="5" Background="#20FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1.5" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="checkMark" Text="✓" Foreground="#FF5E36" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="checkBorder" Property="Background" Value="#30FF5E36"/>
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#FF5E36"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#80FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal Translucent ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="#30FFFFFF"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer frosted window border matching IPS dark-slate acrylic -->
    <Border Background="#E614161A"
            BorderBrush="#30FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Titlebar -->
                <RowDefinition Height="*"/>    <!-- Settings Body -->
            </Grid.RowDefinitions>

            <!-- ── Custom Titlebar ──────────────────────────────────────── -->
            <DockPanel Grid.Row="0" Margin="4,0,4,14" MouseLeftButtonDown="OnTitleBarMouseDown">
                <Button DockPanel.Dock="Right"
                        Content="✕"
                        Click="OnCloseClick"
                        Foreground="#80FFFFFF"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="12"
                        Padding="6,4"
                        Cursor="Hand"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙" Foreground="#4CAF50" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Win11Notch Settings"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <!-- ── Settings Body ────────────────────────────────────────── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">

                    <!-- Card 1: Docking & Target Display -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HeaderLabel}" Text="Screen Dock Edge &amp; Display"/>
                            <TextBlock Style="{StaticResource SubLabel}" Text="Choose which monitor and screen border anchors the notch."/>

                            <!-- Edge Radio Buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                                <RadioButton Content="⬆ Top"
                                             Foreground="White" Margin="0,0,16,0"
                                             Checked="OnDockTopChecked" x:Name="RadioTop"/>
                                <RadioButton Content="⬅ Left" Foreground="White" Margin="0,0,16,0"
                                             Checked="OnDockLeftChecked" x:Name="RadioLeft"/>
                                <RadioButton Content="➡ Right" Foreground="White"
                                             Checked="OnDockRightChecked" x:Name="RadioRight"/>
                            </StackPanel>

                            <!-- Target Display ComboBox -->
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock Text="Target Display:" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding Monitors}"
                                          SelectedValue="{Binding TargetMonitorIndex}"
                                          SelectedValuePath="Index"
                                          DisplayMemberPath="Name"
                                          DockPanel.Dock="Right"
                                          Width="210"
                                          Height="30"
                                          HorizontalAlignment="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Idle Handle Customization (Size, Thickness, Color) -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HeaderLabel}" Text="Idle Handle Customization"/>
                            <TextBlock Style="{StaticResource SubLabel}" Text="Customize the resting pill dimensions and frosted tint color."/>

                            <!-- Handle Width Slider -->
                            <DockPanel Margin="0,10,0,4">
                                <TextBlock Text="Handle Width:" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding HandleWidth, StringFormat='{}{0} px'}" Foreground="#4CAF50" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                <Slider Value="{Binding HandleWidth}" Minimum="40" Maximum="180" Margin="12,0" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Handle Thickness Slider -->
                            <DockPanel Margin="0,8,0,4">
                                <TextBlock Text="Handle Thickness:" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding HandleThickness, StringFormat='{}{0} px'}" Foreground="#2196F3" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                <Slider Value="{Binding HandleThickness}" Minimum="4" Maximum="16" Margin="12,0" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Idle Opacity Slider -->
                            <DockPanel Margin="0,8,0,8">
                                <TextBlock Text="Idle Opacity:" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding IdleOpacityPercent, StringFormat='{}{0}%'}" Foreground="#FFC107" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                <Slider Value="{Binding IdleOpacityPercent}" Minimum="10" Maximum="50" Margin="12,0" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Handle Color Swatches -->
                            <TextBlock Text="Handle Tint Preset:" Foreground="White" FontSize="12" Margin="0,4,0,6"/>
                            <DockPanel LastChildFill="True">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#E61A1C20" ToolTip="Dark Slate Frost (Default)" Command="{Binding SelectHandleColorCommand}" CommandParameter="#E61A1C20"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#99282C35" ToolTip="Pure Glass" Command="{Binding SelectHandleColorCommand}" CommandParameter="#99282C35"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#E6122E22" ToolTip="Emerald Aurora" Command="{Binding SelectHandleColorCommand}" CommandParameter="#E6122E22"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#E6221435" ToolTip="Cyberpunk Neon" Command="{Binding SelectHandleColorCommand}" CommandParameter="#E6221435"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#E6102238" ToolTip="Deep Ocean" Command="{Binding SelectHandleColorCommand}" CommandParameter="#E6102238"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#E635181A" ToolTip="Sunset Ember" Command="{Binding SelectHandleColorCommand}" CommandParameter="#E635181A"/>
                                    <Button Style="{StaticResource ColorSwatchBtn}" Background="#C0E0E5FF" ToolTip="Specular White" Command="{Binding SelectHandleColorCommand}" CommandParameter="#C0E0E5FF"/>
                                </StackPanel>
                                <TextBox Text="{Binding HandleColor, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#20FFFFFF" Foreground="White" CaretBrush="White"
                                         BorderBrush="#30FFFFFF" BorderThickness="1"
                                         Padding="6,3" FontSize="11" Width="85"
                                         HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Visual Effects & Animated Border Presets -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HeaderLabel}" Text="Visual Effects &amp; Border Presets"/>
                            <TextBlock Style="{StaticResource SubLabel}" Text="Animated outline styles and dynamic content sizing."/>

                            <!-- Border Animation Preset Selector -->
                            <DockPanel Margin="0,10,0,8">
                                <TextBlock Text="Border Outline Preset:" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                <ComboBox SelectedValue="{Binding BorderAnimationPreset}"
                                          SelectedValuePath="Tag"
                                          DockPanel.Dock="Right"
                                          Width="190"
                                          Height="30"
                                          HorizontalAlignment="Right">
                                    <ComboBoxItem Content="None (Specular Glass)" Tag="None"/>
                                    <ComboBoxItem Content="Breathing Glow" Tag="BreathingGlow"/>
                                    <ComboBoxItem Content="Rainbow Chroma Wave" Tag="RainbowWave"/>
                                    <ComboBoxItem Content="Cyberpunk Neon Glow" Tag="NeonGlow"/>
                                </ComboBox>
                            </DockPanel>

                            <!-- Dynamic Content Sizing Checkbox -->
                            <CheckBox Content="Dynamically resize notch based on active music &amp; timers"
                                      IsChecked="{Binding DynamicContentSizing}"
                                      Foreground="White" FontSize="12" Margin="0,4,0,8"/>

                            <!-- Acrylic Tint Opacity Slider -->
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock Text="Acrylic Tint Opacity:" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding AcrylicTintPercent, StringFormat='{}{0}%'}" Foreground="#2196F3" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                <Slider Value="{Binding AcrylicTintPercent}" Minimum="50" Maximum="90" Margin="12,0" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Interaction Timers & Triggers -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource HeaderLabel}" Text="Interaction Delays"/>
                            <TextBlock Style="{StaticResource SubLabel}" Text="Control hover sensitivity and exit timing."/>

                            <!-- Hover Dwell Delay -->
                            <DockPanel Margin="0,10,0,4">
                                <TextBlock Text="Hover Dwell Delay:" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding HoverDwellMs, StringFormat='{}{0} ms'}" Foreground="#FFC107" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                <Slider Value="{Binding HoverDwellMs}" Minimum="50" Maximum="500" Margin="12,0" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Exit Grace Delay -->
                            <DockPanel Margin="0,8,0,4">
                                <TextBlock Text="Exit Grace Delay:" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ExitGraceMs, StringFormat='{}{0} ms'}" Foreground="#FFC107" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                <Slider Value="{Binding ExitGraceMs}" Minimum="100" Maximum="1000" Margin="12,0" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Auto-expand on drag -->
                            <CheckBox Content="Expand automatically when dragging files to edge"
                                      IsChecked="{Binding AutoExpandOnDrag}"
                                      Foreground="White" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 5: System Integration -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource HeaderLabel}" Text="Launch on Startup"/>
                                    <TextBlock Style="{StaticResource SubLabel}" Text="Start Win11Notch automatically when you log in."/>
                                </StackPanel>
                                <CheckBox IsChecked="{Binding LaunchAtStartup}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <CheckBox Content="Dynamic Island song change notifications"
                                      IsChecked="{Binding ShowMediaIslandNotifications}"
                                      Foreground="White" FontSize="12" Margin="0,10,0,0"/>

                            <!-- Hotkey Preset Selector -->
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock Text="Global Hotkey Shortcut:" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                <ComboBox SelectedValue="{Binding HotkeyPreset}"
                                          SelectedValuePath="Tag"
                                          DockPanel.Dock="Right"
                                          Width="150"
                                          Height="30"
                                          HorizontalAlignment="Right">
                                    <ComboBoxItem Content="Alt + Space" Tag="Alt+Space"/>
                                    <ComboBoxItem Content="Win + Z" Tag="Win+Z"/>
                                    <ComboBoxItem Content="Ctrl + Shift + Space" Tag="Ctrl+Shift+Space"/>
                                    <ComboBoxItem Content="Ctrl + ~" Tag="Ctrl+~"/>
                                </ComboBox>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 6: About & Memory Diagnostics -->
                    <Border Style="{StaticResource SettingsCard}">
                        <DockPanel LastChildFill="True">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource HeaderLabel}" Text="Diagnostics &amp; Memory"/>
                                <TextBlock Text="{Binding CurrentMemoryText, StringFormat='RAM Usage: {0}'}"
                                           Foreground="#85FFFFFF" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Content="Reset Defaults"
                                    Command="{Binding ResetDefaultsCommand}"
                                    DockPanel.Dock="Right"
                                    Foreground="White" Background="#20FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1"
                                    Padding="10,4" Cursor="Hand" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>