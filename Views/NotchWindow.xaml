<Window x:Class="Win11Notch.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Win11Notch.Services"
        xmlns:controls="clr-namespace:Win11Notch.Views.Controls"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        PreviewMouseLeftButtonDown="OnWindowPreviewMouseLeftButtonDown"
        Width="72" Height="8">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ── Bento Surface & Micro-Pill Styles ──────────────────────────────── -->
        <Style x:Key="BentoCard" TargetType="Border">
            <Setter Property="Background" Value="#D81D2026"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <Style x:Key="MicroPillBadge" TargetType="Border">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#28FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Clean Translucent ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="2.5" Background="#35FFFFFF"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Zero-Blue-Highlight ListBoxItem -->
        <Style x:Key="NoHighlightListBoxItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Icon / Action Button -->
        <Style x:Key="NotchIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#34FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bento Tile Button (Tools Launchers) -->
        <Style x:Key="BentoTileBtn" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hero Coral-Orange Play/Pause Circle Button -->
        <Style x:Key="MediaHeroPlayBtn" TargetType="Button">
            <Setter Property="Background" Value="#FF5E36"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF7350"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E04820"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Transport Circle Button -->
        <Style x:Key="MediaControlCircleBtn" TargetType="Button">
            <Setter Property="Background" Value="#1EFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2CFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#30FFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#45FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Pill Toggle Switch (Replaces legacy CheckBox) -->
        <Style x:Key="PillToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="track" Width="36" Height="20" CornerRadius="10"
                                Background="#28FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1">
                            <Ellipse x:Name="knob" Width="14" Height="14" Fill="White"
                                     HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#FF5E36"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="#FF7350"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Pill Radio Button (Shelf Files / Clipboard Sub-tabs) -->
        <Style x:Key="SegmentedRadioPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9A9CA2"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Frosted Top Dock TabControl & Segmented TabItem -->
        <Style x:Key="BentoTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="#12FFFFFF"
                                    BorderBrush="#1EFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="3"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center">
                                <TabPanel x:Name="HeaderPanel" IsItemsHost="True"/>
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentSegmentedTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E9098"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBd" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="9" Padding="10,5">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBd" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="#E0FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBd" Property="Background" Value="#26FFFFFF"/>
                                <Setter TargetName="tabBd" Property="BorderBrush" Value="#2CFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dynamic Island 4-Bar Equalizer (Coral-Orange Signature Accent) -->
        <Style x:Key="EqualizerBarBase" TargetType="Rectangle">
            <Setter Property="Width" Value="2.5"/>
            <Setter Property="RadiusX" Value="1.25"/>
            <Setter Property="RadiusY" Value="1.25"/>
            <Setter Property="Fill" Value="#FF5E36"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Height" Value="3"/>
        </Style>

        <Style x:Key="EqualizerBar1" TargetType="Rectangle" BasedOn="{StaticResource EqualizerBarBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PlayAnim1">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Height" From="3" To="11" Duration="0:0:0.42">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="PlayAnim1"/></DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EqualizerBar2" TargetType="Rectangle" BasedOn="{StaticResource EqualizerBarBase}">
            <Setter Property="Fill" Value="#FF815E"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PlayAnim2">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Height" From="3" To="14" Duration="0:0:0.58">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="PlayAnim2"/></DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EqualizerBar3" TargetType="Rectangle" BasedOn="{StaticResource EqualizerBarBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PlayAnim3">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Height" From="3" To="9" Duration="0:0:0.36">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="PlayAnim3"/></DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EqualizerBar4" TargetType="Rectangle" BasedOn="{StaticResource EqualizerBarBase}">
            <Setter Property="Fill" Value="#FF9E80"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PlayAnim4">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Height" From="3" To="12" Duration="0:0:0.64">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="PlayAnim4"/></DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Metric Progress Bar (Smooth rounded pill bar) -->
        <Style x:Key="MetricProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#22252C"/>
            <Setter Property="Foreground" Value="#FF5E36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Modern Slider with Round Tactile Knob -->
        <Style x:Key="FluentSliderThumbStyle" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="Glow" Fill="#45FF5E36" Width="20" Height="20" Margin="-3" Visibility="Collapsed"/>
                            <Ellipse x:Name="Knob" Fill="#FFFFFF" Stroke="#40000000" StrokeThickness="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#FFF0ED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentVolumeSlider" TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" Background="#242730"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3" Background="#FF5E36"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource FluentSliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <!-- ── State 1: Idle Handle (Crafted Hairline Glass Pill & Active Mini Dynamic Island) ── -->
        <Border x:Name="IdlePill"
                Background="#E61A1C20"
                BorderBrush="#28FFFFFF"
                BorderThickness="1"
                CornerRadius="4"
                Cursor="Hand"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <ScaleTransform x:Name="IdleScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Grid>
                <!-- Subtle center specular micro-line visible only when resting (no activity) -->
                <Border Height="2" Width="22" CornerRadius="1" Background="#38FFFFFF"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsHorizontalDock}" Value="True"/>
                                        <Condition Binding="{Binding IsMediaPlaying}" Value="False"/>
                                        <Condition Binding="{Binding IsStopwatchRunning}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Horizontal Idle Content (Top Edge) -->
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0"
                      Visibility="{Binding IsHorizontalDock, Converter={StaticResource BoolToVis}}">
                    <!-- Presentation 1: Dual Activity Split Pill -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsDualActivity, Converter={StaticResource BoolToVis}}">
                        <Border Width="16" Height="16" CornerRadius="4" Background="#25FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="0.5" ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Grid>
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEC4F;" FontSize="8" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding MediaThumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding MediaTitle}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" MaxWidth="74" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0" Height="11">
                            <Rectangle Style="{StaticResource EqualizerBar1}" Margin="0.7,0"/>
                            <Rectangle Style="{StaticResource EqualizerBar2}" Margin="0.7,0"/>
                            <Rectangle Style="{StaticResource EqualizerBar3}" Margin="0.7,0"/>
                            <Rectangle Style="{StaticResource EqualizerBar4}" Margin="0.7,0"/>
                        </StackPanel>

                        <Border Width="1" Height="11" Background="#32FFFFFF" Margin="8,0" VerticalAlignment="Center"/>

                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE916;" Foreground="#FF5E36" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StopwatchText}" Foreground="#F5FFFFFF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Presentation 2: Single Music Activity -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsMediaOnlyActivity, Converter={StaticResource BoolToVis}}">
                        <Border Width="16" Height="16" CornerRadius="4" Background="#25FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="0.5" ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Grid>
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEC4F;" FontSize="8" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding MediaThumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding MediaTitle}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" MaxWidth="92" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0" Height="11">
                            <Rectangle Style="{StaticResource EqualizerBar1}" Margin="0.8,0"/>
                            <Rectangle Style="{StaticResource EqualizerBar2}" Margin="0.8,0"/>
                            <Rectangle Style="{StaticResource EqualizerBar3}" Margin="0.8,0"/>
                            <Rectangle Style="{StaticResource EqualizerBar4}" Margin="0.8,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Presentation 3: Single Timer Activity -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsTimerOnlyActivity, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE916;" Foreground="#FF5E36" FontSize="10.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StopwatchText}" Foreground="White" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Vertical Idle Content (Left / Right Edge) -->
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,6"
                            Visibility="{Binding IsVerticalDock, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                Visibility="{Binding IsMediaPlaying, Converter={StaticResource BoolToVis}}">
                        <Border Width="16" Height="16" CornerRadius="4" Background="#25FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="0.5" ClipToBounds="True" Margin="0,0,0,6">
                            <Grid>
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEC4F;" FontSize="8" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding MediaThumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="12" Margin="0,0,0,6">
                            <Rectangle Style="{StaticResource EqualizerBar1}" Margin="0.6,0"/>
                            <Rectangle Style="{StaticResource EqualizerBar2}" Margin="0.6,0"/>
                            <Rectangle Style="{StaticResource EqualizerBar3}" Margin="0.6,0"/>
                            <Rectangle Style="{StaticResource EqualizerBar4}" Margin="0.6,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE916;" Foreground="#FF5E36" FontSize="11" HorizontalAlignment="Center"
                               ToolTip="{Binding StopwatchText}"
                               Visibility="{Binding IsStopwatchRunning, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── State 2: CollapsedHover Capsule (Unified Frosted Bento Pill) ── -->
        <Border x:Name="HoverCapsule"
                Background="#EC1A1C20"
                CornerRadius="21"
                BorderBrush="#32FFFFFF"
                BorderThickness="1"
                Cursor="Hand"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="Collapsed"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Grid>
                <Border x:Name="HoverBorderGlow"
                        CornerRadius="21"
                        BorderThickness="1.5"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"/>

                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0">

                    <!-- 1. Unified Dynamic Island Activity Capsule -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVolumeToastActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPowerToastActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Coral live status dot + crisp clock -->
                        <Ellipse Width="6" Height="6" Fill="#FF5E36" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding ClockText}"
                                   Foreground="White"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- A. Live Music Playing Activity (Art, Title, Fluent Play/Pause, Waveform) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsMediaPlaying, Converter={StaticResource BoolToVis}}">
                                <Border Width="1" Height="14" Background="#28FFFFFF" Margin="9,0" VerticalAlignment="Center"/>

                                <Border Width="20" Height="20"
                                        CornerRadius="6"
                                        Background="#25FFFFFF"
                                        BorderBrush="#38FFFFFF"
                                        BorderThickness="1"
                                        ClipToBounds="True"
                                        VerticalAlignment="Center"
                                        Margin="0,0,7,0">
                                    <Grid>
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEC4F;" FontSize="9.5" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding MediaThumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{Binding MediaTitle}"
                                           Foreground="White"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           MaxWidth="105"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>

                                <!-- In-Place Mini Play/Pause Circle Pill -->
                                <Button Command="{Binding PlayPauseCommand}"
                                        ToolTip="Play / Pause"
                                        Margin="6,0,0,0"
                                        Width="22" Height="22"
                                        Cursor="Hand"
                                        FocusVisualStyle="{x:Null}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#22FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="11">
                                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="9.5" Foreground="#FF5E36" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE769;"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMediaPlaying}" Value="False">
                                                                    <Setter Property="Text" Value="&#xE768;"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#36FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- 4-bar Waveform Equalizer -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0" Height="13">
                                    <Rectangle Style="{StaticResource EqualizerBar1}" Margin="1,0"/>
                                    <Rectangle Style="{StaticResource EqualizerBar2}" Margin="1,0"/>
                                    <Rectangle Style="{StaticResource EqualizerBar3}" Margin="1,0"/>
                                    <Rectangle Style="{StaticResource EqualizerBar4}" Margin="1,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- B. Unified Timer Micro-Pill with In-Place Pause -->
                            <Border Style="{StaticResource MicroPillBadge}"
                                    Visibility="{Binding IsStopwatchRunning, Converter={StaticResource BoolToVis}}"
                                    Margin="8,0,0,0" Padding="6,2">
                                <Button Style="{StaticResource NotchIconBtn}"
                                        Command="{Binding ToggleActiveTimerCommand}"
                                        ToolTip="Pause / Resume Timer"
                                        Padding="1,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE916;" Foreground="#FF5E36" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StopwatchText}" Foreground="White" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE769;" Foreground="#90FFFFFF" FontSize="8.5" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Border>

                            <!-- C. Staged Files Micro-Pill -->
                            <Border Style="{StaticResource MicroPillBadge}"
                                    Visibility="{Binding HasStagedFiles, Converter={StaticResource BoolToVis}}"
                                    Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" Foreground="#FF5E36" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ShelfCountText}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- C2. Stay-Awake Micro-Pill -->
                            <Border Style="{StaticResource MicroPillBadge}"
                                    Visibility="{Binding IsStayAwakeEnabled, Converter={StaticResource BoolToVis}}"
                                    Margin="6,0,0,0" Padding="5,2"
                                    ToolTip="Stay Awake Active (Display won't sleep)">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7E8;" Foreground="#FF5E36" FontSize="10" VerticalAlignment="Center"/>
                            </Border>

                            <!-- C3. Bluetooth Device Battery Micro-Pill -->
                            <Border Style="{StaticResource MicroPillBadge}"
                                    Visibility="{Binding HasBluetoothBattery, Converter={StaticResource BoolToVis}}"
                                    Margin="6,0,0,0" Padding="6,2"
                                    ToolTip="{Binding ActiveAudioDeviceName}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEBA0;" Foreground="#69F0AE" FontSize="9.5" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BluetoothBatteryText}" Foreground="#69F0AE" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- D. Idle Date -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMediaPlaying}" Value="False"/>
                                                    <Condition Binding="{Binding IsStopwatchRunning}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="•" Foreground="#45FFFFFF" Margin="8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DateText}" Foreground="#A8ACB4" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- E. Live Download Speed Micro-Pill -->
                            <Border Style="{StaticResource MicroPillBadge}" Margin="7,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="↓ " Foreground="#FF5E36" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DownloadSpeedText}" Foreground="#E8EAEE" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- 2. Dynamic Island Volume HUD (Coral-Orange Pill Progress) -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="8,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVolumeToastActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#FF5E36" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE767;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter Property="Text" Value="&#xE74F;"/>
                                            <Setter Property="Foreground" Value="#8E9098"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding MasterVolume, StringFormat='{}{0:F0}%'}"
                                   Foreground="White" FontSize="12" FontWeight="Bold"
                                   Width="38" Margin="8,0,6,0" VerticalAlignment="Center"/>

                        <ProgressBar Style="{StaticResource MetricProgressBarStyle}"
                                     Value="{Binding MasterVolume, Mode=OneWay}" Maximum="100"
                                     Width="126" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 3. Dynamic Island Battery & Power Toast Capsule -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="8,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPowerToastActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock FontFamily="Segoe Fluent Icons" Text="{Binding PowerToastIcon}" Foreground="#FF5E36" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding PowerToastTitle}" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text=" • " Foreground="#50FFFFFF" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PowerToastDetail}" Foreground="#B0B4BC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                </Grid>
            </Grid>
        </Border>

        <!-- ── State 3: PeekExpanded Bento Glass Hub (680 × 412 px) ────────── -->
        <Border x:Name="ExpandedHub"
                Background="#F01A1C20"
                CornerRadius="22"
                BorderBrush="#32FFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="Collapsed"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <ScaleTransform x:Name="HubScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Grid>
                <Border x:Name="HubBorderGlow"
                        CornerRadius="22"
                        BorderThickness="1.5"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"/>

                <Grid Margin="14,12,14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ── Top Pill Tab Navigation ────────────────────────── -->
                    <TabControl Grid.Row="0"
                                Style="{StaticResource BentoTabControl}"
                                SelectedIndex="{Binding SelectedTabIndex}">

                        <!-- TAB 1: MEDIA HUB -->
                        <TabItem Style="{StaticResource FluentSegmentedTabItem}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEC4F;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Media" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid Margin="2,4,2,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Bento Album Art Pedestal (Clean, unobstructed 176x176 Artwork + Adaptive Ambient Glow) -->
                                <Grid Grid.Column="0" Width="178" Height="178" Margin="2,0,16,0" VerticalAlignment="Center">
                                    <!-- Ambient Album-Adaptive Glow when playing -->
                                    <Border Width="166" Height="166" CornerRadius="22" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#40000000"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                                        <Setter Property="Background" Value="{Binding MediaAccentGlowBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Effect><BlurEffect Radius="22"/></Border.Effect>
                                    </Border>

                                    <Border CornerRadius="20"
                                            Background="#D822252D"
                                            BorderBrush="#36FFFFFF"
                                            BorderThickness="1"
                                            ClipToBounds="True">
                                        <Grid>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEC4F;"
                                                           FontSize="48" Foreground="#28FFFFFF" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <Image Source="{Binding MediaThumbnail}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <!-- Subtle Top Glass Sheen Overlay -->
                                            <Border IsHitTestVisible="False" CornerRadius="20">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#22FFFFFF" Offset="0"/>
                                                        <GradientStop Color="#00FFFFFF" Offset="0.35"/>
                                                        <GradientStop Color="#26000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Right Bento Playback Panel -->
                                <Border Grid.Column="1" Style="{StaticResource BentoCard}" Padding="16,13">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Audio Output Pill + Player Source Switcher + Live Status Pill -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                            <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                                                    CornerRadius="8" Padding="8,3" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#14FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="#22FFFFFF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                                                <Setter Property="Background" Value="{Binding MediaAccentGlowBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{Binding MediaAccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="5.5" Height="5.5" Margin="0,0,5,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#75FFFFFF"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                                                        <Setter Property="Fill" Value="{Binding MediaAccentBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="PAUSED"/>
                                                                <Setter Property="Foreground" Value="#8E9098"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                                                        <Setter Property="Text" Value="PLAYING"/>
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Border Style="{StaticResource MicroPillBadge}" Padding="8,4" Margin="0,0,6,0">
                                                    <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ToggleAudioDeviceMenuCommand}" Padding="0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7F6;" FontSize="11.5" Foreground="{Binding MediaAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ActiveAudioDeviceName}" FontSize="11" FontWeight="SemiBold" Foreground="White" MaxWidth="125" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0"
                                                                        Visibility="{Binding HasBluetoothBattery, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEBA0;" FontSize="10.5" Foreground="#69F0AE" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding BluetoothBatteryText}" FontSize="10.5" FontWeight="Bold" Foreground="#69F0AE" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70D;" Foreground="#80FFFFFF" FontSize="8.5" Margin="5,1,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Border>

                                                <!-- Multi-Player SMTC Source Switcher Pill -->
                                                <Border Style="{StaticResource MicroPillBadge}" Padding="8,4">
                                                    <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ToggleMediaSourceMenuCommand}" Padding="0" ToolTip="Switch Controlled Media Player">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEC4F;" FontSize="10.5" Foreground="{Binding MediaAccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ActiveMediaSourceName}" FontSize="11" FontWeight="SemiBold" Foreground="#D8FFFFFF" MaxWidth="80" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70D;" Foreground="#80FFFFFF" FontSize="8.5" Margin="4,1,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Multi-Player Source Dropdown Menu -->
                                        <Border Grid.Row="0" Grid.RowSpan="4"
                                                Visibility="{Binding IsMediaSourceMenuOpen, Converter={StaticResource BoolToVis}}"
                                                Background="#F61A1C20" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10"
                                                Padding="5" Panel.ZIndex="22" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                Margin="150,32,0,0" MinWidth="175" MaxHeight="145">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <TextBlock Text="MEDIA PLAYER" Foreground="#65FFFFFF" FontSize="9.5" FontWeight="Bold" Margin="6,2,4,4"/>
                                                    <ItemsControl ItemsSource="{Binding MediaSessions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource NotchIconBtn}"
                                                                        Command="{Binding DataContext.SelectMediaSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Padding="7,4" Margin="0,1">
                                                                    <DockPanel LastChildFill="True">
                                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE73E;" Foreground="#FF5E36" FontSize="11" Margin="6,0,0,0" DockPanel.Dock="Right"
                                                                                   Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                                    </DockPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>

                                        <!-- Audio Device Dropdown Menu -->
                                        <Border Grid.Row="0" Grid.RowSpan="4"
                                                Visibility="{Binding IsAudioDeviceMenuOpen, Converter={StaticResource BoolToVis}}"
                                                Background="#F61A1C20" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10"
                                                Padding="5" Panel.ZIndex="20" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                Margin="0,32,0,0" MinWidth="240" MaxHeight="155">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <TextBlock Text="OUTPUT DEVICE" Foreground="#65FFFFFF" FontSize="9.5" FontWeight="Bold" Margin="6,2,4,4"/>
                                                    <ItemsControl ItemsSource="{Binding AudioDevices}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource NotchIconBtn}"
                                                                        Command="{Binding DataContext.SelectAudioDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Padding="7,4" Margin="0,1">
                                                                    <DockPanel LastChildFill="True">
                                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE73E;" Foreground="#FF5E36" FontSize="11" Margin="6,0,0,0" DockPanel.Dock="Right"
                                                                                   Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"/>
                                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                                    </DockPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>

                                        <!-- Row 1: Track Title & Artist / Idle Subtitle -->
                                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                            <TextBlock Text="{Binding MediaTitle}"
                                                       Foreground="White"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       MaxWidth="380"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Foreground="#989BA4"
                                                       FontSize="13"
                                                       Margin="0,3,0,0"
                                                       MaxWidth="380"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding MediaArtist}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasMedia}" Value="False">
                                                                <Setter Property="Text" Value="Play audio or video in any app to control playback here"/>
                                                                <Setter Property="Foreground" Value="#60FFFFFF"/>
                                                                <Setter Property="FontSize" Value="12"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Row 2: Seek Slider -->
                                        <DockPanel Grid.Row="2" Margin="0,0,0,14">
                                            <TextBlock Text="{Binding MediaPositionText}" Foreground="#8E9098" FontSize="11" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding MediaDurationText}" Foreground="#8E9098" FontSize="11" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            <Slider Style="{StaticResource FluentVolumeSlider}"
                                                    Value="{Binding MediaProgressPercent, Mode=TwoWay}"
                                                    Minimum="0" Maximum="100"
                                                    VerticalAlignment="Center"
                                                    PreviewMouseLeftButtonUp="OnMediaSliderPreviewMouseLeftButtonUp"/>
                                        </DockPanel>

                                        <!-- Row 3: Transport Controls (Left) + Big Live Audio Waveform Visualizer Stage (Right) -->
                                        <DockPanel Grid.Row="3" LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource MediaControlCircleBtn}"
                                                        Command="{Binding PreviousTrackCommand}"
                                                        Margin="0,0,10,0" ToolTip="Previous Track">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE892;" FontSize="12" Foreground="White"/>
                                                </Button>

                                                <Button Style="{StaticResource MediaHeroPlayBtn}"
                                                        Command="{Binding PlayPauseCommand}"
                                                        Margin="0,0,10,0" ToolTip="Play / Pause">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="15">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#xE768;"/>
                                                                <Setter Property="Margin" Value="2,0,0,0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE769;"/>
                                                                        <Setter Property="Margin" Value="0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>

                                                <Button Style="{StaticResource MediaControlCircleBtn}"
                                                        Command="{Binding NextTrackCommand}"
                                                        ToolTip="Next Track">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE893;" FontSize="12" Foreground="White"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- Dedicated Enlarged 16-Bar WASAPI Beat-Synced Audio Waveform Stage -->
                                            <Border Background="#11FFFFFF"
                                                    BorderBrush="#20FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="12,4"
                                                    Height="44"
                                                    Margin="16,0,0,0"
                                                    VerticalAlignment="Center">
                                                <ItemsControl ItemsSource="{Binding WaveBars}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="38"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Rectangle Width="4.5"
                                                                       RadiusX="2.25"
                                                                       RadiusY="2.25"
                                                                       Margin="2.2,0"
                                                                       VerticalAlignment="Center"
                                                                       Height="{Binding Height}"
                                                                       Fill="{Binding DataContext.MediaAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 2: TIMERS & HYDRATION -->
                        <TabItem Style="{StaticResource FluentSegmentedTabItem}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE916;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Timers" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid Margin="2,2,2,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="154"/>
                                    <ColumnDefinition Width="196"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Bento Mode Rail -->
                                <Border Grid.Column="0" Style="{StaticResource BentoCard}" Padding="6" Margin="0,0,8,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <!-- Mode 1: Pomodoro -->
                                        <Button Command="{Binding Timer.SelectModeCommand}" CommandParameter="{x:Static services:TimerMode.Pomodoro}"
                                                Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,0,4">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="10" Padding="9,8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE916;" FontSize="14" Foreground="#FF5E36" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="Pomodoro" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding DataContext.Timer.PomodoroTimeText, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='{}{0} Focus'}"
                                                                           Foreground="#7A7D85" FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.Timer.IsPomodoroMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#20FFFFFF"/>
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="#32FFFFFF"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Mode 2: Countdown -->
                                        <Button Command="{Binding Timer.SelectModeCommand}" CommandParameter="{x:Static services:TimerMode.Countdown}"
                                                Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,0,4">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="10" Padding="9,8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE823;" FontSize="14" Foreground="#00E5FF" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="Countdown" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding DataContext.Timer.CountdownTimeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           Foreground="#7A7D85" FontSize="10" Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.Timer.IsCountdownMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#20FFFFFF"/>
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="#32FFFFFF"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Mode 3: Stopwatch -->
                                        <Button Command="{Binding Timer.SelectModeCommand}" CommandParameter="{x:Static services:TimerMode.Stopwatch}"
                                                Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,0,4">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="10" Padding="9,8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE917;" FontSize="14" Foreground="#FFD600" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="Stopwatch" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding DataContext.Timer.StopwatchTimeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           Foreground="#7A7D85" FontSize="10" Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.Timer.IsStopwatchMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#20FFFFFF"/>
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="#32FFFFFF"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Mode 4: Water -->
                                        <Button Command="{Binding Timer.SelectModeCommand}" CommandParameter="{x:Static services:TimerMode.Water}"
                                                Cursor="Hand" FocusVisualStyle="{x:Null}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="10" Padding="9,8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEB42;" FontSize="14" Foreground="#29B6F6" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="Hydration" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding DataContext.Timer.WaterText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           Foreground="#7A7D85" FontSize="10" Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.Timer.IsWaterMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#20FFFFFF"/>
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="#32FFFFFF"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Column 1: Center Recessed Ring Dial -->
                                <Border Grid.Column="1" Style="{StaticResource BentoCard}" Margin="0,0,8,0">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="174" Height="174">
                                        <controls:ArcProgressRing Width="174" Height="174"
                                                                  Progress="{Binding Timer.DialProgressFraction}"
                                                                  StrokeThickness="8.5"
                                                                  BackgroundBrush="#232730">
                                            <controls:ArcProgressRing.Style>
                                                <Style TargetType="controls:ArcProgressRing">
                                                    <Setter Property="StrokeBrush" Value="#FF5E36"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Timer.IsCountdownMode}" Value="True">
                                                            <Setter Property="StrokeBrush" Value="#00E5FF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Timer.IsStopwatchMode}" Value="True">
                                                            <Setter Property="StrokeBrush" Value="#FFD600"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Timer.IsWaterMode}" Value="True">
                                                            <Setter Property="StrokeBrush" Value="#29B6F6"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:ArcProgressRing.Style>
                                        </controls:ArcProgressRing>

                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Timer.DialTimeText}"
                                                       Foreground="White" FontSize="31" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Timer.DialPhaseLabel}"
                                                       Foreground="#8E9098" FontSize="11.5" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Column 2: Bento Mode Controls -->
                                <Border Grid.Column="2" Style="{StaticResource BentoCard}" Padding="12,10">
                                    <Grid VerticalAlignment="Center">
                                        <!-- POMODORO -->
                                        <Grid Visibility="{Binding Timer.IsPomodoroMode, Converter={StaticResource BoolToVis}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Timer.PomodoroStatusText}" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                                    <Ellipse Width="6.5" Height="6.5" Margin="2.5,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#30FFFFFF"/>
                                                                <Style.Triggers><DataTrigger Binding="{Binding Timer.IsCycle1Active}" Value="True"><Setter Property="Fill" Value="#FF5E36"/></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <Ellipse Width="6.5" Height="6.5" Margin="2.5,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#30FFFFFF"/>
                                                                <Style.Triggers><DataTrigger Binding="{Binding Timer.IsCycle2Active}" Value="True"><Setter Property="Fill" Value="#FF5E36"/></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <Ellipse Width="6.5" Height="6.5" Margin="2.5,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#30FFFFFF"/>
                                                                <Style.Triggers><DataTrigger Binding="{Binding Timer.IsCycle3Active}" Value="True"><Setter Property="Fill" Value="#FF5E36"/></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <Ellipse Width="6.5" Height="6.5" Margin="2.5,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#30FFFFFF"/>
                                                                <Style.Triggers><DataTrigger Binding="{Binding Timer.IsCycle4Active}" Value="True"><Setter Property="Fill" Value="#FF5E36"/></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Timer.PomodoroNextPhaseText}" Foreground="#8E9098" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <Button Style="{StaticResource MediaControlCircleBtn}" Command="{Binding Timer.ResetPomodoroCommand}" ToolTip="Reset Cycle">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="12" Foreground="White"/>
                                                </Button>

                                                <Button Style="{StaticResource MediaHeroPlayBtn}" Command="{Binding Timer.TogglePomodoroCommand}" Margin="12,0" ToolTip="Start / Pause">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="15">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#xE768;"/>
                                                                <Setter Property="Margin" Value="2,0,0,0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Timer.IsPomodoroRunning}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE769;"/>
                                                                        <Setter Property="Margin" Value="0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>

                                                <Button Style="{StaticResource MediaControlCircleBtn}" Command="{Binding Timer.SkipPomodoroCommand}" ToolTip="Skip Phase">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE893;" FontSize="12" Foreground="White"/>
                                                </Button>
                                            </StackPanel>

                                            <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,8">
                                                <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="9" Padding="6,3" Margin="2.5">
                                                    <DockPanel LastChildFill="True">
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.AdjustFocusCommand}" CommandParameter="-5" Content="−" FontSize="12" DockPanel.Dock="Left" Padding="4,0"/>
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.AdjustFocusCommand}" CommandParameter="5" Content="+" FontSize="12" DockPanel.Dock="Right" Padding="4,0"/>
                                                        <TextBlock Text="{Binding Timer.FocusMinutes, StringFormat='{}Focus {0}m'}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Border>

                                                <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="9" Padding="6,3" Margin="2.5">
                                                    <DockPanel LastChildFill="True">
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.AdjustShortBreakCommand}" CommandParameter="-1" Content="−" FontSize="12" DockPanel.Dock="Left" Padding="4,0"/>
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.AdjustShortBreakCommand}" CommandParameter="1" Content="+" FontSize="12" DockPanel.Dock="Right" Padding="4,0"/>
                                                        <TextBlock Text="{Binding Timer.ShortBreakMinutes, StringFormat='{}Break {0}m'}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Border>

                                                <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="9" Padding="6,3" Margin="2.5">
                                                    <DockPanel LastChildFill="True">
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.AdjustLongBreakCommand}" CommandParameter="-5" Content="−" FontSize="12" DockPanel.Dock="Left" Padding="4,0"/>
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.AdjustLongBreakCommand}" CommandParameter="5" Content="+" FontSize="12" DockPanel.Dock="Right" Padding="4,0"/>
                                                        <TextBlock Text="{Binding Timer.LongBreakMinutes, StringFormat='{}Long {0}m'}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Border>

                                                <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="9" Padding="6,3" Margin="2.5">
                                                    <DockPanel LastChildFill="True">
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.AdjustTargetCyclesCommand}" CommandParameter="-1" Content="−" FontSize="12" DockPanel.Dock="Left" Padding="4,0"/>
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.AdjustTargetCyclesCommand}" CommandParameter="1" Content="+" FontSize="12" DockPanel.Dock="Right" Padding="4,0"/>
                                                        <TextBlock Text="{Binding Timer.TargetCycles, StringFormat='{}Cycles {0}'}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Border>
                                            </UniformGrid>

                                            <DockPanel Grid.Row="3" Margin="4,0">
                                                <TextBlock Text="{Binding Timer.CompletedTodayCount, StringFormat='{}{0} done'}" Foreground="#65FFFFFF" FontSize="10.5" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="Auto-next" Foreground="#90FFFFFF" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <CheckBox Style="{StaticResource PillToggleSwitch}" IsChecked="{Binding Timer.AutoStartNext, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Grid>

                                        <!-- COUNTDOWN -->
                                        <Grid Visibility="{Binding Timer.IsCountdownMode, Converter={StaticResource BoolToVis}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <WrapPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                <Button Style="{StaticResource BentoTileBtn}" Command="{Binding Timer.SetCountdownDurationCommand}" CommandParameter="5" Content="5m" FontSize="11" Margin="2" Padding="9,4"/>
                                                <Button Style="{StaticResource BentoTileBtn}" Command="{Binding Timer.SetCountdownDurationCommand}" CommandParameter="10" Content="10m" FontSize="11" Margin="2" Padding="9,4"/>
                                                <Button Style="{StaticResource BentoTileBtn}" Command="{Binding Timer.SetCountdownDurationCommand}" CommandParameter="15" Content="15m" FontSize="11" Margin="2" Padding="9,4"/>
                                                <Button Style="{StaticResource BentoTileBtn}" Command="{Binding Timer.SetCountdownDurationCommand}" CommandParameter="25" Content="25m" FontSize="11" Margin="2" Padding="9,4"/>
                                                <Button Style="{StaticResource BentoTileBtn}" Command="{Binding Timer.SetCountdownDurationCommand}" CommandParameter="30" Content="30m" FontSize="11" Margin="2" Padding="9,4"/>
                                                <Button Style="{StaticResource BentoTileBtn}" Command="{Binding Timer.SetCountdownDurationCommand}" CommandParameter="45" Content="45m" FontSize="11" Margin="2" Padding="9,4"/>
                                                <Button Style="{StaticResource BentoTileBtn}" Command="{Binding Timer.SetCountdownDurationCommand}" CommandParameter="60" Content="60m" FontSize="11" Margin="2" Padding="9,4"/>
                                            </WrapPanel>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,12">
                                                <Button Style="{StaticResource MediaControlCircleBtn}" Command="{Binding Timer.ResetCountdownCommand}" ToolTip="Reset">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="12" Foreground="White"/>
                                                </Button>

                                                <Button Style="{StaticResource MediaHeroPlayBtn}" Command="{Binding Timer.ToggleCountdownCommand}" Margin="12,0" Background="#00E5FF">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Foreground="#101216" FontSize="15">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#xE768;"/>
                                                                <Setter Property="Margin" Value="2,0,0,0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Timer.IsCountdownRunning}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE769;"/>
                                                                        <Setter Property="Margin" Value="0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>

                                                <Button Style="{StaticResource MediaControlCircleBtn}" Command="{Binding Timer.AddOneMinuteToCountdownCommand}" ToolTip="+1 Minute">
                                                    <TextBlock Text="+1m" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                                </Button>
                                            </StackPanel>

                                            <TextBlock Grid.Row="2" Text="Chime plays on completion" Foreground="#70FFFFFF" FontSize="10.5" HorizontalAlignment="Center"/>
                                        </Grid>

                                        <!-- STOPWATCH -->
                                        <Grid Visibility="{Binding Timer.IsStopwatchMode, Converter={StaticResource BoolToVis}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                <Button Style="{StaticResource MediaControlCircleBtn}" Command="{Binding Timer.ResetStopwatchCommand}" ToolTip="Reset">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="12" Foreground="White"/>
                                                </Button>

                                                <Button Style="{StaticResource MediaHeroPlayBtn}" Command="{Binding Timer.ToggleStopwatchCommand}" Margin="12,0" Background="#FFD600">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Foreground="#101216" FontSize="15">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#xE768;"/>
                                                                <Setter Property="Margin" Value="2,0,0,0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Timer.IsStopwatchRunning}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE769;"/>
                                                                        <Setter Property="Margin" Value="0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>

                                                <Button Style="{StaticResource MediaControlCircleBtn}" Command="{Binding Timer.RecordLapCommand}" ToolTip="Record Lap">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7C1;" FontSize="12" Foreground="White"/>
                                                </Button>
                                            </StackPanel>

                                            <Border Grid.Row="1" Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Padding="6,4" Height="112">
                                                <ListBox ItemsSource="{Binding Timer.Laps}" Background="Transparent" BorderThickness="0"
                                                         ItemContainerStyle="{StaticResource NoHighlightListBoxItem}"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" Foreground="#E8FFFFFF" FontSize="11" Margin="4,2"/>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </Grid>

                                        <!-- WATER -->
                                        <Grid Visibility="{Binding Timer.IsWaterMode, Converter={StaticResource BoolToVis}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding Timer.WaterVolumeText}" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                                                <Button Style="{StaticResource BentoTileBtn}" Command="{Binding Timer.RemoveWaterCupCommand}" Content="− 1 Cup" FontSize="11.5" Padding="12,8" Margin="0,0,8,0"/>
                                                <Button Style="{StaticResource BentoTileBtn}" Command="{Binding Timer.AddWaterCupCommand}" Content="+ 1 Cup (250ml)" FontSize="11.5" FontWeight="Bold" Padding="14,8" Background="#2529B6F6" BorderBrush="#5029B6F6"/>
                                            </StackPanel>

                                            <DockPanel Grid.Row="2">
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.ResetWaterCommand}" DockPanel.Dock="Right" Padding="6,3" ToolTip="Reset today">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="10" Foreground="#80FFFFFF" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Reset" Foreground="#80FFFFFF" FontSize="10.5"/>
                                                    </StackPanel>
                                                </Button>
                                                <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="9" Padding="6,3" HorizontalAlignment="Left">
                                                    <DockPanel LastChildFill="True">
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.AdjustWaterTargetCommand}" CommandParameter="-1" Content="−" FontSize="11" DockPanel.Dock="Left" Padding="4,0"/>
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.AdjustWaterTargetCommand}" CommandParameter="1" Content="+" FontSize="11" DockPanel.Dock="Right" Padding="4,0"/>
                                                        <TextBlock Text="{Binding Timer.WaterCupsTarget, StringFormat='{}Goal {0} cups'}" Foreground="#B0FFFFFF" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0"/>
                                                    </DockPanel>
                                                </Border>
                                            </DockPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 3: SHELF (SPLIT DOCK + SMART CLIPBOARD) -->
                        <TabItem Style="{StaticResource FluentSegmentedTabItem}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Shelf" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid Margin="2,2,2,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="244"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT PANEL: DOCK (Drag-in to stage, Drag-out to remove) -->
                                <Border Grid.Column="0" Style="{StaticResource BentoCard}" Padding="10,9">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" FontSize="12" Foreground="#FF5E36" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Dock" Foreground="White" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Border Background="#20FFFFFF" CornerRadius="7" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ShelfItems.Count}" Foreground="#E0FFFFFF" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding CaptureScreenCommand}" Background="#14FFFFFF" Padding="6,3" ToolTip="Capture Screen to Dock">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE722;" FontSize="10.5" Foreground="#FF5E36" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Snip" FontSize="10.5" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding CopyShelfPathsCommand}" Background="#14FFFFFF" Padding="5,3" Margin="4,0,0,0" ToolTip="Copy File Paths">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8C8;" FontSize="10.5" Foreground="#C0FFFFFF"/>
                                                </Button>
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ClearShelfCommand}" Background="#14FFFFFF" Padding="5,3" Margin="4,0,0,0" ToolTip="Clear Dock">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" FontSize="10.5" Foreground="#B0FFFFFF"/>
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <TextBlock Grid.Row="1" Text="Drop files here • Drag out to remove" Foreground="#68FFFFFF" FontSize="10" Margin="0,0,0,6"/>

                                        <!-- Empty Drop Target -->
                                        <Border Grid.Row="2" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="10" Background="#0AFFFFFF" Padding="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShelfItems.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE898;" FontSize="24" Foreground="#45FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                <TextBlock Text="Drop files to stage" Foreground="#88FFFFFF" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Drag a file back out to pop it off the dock" Foreground="#50FFFFFF" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Staged Files List -->
                                        <ListBox Grid.Row="2" ItemsSource="{Binding ShelfItems}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ItemContainerStyle="{StaticResource NoHighlightListBoxItem}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 PreviewMouseMove="OnShelfListPreviewMouseMove"
                                                 PreviewMouseLeftButtonDown="OnShelfListPreviewMouseLeftButtonDown">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#12FFFFFF" BorderBrush="#1EFFFFFF" BorderThickness="1" CornerRadius="9" Padding="7,5" Margin="0,2" Cursor="Hand">
                                                        <DockPanel LastChildFill="True">
                                                            <Button Style="{StaticResource NotchIconBtn}"
                                                                    Command="{Binding DataContext.RemoveShelfItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    DockPanel.Dock="Right" Padding="4,2" ToolTip="Remove">
                                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" FontSize="9.5" Foreground="#70FFFFFF"/>
                                                            </Button>
                                                            <TextBlock Text="{Binding FormattedSize}" DockPanel.Dock="Right"
                                                                       Foreground="#70FFFFFF" FontSize="10" Margin="4,0" VerticalAlignment="Center"/>
                                                            <Border Width="20" Height="20" CornerRadius="5" Background="#18FFFFFF" Margin="0,0,7,0" ClipToBounds="True" VerticalAlignment="Center">
                                                                <Grid>
                                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" FontSize="10" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="11.5" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <!-- RIGHT PANEL: SMART CLIPBOARD (Text, Images & URLs) -->
                                <Border Grid.Column="2" Style="{StaticResource BentoCard}" Padding="10,9">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header: Clipboard Title + Type Filters + Clear -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                            <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ClearClipboardHistoryCommand}"
                                                    Background="#12FFFFFF" Padding="6,3" DockPanel.Dock="Right" ToolTip="Clear unpinned clipboard items">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" FontSize="10.5" Foreground="#9A9CA2"/>
                                            </Button>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE77F;" FontSize="12" Foreground="#FF5E36" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Clipboard" Foreground="White" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                <!-- Filter Pills -->
                                                <Button Command="{Binding SetClipboardFilterCommand}" CommandParameter="0" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,3,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" CornerRadius="7" Padding="7,2.5" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                                                <TextBlock x:Name="txt" Text="All" FontSize="10" FontWeight="SemiBold" Foreground="#9A9CA2"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding ClipboardFilterIndex}" Value="0">
                                                                    <Setter TargetName="bd" Property="Background" Value="#2CFF5E36"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#FF5E36"/>
                                                                    <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Button Command="{Binding SetClipboardFilterCommand}" CommandParameter="1" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,3,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" CornerRadius="7" Padding="7,2.5" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                                                <TextBlock x:Name="txt" Text="Text" FontSize="10" FontWeight="SemiBold" Foreground="#9A9CA2"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding ClipboardFilterIndex}" Value="1">
                                                                    <Setter TargetName="bd" Property="Background" Value="#2CFF5E36"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#FF5E36"/>
                                                                    <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Button Command="{Binding SetClipboardFilterCommand}" CommandParameter="2" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,3,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" CornerRadius="7" Padding="7,2.5" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                                                <TextBlock x:Name="txt" Text="Images" FontSize="10" FontWeight="SemiBold" Foreground="#9A9CA2"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding ClipboardFilterIndex}" Value="2">
                                                                    <Setter TargetName="bd" Property="Background" Value="#2CFF5E36"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#FF5E36"/>
                                                                    <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Button Command="{Binding SetClipboardFilterCommand}" CommandParameter="3" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" CornerRadius="7" Padding="7,2.5" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                                                <TextBlock x:Name="txt" Text="URLs" FontSize="10" FontWeight="SemiBold" Foreground="#9A9CA2"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding ClipboardFilterIndex}" Value="3">
                                                                    <Setter TargetName="bd" Property="Background" Value="#2CFF5E36"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#FF5E36"/>
                                                                    <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Search Box -->
                                        <Border Grid.Row="1" Background="#10FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                                CornerRadius="8" Margin="0,0,0,6" Padding="8,4">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE721;" FontSize="10.5" Foreground="#70FFFFFF" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <Grid>
                                                    <TextBlock Text="Search copied text, links, or domains..." Foreground="#50FFFFFF" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ClipboardSearchText}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBox Text="{Binding ClipboardSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="Transparent" Foreground="White" CaretBrush="#FF5E36"
                                                             BorderThickness="0" FontSize="11.5" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DockPanel>
                                        </Border>

                                        <!-- Empty State -->
                                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FilteredClipboardHistory.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE77F;" FontSize="22" Foreground="#40FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                            <TextBlock Text="Copy text, URLs, or images anywhere" Foreground="#60FFFFFF" FontSize="11.5" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Smart Clipboard List -->
                                        <ListBox Grid.Row="2" ItemsSource="{Binding FilteredClipboardHistory}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ItemContainerStyle="{StaticResource NoHighlightListBoxItem}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#10FFFFFF" BorderBrush="#1EFFFFFF" BorderThickness="1" CornerRadius="9" Margin="0,2" Padding="6,4">
                                                        <DockPanel LastChildFill="True">
                                                            <Button Style="{StaticResource NotchIconBtn}"
                                                                    Command="{Binding DataContext.RemoveClipboardItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    DockPanel.Dock="Right" Padding="4,3" ToolTip="Remove">
                                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" FontSize="9.5" Foreground="#65FFFFFF"/>
                                                            </Button>
                                                            <Button Style="{StaticResource NotchIconBtn}"
                                                                    Command="{Binding DataContext.TogglePinClipboardItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    DockPanel.Dock="Right" Margin="1,0" Padding="4,3" ToolTip="Pin / Unpin">
                                                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="10.5">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="&#xE734;"/>
                                                                            <Setter Property="Foreground" Value="#55FFFFFF"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                                    <Setter Property="Text" Value="&#xE735;"/>
                                                                                    <Setter Property="Foreground" Value="#FF5E36"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Button>
                                                            <Button Style="{StaticResource NotchIconBtn}"
                                                                    Command="{Binding DataContext.OpenClipboardUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding IsUrl, Converter={StaticResource BoolToVis}}"
                                                                    DockPanel.Dock="Right" Margin="1,0" Padding="4,3" ToolTip="Open Link in Browser">
                                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A7;" FontSize="10.5" Foreground="#00E5FF"/>
                                                            </Button>

                                                            <Button Style="{StaticResource NotchIconBtn}"
                                                                    Command="{Binding DataContext.CopyClipboardItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Padding="4,2">
                                                                <DockPanel LastChildFill="True">
                                                                    <TextBlock Text="Copied" Foreground="#69F0AE" FontWeight="Bold" FontSize="10"
                                                                               DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                               Visibility="{Binding IsCopied, Converter={StaticResource BoolToVis}}"/>

                                                                    <!-- Image Thumbnail Preview -->
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                                Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                                                        <Border Width="42" Height="28" CornerRadius="5" Background="#22000000" BorderBrush="#2CFFFFFF" BorderThickness="1" ClipToBounds="True" Margin="0,0,8,0">
                                                                            <Image Source="{Binding ImageThumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                        </Border>
                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <TextBlock Text="Copied Image" Foreground="White" FontSize="11.5" FontWeight="SemiBold"/>
                                                                            <TextBlock Text="{Binding BadgeText}" Foreground="#78FFFFFF" FontSize="9.5"/>
                                                                        </StackPanel>
                                                                    </StackPanel>

                                                                    <!-- URL Preview -->
                                                                    <DockPanel LastChildFill="True" VerticalAlignment="Center"
                                                                               Visibility="{Binding IsUrl, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE71B;" FontSize="11" Foreground="#00E5FF" Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                                                        <Border Background="#1800E5FF" BorderBrush="#3500E5FF" BorderThickness="1" CornerRadius="5" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left">
                                                                            <TextBlock Text="{Binding BadgeText}" Foreground="#00E5FF" FontSize="9.5" FontWeight="SemiBold" MaxWidth="90" TextTrimming="CharacterEllipsis"/>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Preview}" Foreground="#E8FFFFFF" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                    </DockPanel>

                                                                    <!-- Text Preview -->
                                                                    <DockPanel LastChildFill="True" VerticalAlignment="Center"
                                                                               Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" FontSize="10.5" Foreground="#80FFFFFF" Margin="0,0,7,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                                                        <TextBlock Text="{Binding Preview}" Foreground="White" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                    </DockPanel>
                                                                </DockPanel>
                                                            </Button>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 4: SAMSUNG-STYLE CALENDAR & REMINDERS -->
                        <TabItem Style="{StaticResource FluentSegmentedTabItem}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE787;" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Calendar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid Margin="2,2,2,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="328"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Card: Whole-Month Calendar Grid -->
                                <Border Grid.Column="0" Style="{StaticResource BentoCard}" Padding="10,9">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Month Header & Navigation -->
                                        <DockPanel Grid.Row="0" Margin="2,0,2,7">
                                            <TextBlock Text="{Binding Calendar.MonthYearLabel}" Foreground="White" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding CalendarTodayCommand}" Background="#14FFFFFF" Padding="7,2.5" Margin="0,0,4,0">
                                                    <TextBlock Text="Today" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF5E36"/>
                                                </Button>
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding CalendarPreviousMonthCommand}" Background="#12FFFFFF" Padding="6,3" Margin="0,0,3,0" ToolTip="Previous Month">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE76B;" FontSize="9.5" Foreground="White"/>
                                                </Button>
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding CalendarNextMonthCommand}" Background="#12FFFFFF" Padding="6,3" ToolTip="Next Month">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE76C;" FontSize="9.5" Foreground="White"/>
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Weekday Labels -->
                                        <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,4">
                                            <TextBlock Text="SUN" Foreground="#FF7E5A" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="MON" Foreground="#8E9098" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="TUE" Foreground="#8E9098" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="WED" Foreground="#8E9098" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="THU" Foreground="#8E9098" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="FRI" Foreground="#8E9098" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="SAT" Foreground="#8E9098" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </UniformGrid>

                                        <!-- 6x7 Month Days Grid -->
                                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Calendar.MonthDays}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7" Rows="6"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.CalendarSelectDateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="1">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="cellBd" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.2">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="*"/>
                                                                            <RowDefinition Height="7"/>
                                                                        </Grid.RowDefinitions>

                                                                        <Border x:Name="todayCircle" Width="21" Height="21" CornerRadius="10.5" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                                                                            <TextBlock x:Name="dayTxt" Text="{Binding DayNumber}" FontSize="11.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>

                                                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding DotColors}" HorizontalAlignment="Center" VerticalAlignment="Top">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <StackPanel Orientation="Horizontal"/>
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Ellipse Width="4" Height="4" Fill="{Binding}" Margin="1,0"/>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="cellBd" Property="Background" Value="#16FFFFFF"/>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                        <Setter TargetName="dayTxt" Property="Foreground" Value="#48FFFFFF"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter TargetName="cellBd" Property="Background" Value="#20FF5E36"/>
                                                                        <Setter TargetName="cellBd" Property="BorderBrush" Value="#AAFF5E36"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                        <Setter TargetName="todayCircle" Property="Background" Value="#FF5E36"/>
                                                                        <Setter TargetName="dayTxt" Property="Foreground" Value="White"/>
                                                                        <Setter TargetName="dayTxt" Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>

                                <!-- Right Card: Selected Day Schedule & Samsung-Style Reminder Composer -->
                                <Border Grid.Column="2" Style="{StaticResource BentoCard}" Padding="11,9">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                            <Button Command="{Binding ToggleAddCalendarEventCommand}" DockPanel.Dock="Right" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="8" Padding="9,3.5" Background="#FF5E36">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" FontSize="9.5" Foreground="White" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="New" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE787;" FontSize="12" Foreground="#FF5E36" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Calendar.SelectedDateHeader}" Foreground="White" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Inline Event & Reminder Composer -->
                                        <Border Grid.Row="1" Visibility="{Binding IsAddingCalendarEvent, Converter={StaticResource BoolToVis}}"
                                                Background="#14FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Border Background="#18000000" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="7" Padding="7,4" Margin="0,0,0,6">
                                                    <Grid>
                                                        <TextBlock Text="Event or reminder title..." Foreground="#55FFFFFF" FontSize="11.5" VerticalAlignment="Center" IsHitTestVisible="False">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding NewCalendarTitle}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBox Text="{Binding NewCalendarTitle, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="Transparent" Foreground="White" CaretBrush="#FF5E36" BorderThickness="0" FontSize="12"/>
                                                    </Grid>
                                                </Border>

                                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                                        <CheckBox IsChecked="{Binding NewCalendarIsReminder}" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White">
                                                            <TextBlock Text="Reminder" Foreground="#E0FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                                        </CheckBox>
                                                        <CheckBox IsChecked="{Binding NewCalendarIsAllDay}" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White">
                                                            <TextBlock Text="All day" Foreground="#B0FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                                        </CheckBox>
                                                        <Border Background="#18000000" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding NewCalendarIsAllDay}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBox Text="{Binding NewCalendarTime, UpdateSourceTrigger=PropertyChanged}"
                                                                     Width="40" Background="Transparent" Foreground="White" CaretBrush="#FF5E36"
                                                                     BorderThickness="0" FontSize="11" HorizontalContentAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>
                                                </DockPanel>

                                                <DockPanel>
                                                    <Button Command="{Binding SaveNewCalendarItemCommand}" DockPanel.Dock="Right" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border CornerRadius="7" Padding="10,4" Background="#FF5E36">
                                                                    <TextBlock Text="Save" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding SelectCalendarAccentCommand}" CommandParameter="#FF5E36" Padding="3">
                                                            <Ellipse Width="12" Height="12" Fill="#FF5E36"/>
                                                        </Button>
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding SelectCalendarAccentCommand}" CommandParameter="#00E5FF" Padding="3">
                                                            <Ellipse Width="12" Height="12" Fill="#00E5FF"/>
                                                        </Button>
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding SelectCalendarAccentCommand}" CommandParameter="#69F0AE" Padding="3">
                                                            <Ellipse Width="12" Height="12" Fill="#69F0AE"/>
                                                        </Button>
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding SelectCalendarAccentCommand}" CommandParameter="#FFD600" Padding="3">
                                                            <Ellipse Width="12" Height="12" Fill="#FFD600"/>
                                                        </Button>
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Empty Day Agenda State -->
                                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Calendar.SelectedDayItems.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE787;" FontSize="24" Foreground="#38FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="No events or reminders" Foreground="#75FFFFFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Tap + New to schedule on this day" Foreground="#48FFFFFF" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Selected Day Events & Reminders List -->
                                        <ListBox Grid.Row="2" ItemsSource="{Binding Calendar.SelectedDayItems}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ItemContainerStyle="{StaticResource NoHighlightListBoxItem}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#12FFFFFF" BorderBrush="#1EFFFFFF" BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="0,2.5">
                                                        <DockPanel LastChildFill="True">
                                                            <Button Style="{StaticResource NotchIconBtn}"
                                                                    Command="{Binding DataContext.RemoveCalendarItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    DockPanel.Dock="Right" Padding="4,2" ToolTip="Delete">
                                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" FontSize="9.5" Foreground="#68FFFFFF"/>
                                                            </Button>

                                                            <!-- Samsung-style Circular Reminder Checkbox -->
                                                            <Button Command="{Binding DataContext.ToggleCalendarItemCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding IsReminder, Converter={StaticResource BoolToVis}}"
                                                                    DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="chk" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" BorderBrush="{Binding AccentHex}" Background="Transparent">
                                                                            <TextBlock x:Name="tick" FontFamily="Segoe Fluent Icons" Text="&#xE73E;" FontSize="9.5" Foreground="#101216" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                <Setter TargetName="chk" Property="Background" Value="{Binding AccentHex}"/>
                                                                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>

                                                            <!-- Vertical Accent Pill Bar for Calendar Events -->
                                                            <Border Width="3.5" Height="22" CornerRadius="1.75" Background="{Binding AccentHex}" Margin="0,0,8,0" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsReminder}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>

                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#60FFFFFF"/>
                                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                                    <TextBlock Text="{Binding DisplayTime}" Foreground="#8E9098" FontSize="10"/>
                                                                    <TextBlock Text=" • Reminder" Foreground="{Binding AccentHex}" FontSize="10" FontWeight="SemiBold"
                                                                               Visibility="{Binding IsReminder, Converter={StaticResource BoolToVis}}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 5: REDESIGNED SYSTEM TELEMETRY (Compute & GPU Top + Battery/Network/Storage Bottom) -->
                        <TabItem Style="{StaticResource FluentSegmentedTabItem}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D9;" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Resources" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid Margin="0,2,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1.15*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- TOP ROW: Compute (CPU + RAM + Disk) | Graphics Hero (GPU % + VRAM) -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Card A: Compute (CPU & RAM + Disk pill) -->
                                    <Border Grid.Column="0" Style="{StaticResource BentoCard}" Padding="13,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE950;" FontSize="12" Foreground="#FF5E36" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Compute &amp; Memory" Foreground="#9A9CA2" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border Style="{StaticResource MicroPillBadge}" DockPanel.Dock="Right" Padding="7,2">
                                                    <TextBlock Text="{Binding DiskPercent, StringFormat='{}Disk {0}%'}" Foreground="#D8FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                            </DockPanel>

                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- CPU Column -->
                                                <Grid Grid.Column="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                        <TextBlock Text="{Binding CpuPercent, StringFormat='{}{0}%'}" Foreground="White" FontSize="23" FontWeight="Bold"/>
                                                        <TextBlock Text="CPU" Foreground="#8E9098" FontSize="11" FontWeight="SemiBold" Margin="7,0,0,4" VerticalAlignment="Bottom"/>
                                                    </StackPanel>
                                                    <Grid Grid.Row="1" Height="30" VerticalAlignment="Bottom" ClipToBounds="True">
                                                        <Polygon Points="{Binding CpuAreaPoints}" Stretch="Fill">
                                                            <Polygon.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#45FF5E36" Offset="0"/>
                                                                    <GradientStop Color="#00FF5E36" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Polygon.Fill>
                                                        </Polygon>
                                                        <Polyline Points="{Binding CpuGraphPoints}" Stroke="#FF5E36" StrokeThickness="1.7" Stretch="Fill"/>
                                                    </Grid>
                                                </Grid>

                                                <!-- RAM Column -->
                                                <Grid Grid.Column="2">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                            <TextBlock Text="{Binding MemoryPercent, StringFormat='{}{0}%'}" Foreground="White" FontSize="23" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding RamText}" Foreground="#8E9098" FontSize="10" FontWeight="SemiBold" Margin="7,0,0,4" VerticalAlignment="Bottom"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Grid Grid.Row="1" Height="30" VerticalAlignment="Bottom" ClipToBounds="True">
                                                        <Polygon Points="{Binding RamAreaPoints}" Stretch="Fill">
                                                            <Polygon.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#4500E5FF" Offset="0"/>
                                                                    <GradientStop Color="#0000E5FF" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Polygon.Fill>
                                                        </Polygon>
                                                        <Polyline Points="{Binding RamGraphPoints}" Stroke="#00E5FF" StrokeThickness="1.7" Stretch="Fill"/>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Card B: Graphics (GPU Utilization % + VRAM Consumption) -->
                                    <Border Grid.Column="2" Style="{StaticResource BentoCard}" Padding="13,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7F4;" FontSize="12" Foreground="#FF5E36" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Graphics (GPU)" Foreground="#9A9CA2" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border Style="{StaticResource MicroPillBadge}" DockPanel.Dock="Right" Padding="8,2" Background="#1E69F0AE" BorderBrush="#4069F0AE">
                                                    <TextBlock Text="{Binding VramText}" Foreground="#69F0AE" FontSize="10.5" FontWeight="Bold"/>
                                                </Border>
                                            </DockPanel>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GpuPercent, StringFormat='{}{0}%'}" Foreground="White" FontSize="25" FontWeight="Bold"/>
                                                <TextBlock Text="3D / Compute Load" Foreground="#8E9098" FontSize="10.5" Margin="9,0,0,4" VerticalAlignment="Bottom"/>
                                            </StackPanel>

                                            <Grid Grid.Row="2" Height="30" VerticalAlignment="Bottom" ClipToBounds="True">
                                                <Polygon Points="{Binding GpuAreaPoints}" Stretch="Fill">
                                                    <Polygon.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#4569F0AE" Offset="0"/>
                                                            <GradientStop Color="#0069F0AE" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Polygon.Fill>
                                                </Polygon>
                                                <Polyline Points="{Binding GpuGraphPoints}" Stroke="#69F0AE" StrokeThickness="1.7" Stretch="Fill"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- BOTTOM ROW: 3 Bento Cards (Battery | Network | Storage & Volume) -->
                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Card 3: Battery -->
                                    <Border Grid.Column="0" Style="{StaticResource BentoCard}" Padding="12,9">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEBA0;" FontSize="12" Foreground="#FF5E36" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Battery" Foreground="#9A9CA2" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding BatteryHealthText}" Foreground="#75FFFFFF" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </DockPanel>

                                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BatteryPercent, StringFormat='{}{0}%'}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding BatteryStatusText}" Foreground="#9A9CA2" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <ProgressBar Grid.Row="2" Style="{StaticResource MetricProgressBarStyle}"
                                                         Value="{Binding BatteryPercent, Mode=OneWay}" Maximum="100"/>
                                        </Grid>
                                    </Border>

                                    <!-- Card 4: Network -->
                                    <Border Grid.Column="2" Style="{StaticResource BentoCard}" Padding="12,9">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE701;" FontSize="12" Foreground="#FF5E36" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding NetworkName}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                <DockPanel LastChildFill="True" Margin="0,1">
                                                    <Grid Width="48" Height="14" ClipToBounds="True" DockPanel.Dock="Right">
                                                        <Polygon Points="{Binding DownloadAreaPoints}" Stretch="Fill">
                                                            <Polygon.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#45FF5E36" Offset="0"/>
                                                                    <GradientStop Color="#00FF5E36" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Polygon.Fill>
                                                        </Polygon>
                                                        <Polyline Points="{Binding DownloadGraphPoints}" Stroke="#FF5E36" StrokeThickness="1.4" Stretch="Fill"/>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="↓ " Foreground="#FF5E36" FontSize="11" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding DownloadSpeedText}" Foreground="White" FontSize="11.5" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <DockPanel LastChildFill="True" Margin="0,4,0,0">
                                                    <Grid Width="48" Height="14" ClipToBounds="True" DockPanel.Dock="Right">
                                                        <Polygon Points="{Binding UploadAreaPoints}" Stretch="Fill">
                                                            <Polygon.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#40FF8A65" Offset="0"/>
                                                                    <GradientStop Color="#00FF8A65" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Polygon.Fill>
                                                        </Polygon>
                                                        <Polyline Points="{Binding UploadGraphPoints}" Stroke="#FF8A65" StrokeThickness="1.4" Stretch="Fill"/>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="↑ " Foreground="#FF8A65" FontSize="11" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding UploadSpeedText}" Foreground="#D8FFFFFF" FontSize="11.5" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Row="2" Text="{Binding NetworkDetail}" Foreground="#75FFFFFF" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>

                                    <!-- Card 5: Storage & Volume Toggleable -->
                                    <Border Grid.Column="4" Style="{StaticResource BentoCard}" Padding="12,9">
                                        <Grid>
                                            <!-- Storage Mode -->
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsResourceVolumeMode}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <DockPanel Grid.Row="0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEDA2;" FontSize="12" Foreground="#FF5E36" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Storage" Foreground="#9A9CA2" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ToggleResourceCard4ModeCommand}" ToolTip="Switch to Volume Control" Padding="4,2" Margin="0,0,2,0">
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE767;" FontSize="10.5" Foreground="#80FFFFFF"/>
                                                        </Button>
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ToggleDriveMenuCommand}" Padding="4,2">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SelectedDrive.DisplayName}" MaxWidth="62" TextTrimming="CharacterEllipsis" Foreground="#B0B4BC" FontSize="10"/>
                                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70D;" Foreground="#80FFFFFF" FontSize="8" Margin="3,1,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </DockPanel>

                                                <Border Grid.Row="0" Grid.RowSpan="3"
                                                        Visibility="{Binding IsDriveMenuOpen, Converter={StaticResource BoolToVis}}"
                                                        Background="#F61A1C20" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10"
                                                        Padding="5" Panel.ZIndex="10" VerticalAlignment="Top" HorizontalAlignment="Right"
                                                        Margin="0,22,0,0" MinWidth="160">
                                                    <StackPanel>
                                                        <TextBlock Text="SELECT DRIVE" Foreground="#65FFFFFF" FontSize="9" FontWeight="Bold" Margin="5,2,4,3"/>
                                                        <ItemsControl ItemsSource="{Binding Drives}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource NotchIconBtn}"
                                                                            Command="{Binding DataContext.SelectDriveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            HorizontalContentAlignment="Stretch"
                                                                            Padding="5,3" Margin="0,1">
                                                                        <DockPanel LastChildFill="True">
                                                                            <TextBlock Text="{Binding FreeGb, StringFormat='{}{0:F0}G free'}" Foreground="#80FFFFFF" FontSize="9.5" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                                                                        </DockPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>

                                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectedDrive.UsedPercent, Mode=OneWay, StringFormat='{}{0}%'}"
                                                               Foreground="White" FontSize="22" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding SelectedDrive.SummaryText, Mode=OneWay}"
                                                               Foreground="#9A9CA2" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <ProgressBar Grid.Row="2" Style="{StaticResource MetricProgressBarStyle}"
                                                             Value="{Binding SelectedDrive.UsedPercent, Mode=OneWay}" Maximum="100"/>
                                            </Grid>

                                            <!-- Volume Mode -->
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsResourceVolumeMode}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <DockPanel Grid.Row="0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE767;" FontSize="12" Foreground="#FF5E36" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Volume" Foreground="#9A9CA2" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ToggleResourceCard4ModeCommand}" ToolTip="Switch to Storage Monitor" Padding="4,2" Margin="0,0,2,0">
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEDA2;" FontSize="10.5" Foreground="#80FFFFFF"/>
                                                        </Button>
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ToggleAudioDeviceMenuCommand}" Padding="4,2">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ActiveAudioDeviceName}" MaxWidth="62" TextTrimming="CharacterEllipsis" Foreground="#B0B4BC" FontSize="10"/>
                                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70D;" Foreground="#80FFFFFF" FontSize="8" Margin="3,1,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </DockPanel>

                                                <Border Grid.Row="0" Grid.RowSpan="3"
                                                        Visibility="{Binding IsAudioDeviceMenuOpen, Converter={StaticResource BoolToVis}}"
                                                        Background="#F61A1C20" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10"
                                                        Padding="5" Panel.ZIndex="10" VerticalAlignment="Top" HorizontalAlignment="Right"
                                                        Margin="0,22,0,0" MinWidth="165">
                                                    <StackPanel>
                                                        <TextBlock Text="PLAYBACK DEVICE" Foreground="#65FFFFFF" FontSize="9" FontWeight="Bold" Margin="5,2,4,3"/>
                                                        <ItemsControl ItemsSource="{Binding AudioDevices}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource NotchIconBtn}"
                                                                            Command="{Binding DataContext.SelectAudioDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            HorizontalContentAlignment="Stretch"
                                                                            Padding="5,3" Margin="0,1">
                                                                        <DockPanel LastChildFill="True">
                                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE73E;" Foreground="#FF5E36" FontSize="10" Margin="5,0,0,0" DockPanel.Dock="Right"
                                                                                       Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"/>
                                                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                                                        </DockPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Grid.Row="1" Text="{Binding MasterVolume, StringFormat='{}{0:F0}%'}" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>

                                                <DockPanel Grid.Row="2" VerticalAlignment="Bottom">
                                                    <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ToggleMuteCommand}" DockPanel.Dock="Right" Padding="4,0" Margin="6,0,0,0">
                                                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#9A9CA2" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="&#xE767;"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                            <Setter Property="Text" Value="&#xE74F;"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>

                                                    <Slider Style="{StaticResource FluentVolumeSlider}"
                                                            Value="{Binding MasterVolume, Mode=TwoWay}" Minimum="0" Maximum="100" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 5: TOOLS & QUICK SCRATCHPAD -->
                        <TabItem Style="{StaticResource FluentSegmentedTabItem}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEC7A;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tools" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid Margin="2,2,2,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="262"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Bento Deck: 2x2 Launchers + Stay Awake & Snips -->
                                <Border Grid.Column="0" Style="{StaticResource BentoCard}" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <UniformGrid Grid.Row="0" Columns="2" Rows="2" Margin="0,0,0,8">
                                            <Button Style="{StaticResource BentoTileBtn}" Command="{Binding OpenTaskManagerCommand}" Margin="0,0,6,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D9;" FontSize="14" Foreground="#FF5E36" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Task Mgr" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource BentoTileBtn}" Command="{Binding OpenSnippingToolCommand}" Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8C6;" FontSize="14" Foreground="#FF5E36" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Snipping" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource BentoTileBtn}" Command="{Binding OpenNotepadCommand}" Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70F;" FontSize="14" Foreground="#FF5E36" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Notepad" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource BentoTileBtn}" Command="{Binding OpenCalculatorCommand}" Margin="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8EF;" FontSize="14" Foreground="#FF5E36" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Calculator" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Command="{Binding ToggleStayAwakeCommand}" Padding="10,9">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BentoTileBtn}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStayAwakeEnabled}" Value="True">
                                                                <Setter Property="Background" Value="#28FF5E36"/>
                                                                <Setter Property="BorderBrush" Value="#70FF5E36"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7E8;" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#8E9098"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsStayAwakeEnabled}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FF5E36"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Stay Awake: Off"/>
                                                                <Setter Property="Foreground" Value="#D0FFFFFF"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsStayAwakeEnabled}" Value="True">
                                                                        <Setter Property="Text" Value="Stay Awake: On"/>
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>

                                            <Button Grid.Column="2" Style="{StaticResource BentoTileBtn}" Command="{Binding OpenScreenshotsFolderCommand}"
                                                    Padding="12,9" ToolTip="Open Saved Snips Folder">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" FontSize="13" Foreground="#FF5E36" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Snips" Foreground="White" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Right Bento Deck: Persistent Quick Scratchpad -->
                                <Border Grid.Column="2" Style="{StaticResource BentoCard}" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70F;" FontSize="12.5" Foreground="#FF5E36" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Quick Scratchpad" Foreground="White" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Text=" • Auto-saved" Foreground="#60FFFFFF" FontSize="10.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding CopyScratchpadCommand}" Padding="6,3" Margin="0,0,4,0" ToolTip="Copy Scratchpad">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="11.5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#xE8C8;"/>
                                                                <Setter Property="Foreground" Value="#B0FFFFFF"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ScratchpadCopied}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE73E;"/>
                                                                        <Setter Property="Foreground" Value="#69F0AE"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ClearScratchpadCommand}" Padding="6,3" ToolTip="Clear Scratchpad">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" FontSize="11.5" Foreground="#80FFFFFF"/>
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <Border Grid.Row="1" Background="#0EFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10" Padding="4">
                                            <TextBox Text="{Binding ScratchpadText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Background="Transparent"
                                                     Foreground="White"
                                                     CaretBrush="#FF5E36"
                                                     BorderThickness="0"
                                                     Padding="6"
                                                     FontSize="12"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <!-- ── Persistent Bottom Control Bar ──────────────────────── -->
                    <Border Grid.Row="1"
                            Background="#D81D2026"
                            BorderBrush="#24FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,5"
                            Margin="0,8,0,0">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ToggleMuteCommand}" Padding="6,3" ToolTip="Mute / Unmute">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE767;"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                        <Setter Property="Text" Value="&#xE74F;"/>
                                                        <Setter Property="Foreground" Value="#8E9098"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>

                                <Slider Style="{StaticResource FluentVolumeSlider}"
                                        Value="{Binding MasterVolume, Mode=TwoWay}"
                                        Minimum="0" Maximum="100"
                                        Width="112"
                                        VerticalAlignment="Center"
                                        Margin="6,0,10,0"/>

                                <!-- Audio Output Switcher Pill -->
                                <Border Style="{StaticResource MicroPillBadge}" Padding="7,3">
                                    <Button Style="{StaticResource NotchIconBtn}"
                                            Command="{Binding ToggleBottomAudioMenuCommand}"
                                            ToolTip="Switch Audio Output Device"
                                            Padding="1,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7F6;" FontSize="11" Foreground="#FF5E36" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ActiveAudioDeviceName}" FontSize="10.5" FontWeight="SemiBold" Foreground="White" MaxWidth="120" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0"
                                                        Visibility="{Binding HasBluetoothBattery, Converter={StaticResource BoolToVis}}">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEBA0;" FontSize="9.5" Foreground="#69F0AE" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding BluetoothBatteryText}" FontSize="10" FontWeight="Bold" Foreground="#69F0AE" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70D;" Foreground="#80FFFFFF" FontSize="8.5" VerticalAlignment="Center" Margin="6,1,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding CaptureScreenCommand}" ToolTip="Screen Snip to Shelf" Padding="7,4">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE722;" FontSize="13.5" Foreground="#D8FFFFFF"/>
                                </Button>
                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding OpenTaskManagerCommand}" ToolTip="Task Manager" Padding="7,4" Margin="2,0,0,0">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D9;" FontSize="13.5" Foreground="#D8FFFFFF"/>
                                </Button>
                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding OpenSnippingToolCommand}" ToolTip="Snipping Tool" Padding="7,4" Margin="2,0,0,0">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8C6;" FontSize="13.5" Foreground="#D8FFFFFF"/>
                                </Button>
                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding OpenSettingsCommand}" ToolTip="Settings" Padding="7,4" Margin="2,0,0,0">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="13.5" Foreground="#FF5E36"/>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Bottom Bar Audio Output Switcher Flyout -->
                    <Border Visibility="{Binding IsBottomAudioMenuOpen, Converter={StaticResource BoolToVis}}"
                            Background="#F61A1C20" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="12"
                            Padding="6" Panel.ZIndex="200" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                            Margin="10,0,0,46" MinWidth="255" MaxHeight="160">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="SELECT PLAYBACK DEVICE" Foreground="#65FFFFFF" FontSize="9.5" FontWeight="Bold" Margin="6,2,4,4"/>
                                <ItemsControl ItemsSource="{Binding AudioDevices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource NotchIconBtn}"
                                                    Command="{Binding DataContext.SelectAudioDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="7,5" Margin="0,1">
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE73E;" Foreground="#FF5E36" FontSize="11" Margin="8,0,0,0" DockPanel.Dock="Right"
                                                               Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
