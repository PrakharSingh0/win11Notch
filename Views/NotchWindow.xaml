<Window x:Class="Win11Notch.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        Width="72" Height="5">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Fluent dark button style override for tight notch overlay controls -->
        <Style x:Key="NotchIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#35FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <!-- ── State 1: Idle Handle (72 × 5 px Top / 5 × 72 px Edge) ──────── -->
        <Border x:Name="IdlePill"
                Background="#FF1A1C20"
                CornerRadius="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>

        <!-- ── State 2: CollapsedHover Capsule (240 × 34 px) ──────────────── -->
        <Border x:Name="HoverCapsule"
                Background="#B31A1C20"
                CornerRadius="17"
                BorderBrush="#24FFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <!-- Status dot -->
                <Ellipse Width="6" Height="6"
                         Fill="#4CAF50"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"/>
                <!-- Live clock -->
                <TextBlock Text="{Binding ClockText}"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <!-- Date divider -->
                <TextBlock Text="•"
                           Foreground="#60FFFFFF"
                           Margin="8,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DateText}"
                           Foreground="#A0FFFFFF"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <!-- Mini playing indicator if media is active -->
                <TextBlock Text=" 🎵"
                           Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}"
                           Foreground="#4CAF50"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── State 3: PeekExpanded Hub (540 × 240 px) ───────────────────── -->
        <Border x:Name="ExpandedHub"
                Background="#D91A1C20"
                CornerRadius="16"
                BorderBrush="#24FFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="Collapsed">
            <Grid Margin="12,10,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── Tab Navigation ────────────────────────────────────── -->
                <TabControl Grid.Row="0"
                            SelectedIndex="{Binding SelectedTabIndex}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0">

                    <!-- Tab 1: Media -->
                    <TabItem Header="Media" Foreground="White" FontSize="13">
                        <Grid Margin="4,12,4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Album Art Cover -->
                            <Border Grid.Column="0"
                                    Width="100" Height="100"
                                    CornerRadius="12"
                                    Background="#20FFFFFF"
                                    BorderBrush="#30FFFFFF"
                                    BorderThickness="1"
                                    Margin="4,0,16,0"
                                    ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="🎵"
                                               FontSize="36"
                                               Foreground="#40FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Image Source="{Binding MediaThumbnail}"
                                           Stretch="UniformToFill"/>
                                </Grid>
                            </Border>

                            <!-- Track Info & Controls -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MediaTitle}"
                                           Foreground="White"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding MediaArtist}"
                                           Foreground="#A0FFFFFF"
                                           FontSize="13"
                                           Margin="0,4,0,12"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Controls -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource NotchIconBtn}"
                                            Command="{Binding PreviousTrackCommand}"
                                            Content="⏮" FontSize="18" Padding="12,6"/>
                                    <Button Style="{StaticResource NotchIconBtn}"
                                            Command="{Binding PlayPauseCommand}"
                                            FontSize="20" Padding="16,6">
                                        <TextBlock Text="{Binding IsMediaPlaying, Converter={x:Null}}"
                                                   Foreground="White">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="▶"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                                            <Setter Property="Text" Value="⏸"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                    <Button Style="{StaticResource NotchIconBtn}"
                                            Command="{Binding NextTrackCommand}"
                                            Content="⏭" FontSize="18" Padding="12,6"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Tab 2: Shelf -->
                    <TabItem Header="Shelf" Foreground="White" FontSize="13">
                        <Grid Margin="4,8,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Shelf Actions -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="{Binding ShelfItems.Count, StringFormat='Staged Files ({0})'}"
                                           Foreground="#80FFFFFF"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource NotchIconBtn}"
                                            Command="{Binding CopyShelfPathsCommand}"
                                            Content="📋 Copy Paths"
                                            FontSize="11"/>
                                    <Button Style="{StaticResource NotchIconBtn}"
                                            Command="{Binding ClearShelfCommand}"
                                            Content="🗑 Clear"
                                            FontSize="11" Margin="6,0,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- File List / Drag Out Target -->
                            <Border Grid.Row="1"
                                    Background="#15FFFFFF"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4">
                                <Grid>
                                    <!-- Empty state -->
                                    <TextBlock Text="Drag and drop files here to stage them"
                                               Foreground="#50FFFFFF"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShelfItems.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Files list -->
                                    <ListBox ItemsSource="{Binding ShelfItems}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             PreviewMouseMove="OnShelfListPreviewMouseMove"
                                             PreviewMouseLeftButtonDown="OnShelfListPreviewMouseLeftButtonDown">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="2,3" LastChildFill="True">
                                                    <Button Style="{StaticResource NotchIconBtn}"
                                                            Command="{Binding DataContext.RemoveShelfItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            DockPanel.Dock="Right"
                                                            Content="✕" FontSize="10" Foreground="#60FFFFFF"
                                                            Padding="4,2"/>
                                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding FormattedSize}" DockPanel.Dock="Right"
                                                               Foreground="#60FFFFFF" FontSize="11" Margin="6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Tab 3: Resources -->
                    <TabItem Header="Resources" Foreground="White" FontSize="13">
                        <UniformGrid Columns="3" Margin="4,16,4,4">
                            <!-- CPU -->
                            <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Margin="4" Padding="10">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="CPU" Foreground="#80FFFFFF" FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CpuPercent, StringFormat='{}{0}%'}" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4"/>
                                    <ProgressBar Value="{Binding CpuPercent}" Maximum="100" Height="4" Foreground="#4CAF50" Background="#30FFFFFF" BorderThickness="0" Width="100"/>
                                </StackPanel>
                            </Border>

                            <!-- RAM -->
                            <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Margin="4" Padding="10">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Memory" Foreground="#80FFFFFF" FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding MemoryPercent, StringFormat='{}{0}%'}" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4"/>
                                    <ProgressBar Value="{Binding MemoryPercent}" Maximum="100" Height="4" Foreground="#2196F3" Background="#30FFFFFF" BorderThickness="0" Width="100"/>
                                </StackPanel>
                            </Border>

                            <!-- Battery -->
                            <Border Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Margin="4" Padding="10">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Battery" Foreground="#80FFFFFF" FontSize="12" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                                        <TextBlock Text="{Binding BatteryPercent, StringFormat='{}{0}%'}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                                        <TextBlock Text=" ⚡" Foreground="#FFD700" FontSize="18"
                                                   Visibility="{Binding IsCharging, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <ProgressBar Value="{Binding BatteryPercent}" Maximum="100" Height="4" Foreground="#FFC107" Background="#30FFFFFF" BorderThickness="0" Width="100"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </TabItem>

                    <!-- Tab 4: Tools -->
                    <TabItem Header="Tools" Foreground="White" FontSize="13">
                        <UniformGrid Columns="4" Margin="4,16,4,4">
                            <Button Style="{StaticResource NotchIconBtn}" Command="{Binding OpenTaskManagerCommand}" Padding="8,12">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Task Mgr" Foreground="White" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NotchIconBtn}" Command="{Binding OpenSnippingToolCommand}" Padding="8,12">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="✂" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Snipping" Foreground="White" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NotchIconBtn}" Command="{Binding OpenNotepadCommand}" Padding="8,12">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📝" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Notepad" Foreground="White" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NotchIconBtn}" Command="{Binding OpenCalculatorCommand}" Padding="8,12">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🧮" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Calculator" Foreground="White" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </TabItem>
                </TabControl>

                <!-- ── Bottom Quick-Actions Bar ──────────────────────────── -->
                <Border Grid.Row="1"
                        Background="#10FFFFFF"
                        CornerRadius="8"
                        Padding="8,4"
                        Margin="0,4,0,0">
                    <DockPanel LastChildFill="True">
                        <!-- Volume mute button -->
                        <Button Style="{StaticResource NotchIconBtn}"
                                Command="{Binding ToggleMuteCommand}"
                                DockPanel.Dock="Left"
                                Padding="6,2">
                            <TextBlock Text="{Binding IsMuted, Converter={x:Null}}" Foreground="White">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="🔊"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Text" Value="🔇"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <!-- Volume slider -->
                        <Slider Value="{Binding MasterVolume, Mode=TwoWay}"
                                Minimum="0" Maximum="100"
                                DockPanel.Dock="Left"
                                Width="120"
                                VerticalAlignment="Center"
                                Margin="4,0,12,0"/>

                        <!-- Right Quick Tools -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource NotchIconBtn}"
                                    Command="{Binding OpenTaskManagerCommand}"
                                    ToolTip="Task Manager" Content="⚡"/>
                            <Button Style="{StaticResource NotchIconBtn}"
                                    Command="{Binding OpenSnippingToolCommand}"
                                    ToolTip="Snipping Tool" Content="✂"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

            </Grid>
        </Border>

    </Grid>
</Window>
