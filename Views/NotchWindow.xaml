<Window x:Class="Win11Notch.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Win11Notch.Services"
        xmlns:controls="clr-namespace:Win11Notch.Views.Controls"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        Icon="pack://application:,,,/Assets/app.ico"
        PreviewMouseLeftButtonDown="OnWindowPreviewMouseLeftButtonDown"
        Width="72" Height="8">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ── Bento Surface & Micro-Pill Styles ──────────────────────────────── -->
        <Style x:Key="BentoCard" TargetType="Border">
            <Setter Property="Background" Value="#D81D2026"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <Style x:Key="MicroPillBadge" TargetType="Border">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#28FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Thin Minimal Sleek Pill ScrollBar (overrides WPF-UI wide DynamicScrollBar cleanly) -->
        <Style TargetType="ScrollBar">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="4"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Margin" Value="2,2,0,2"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="thumbBd" Width="4" CornerRadius="2" Background="#32FFFFFF"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="thumbBd" Property="Background" Value="#64FFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="thumbBd" Property="Background" Value="#88FF5E36"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="4"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Margin" Value="2,2,2,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" IsTabStop="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="thumbBd" Height="4" CornerRadius="2" Background="#32FFFFFF"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="thumbBd" Property="Background" Value="#64FFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="thumbBd" Property="Background" Value="#88FF5E36"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" IsTabStop="False"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Clean Simple ScrollViewer (bypasses bulky WPF-UI DynamicScrollBar) -->
        <Style TargetType="ScrollViewer">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter Grid.Row="0" Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Row="0" Grid.Column="1"
                                       Orientation="Vertical"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       AutomationProperties.AutomationId="VerticalScrollBar"/>

                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1" Grid.Column="0"
                                       Orientation="Horizontal"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       AutomationProperties.AutomationId="HorizontalScrollBar"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Zero-Blue-Highlight ListBoxItem -->
        <Style x:Key="NoHighlightListBoxItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Icon / Action Button -->
        <Style x:Key="NotchIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#34FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bento Tile Button (Tools Launchers) -->
        <Style x:Key="BentoTileBtn" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hero Accent Play/Pause Circle Button -->
        <Style x:Key="MediaHeroPlayBtn" TargetType="Button">
            <Setter Property="Background" Value="#FF5E36"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="22"/>
                            <Border x:Name="sheen" Background="#00FFFFFF" CornerRadius="22" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="sheen" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="sheen" Property="Background" Value="#24000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Transport Circle Button -->
        <Style x:Key="MediaControlCircleBtn" TargetType="Button">
            <Setter Property="Background" Value="#1EFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2CFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#30FFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#45FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Pill Toggle Switch (Replaces legacy CheckBox) -->
        <Style x:Key="PillToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="track" Width="36" Height="20" CornerRadius="10"
                                Background="#28FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1">
                            <Ellipse x:Name="knob" Width="14" Height="14" Fill="White"
                                     HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#FF5E36"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="#FF7350"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Frosted Top Dock TabControl & Segmented TabItem -->
        <Style x:Key="BentoTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="#12FFFFFF"
                                    BorderBrush="#1EFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="3"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Center">
                                <StackPanel x:Name="HeaderPanel" Orientation="Horizontal" IsItemsHost="True"/>
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentSegmentedTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E9098"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBd" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="9" Padding="7,4.5">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBd" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="#E0FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBd" Property="Background" Value="#26FFFFFF"/>
                                <Setter TargetName="tabBd" Property="BorderBrush" Value="#2CFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clickable Home Bento Surface Button (renders subtle hover lift without nesting buttons) -->
        <Style x:Key="HomeCardSurfaceBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cardHover" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardHover" Property="Background" Value="#12FFFFFF"/>
                                <Setter TargetName="cardHover" Property="BorderBrush" Value="#3EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="cardHover" Property="Background" Value="#1CFFFFFF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding DataContext.IsHomeEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="IsHitTestVisible" Value="False"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Metric Progress Bar (Smooth rounded pill bar) -->
        <Style x:Key="MetricProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#22252C"/>
            <Setter Property="Foreground" Value="#FF5E36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Modern Slider with Round Tactile Knob -->
        <Style x:Key="FluentSliderThumbStyle" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="Glow" Fill="#45FF5E36" Width="20" Height="20" Margin="-3" Visibility="Collapsed"/>
                            <Ellipse x:Name="Knob" Fill="#FFFFFF" Stroke="#40000000" StrokeThickness="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#FFF0ED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentVolumeSlider" TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" Background="#242730"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3" Background="#FF5E36"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource FluentSliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Adaptive Bento Home Widget Templates (DataContext = HomeSlotItem, Window.DataContext = NotchViewModel) ── -->
        <DataTemplate x:Key="HomeDateClockTemplate">
            <Grid>
                <Button Style="{StaticResource HomeCardSurfaceBtn}"
                        Command="{Binding DataContext.NavigateToTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="4"
                        ToolTip="Open Calendar &amp; Reminders"/>
                <Grid Margin="11,9" IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: Greeting Dot + Chevron -->
                    <DockPanel Grid.Row="0">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE76C;" Foreground="#48FFFFFF" FontSize="8.5" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{Binding DataContext.GreetingAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DataContext.GreetingTitle, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#B8BCC4" FontSize="9.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="112" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Body: Compact (1x1) stacked vs Wide (2x1+) hero side-by-side -->
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <!-- Compact 1x1 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsCompactWidth, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding DataContext.HomeDayNumberText, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DataContext.HomeDayOfWeekText, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#FF5E36" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="74"/>
                                <TextBlock Text="{Binding DataContext.HomeMonthYearText, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#E8EAEE" FontSize="9.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="74"/>
                                <TextBlock Text="{Binding DataContext.ClockText, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#989EA8" FontSize="9.5" FontWeight="Bold" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Wide / Large 2x1+ -->
                        <DockPanel VerticalAlignment="Center"
                                   Visibility="{Binding IsWideWidth, Converter={StaticResource BoolToVis}}">
                            <Border DockPanel.Dock="Right" Background="#16FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="8" Padding="9,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DataContext.ClockText, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="14" FontWeight="Bold"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DataContext.HomeDayNumberText, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="34" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DataContext.HomeDayOfWeekText, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#FF5E36" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding DataContext.HomeMonthYearText, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#E8EAEE" FontSize="11.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Grid>

                    <!-- Footer: Today Schedule Count + Overdue Badge -->
                    <DockPanel Grid.Row="2" LastChildFill="False">
                        <TextBlock Text="{Binding DataContext.HomeTodaySummaryText, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#9EA4AE" FontSize="9" FontWeight="SemiBold" DockPanel.Dock="Left" TextTrimming="CharacterEllipsis" MaxWidth="105" VerticalAlignment="Center"/>
                        <Border Background="#2AFF5E36" BorderBrush="#65FF5E36" BorderThickness="1" CornerRadius="5" Padding="4.5,1" DockPanel.Dock="Right"
                                Visibility="{Binding DataContext.Calendar.HasOverdueToday, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Due" Foreground="#FF8A65" FontSize="8" FontWeight="Bold"/>
                        </Border>
                    </DockPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HomeMusicPlayerTemplate">
            <Grid>
                <Button Style="{StaticResource HomeCardSurfaceBtn}"
                        Command="{Binding DataContext.NavigateToTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="1"
                        ToolTip="Open Media Hub"/>
                <Grid Margin="11,9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" IsHitTestVisible="False">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE76C;" Foreground="#48FFFFFF" FontSize="8.5" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEC4F;" Foreground="#FF5E36" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DataContext.ActiveMediaSourceName, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#A8ACB4" FontSize="9.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Art + Metadata -->
                    <DockPanel Grid.Row="1" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border CornerRadius="9" Background="#20FFFFFF" BorderBrush="#32FFFFFF" BorderThickness="1" ClipToBounds="True" DockPanel.Dock="Left" Margin="0,0,8,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Width" Value="42"/>
                                    <Setter Property="Height" Value="42"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompactWidth}" Value="True">
                                            <Setter Property="Width" Value="30"/>
                                            <Setter Property="Height" Value="30"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsTallHeight}" Value="True">
                                            <Setter Property="Width" Value="54"/>
                                            <Setter Property="Height" Value="54"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEC4F;" FontSize="14" Foreground="#38FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding DataContext.MediaThumbnail, RelativeSource={RelativeSource AncestorType=Window}}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding DataContext.MediaTitle, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="11.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding DataContext.MediaArtist, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#989BA4" FontSize="9.5" TextTrimming="CharacterEllipsis" Margin="0,1.5,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Transport Controls + Progress Bar -->
                    <DockPanel Grid.Row="2" LastChildFill="True">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Button Command="{Binding DataContext.PreviousTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}" Width="22" Height="22" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="Previous Track" Margin="0,0,4,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="11" Background="#1CFFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE892;" FontSize="8.5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#32FFFFFF"/></Trigger></ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Command="{Binding DataContext.PlayPauseCommand, RelativeSource={RelativeSource AncestorType=Window}}" Width="24" Height="24" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="Play / Pause" Margin="0,0,4,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="12" Background="#FF5E36">
                                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="9.5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE768;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsMediaPlaying, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="Text" Value="&#xE769;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#FF7350"/></Trigger></ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Command="{Binding DataContext.NextTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}" Width="22" Height="22" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="Next Track">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="11" Background="#1CFFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE893;" FontSize="8.5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#32FFFFFF"/></Trigger></ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <ProgressBar Style="{StaticResource MetricProgressBarStyle}"
                                     Height="4" Foreground="#FF5E36"
                                     Value="{Binding DataContext.MediaProgressPercent, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Maximum="100"
                                     Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                     Visibility="{Binding IsWideWidth, Converter={StaticResource BoolToVis}}"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </DataTemplate>

