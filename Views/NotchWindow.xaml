<Window x:Class="Win11Notch.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        PreviewMouseLeftButtonDown="OnWindowPreviewMouseLeftButtonDown"
        Width="72" Height="8">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Fluent dark button style override for tight notch overlay controls -->
        <Style x:Key="NotchIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#35FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Unclipped Circular Hero Play/Pause Button Style -->
        <Style x:Key="MediaHeroPlayBtn" TargetType="Button">
            <Setter Property="Background" Value="#FF5E36"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="23">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF7550"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E04820"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Media Circular Control Button Style (⏮, ⏭) -->
        <Style x:Key="MediaControlCircleBtn" TargetType="Button">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#28FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#48FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Segmented Pill TabItem Style -->
        <Style x:Key="FluentSegmentedTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="12,5">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBd" Property="Background" Value="#15FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBd" Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS Dynamic Island 4-Bar Equalizer Styles -->
        <Style x:Key="EqualizerBarBase" TargetType="Rectangle">
            <Setter Property="Width" Value="3"/>
            <Setter Property="RadiusX" Value="1.5"/>
            <Setter Property="RadiusY" Value="1.5"/>
            <Setter Property="Fill" Value="#4CAF50"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Height" Value="3"/>
        </Style>

        <Style x:Key="EqualizerBar1" TargetType="Rectangle" BasedOn="{StaticResource EqualizerBarBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PlayAnim1">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Height"
                                                 From="3" To="12" Duration="0:0:0.42">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="PlayAnim1"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EqualizerBar2" TargetType="Rectangle" BasedOn="{StaticResource EqualizerBarBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PlayAnim2">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Height"
                                                 From="3" To="15" Duration="0:0:0.58">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="PlayAnim2"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EqualizerBar3" TargetType="Rectangle" BasedOn="{StaticResource EqualizerBarBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PlayAnim3">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Height"
                                                 From="3" To="9" Duration="0:0:0.36">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="PlayAnim3"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EqualizerBar4" TargetType="Rectangle" BasedOn="{StaticResource EqualizerBarBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PlayAnim4">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Height"
                                                 From="3" To="13" Duration="0:0:0.64">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="PlayAnim4"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Metric Progress Bar (Smooth rounded pill bar) -->
        <Style x:Key="MetricProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#22252C"/>
            <Setter Property="Foreground" Value="#FF5E36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" ClipToBounds="True">
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Modern Slider with Round Tactile Knob -->
        <Style x:Key="FluentSliderThumbStyle" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="Glow" Fill="#40FF5E36" Width="20" Height="20" Margin="-3" Visibility="Collapsed"/>
                            <Ellipse x:Name="Knob" Fill="#FFFFFF" Stroke="#40000000" StrokeThickness="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#FFF0ED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentVolumeSlider" TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Track Background -->
                            <Border Height="6" CornerRadius="3" Background="#22252C"/>
                            <!-- Track Progress & Thumb -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3" Background="#FF5E36"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource FluentSliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <!-- ── State 1: Idle Handle (Transforms to Mini Dynamic Activity Pill when music/timer active) ──────── -->
        <Border x:Name="IdlePill"
                Background="#E61A1C20"
                CornerRadius="4"
                Cursor="Hand"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6,0">
                <!-- Live Music Activity Mini Handle (Active when Media is playing) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsMediaPlaying, Converter={StaticResource BoolToVis}}">
                    <Border Width="15" Height="15" CornerRadius="3" Background="#30FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="0.5" ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Grid>
                            <TextBlock Text="🎵" FontSize="7.5" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding MediaThumbnail}" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding MediaTitle}" Foreground="White" FontSize="10" FontWeight="SemiBold" MaxWidth="85" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0" Height="11">
                        <Rectangle Style="{StaticResource EqualizerBar1}" Margin="0.8,0"/>
                        <Rectangle Style="{StaticResource EqualizerBar2}" Margin="0.8,0"/>
                        <Rectangle Style="{StaticResource EqualizerBar3}" Margin="0.8,0"/>
                        <Rectangle Style="{StaticResource EqualizerBar4}" Margin="0.8,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Live Stopwatch Activity Mini Handle (Active when Stopwatch is running and music is NOT playing) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsStopwatchRunning}" Value="True"/>
                                        <Condition Binding="{Binding IsMediaPlaying}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="⏱ " Foreground="#FFB74D" FontSize="9.5" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StopwatchText}" Foreground="#FFE082" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── State 2: CollapsedHover Capsule ── -->
        <Border x:Name="HoverCapsule"
                Background="#EE1A1C20"
                CornerRadius="21"
                BorderBrush="#38FFFFFF"
                BorderThickness="1"
                Cursor="Hand"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="Collapsed">
            <Grid>
                <!-- Animated Border Glow Layer for Outline Presets -->
                <Border x:Name="HoverBorderGlow"
                        CornerRadius="21"
                        BorderThickness="1.5"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"/>

                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">

                    <!-- 1. Unified Dynamic Island Activity Capsule (Clock + Live Music + Stopwatch + Badges / Date) -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVolumeToastActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPowerToastActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Status dot -->
                        <Ellipse Width="6" Height="6"
                                 Fill="#4CAF50"
                                 VerticalAlignment="Center"
                                 Margin="0,0,7,0"/>

                        <!-- Live clock -->
                        <TextBlock Text="{Binding ClockText}"
                                   Foreground="White"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <!-- Dynamic Activities & Content -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- A. Live Music Playing Activity (Art, Title, Equalizer) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsMediaPlaying, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="•" Foreground="#50FFFFFF" Margin="7,0" VerticalAlignment="Center"/>
                                <Border Width="18" Height="18"
                                        CornerRadius="4"
                                        Background="#30FFFFFF"
                                        BorderBrush="#40FFFFFF"
                                        BorderThickness="1"
                                        ClipToBounds="True"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0">
                                    <Grid>
                                        <TextBlock Text="🎵" FontSize="9" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding MediaThumbnail}" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding MediaTitle}"
                                           Foreground="White"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           MaxWidth="110"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <!-- 4-bar Waveform Equalizer -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0" Height="13">
                                    <Rectangle Style="{StaticResource EqualizerBar1}" Margin="1,0"/>
                                    <Rectangle Style="{StaticResource EqualizerBar2}" Margin="1,0"/>
                                    <Rectangle Style="{StaticResource EqualizerBar3}" Margin="1,0"/>
                                    <Rectangle Style="{StaticResource EqualizerBar4}" Margin="1,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- B. Live Activity Stopwatch Pill -->
                            <Border Visibility="{Binding IsStopwatchRunning, Converter={StaticResource BoolToVis}}"
                                    Background="#25FF9800" BorderBrush="#50FF9800" BorderThickness="1"
                                    CornerRadius="6" Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏱ " Foreground="#FFB74D" FontSize="9.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StopwatchText}" Foreground="#FFE082" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- C. Staged Files Pill -->
                            <Border Visibility="{Binding HasStagedFiles, Converter={StaticResource BoolToVis}}"
                                    Background="#202196F3" BorderBrush="#402196F3" BorderThickness="1"
                                    CornerRadius="6" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ShelfCountText}" Foreground="#90CAF9" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Border>

                            <!-- D. Idle Date (visible only when music is NOT playing and stopwatch is NOT running) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMediaPlaying}" Value="False"/>
                                                    <Condition Binding="{Binding IsStopwatchRunning}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="•" Foreground="#50FFFFFF" Margin="7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DateText}" Foreground="#A0FFFFFF" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- E. Live Network Speed Badge -->
                            <Border Background="#1800E5FF" BorderBrush="#3500E5FF" BorderThickness="1"
                                    CornerRadius="6" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="↓ " Foreground="#00E5FF" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DownloadSpeedText}" Foreground="#E0F7FA" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- 2. Dynamic Island Volume HUD -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="8,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVolumeToastActive}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Volume icon -->
                    <TextBlock FontSize="12" Foreground="White" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="🔊"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                        <Setter Property="Text" Value="🔇"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Percentage -->
                    <TextBlock Text="{Binding MasterVolume, StringFormat='{}{0:F0}%'}"
                               Foreground="White" FontSize="12" FontWeight="Bold"
                               Width="38" Margin="6,0,4,0" VerticalAlignment="Center"/>

                    <!-- Progress bar -->
                    <ProgressBar Value="{Binding MasterVolume}" Maximum="100"
                                 Width="120" Height="4"
                                 Foreground="#2196F3" Background="#30FFFFFF" BorderThickness="0"
                                 VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 4. Dynamic Island Battery & Power Toast Capsule -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="8,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPowerToastActive}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="{Binding PowerToastIcon}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding PowerToastTitle}" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" • " Foreground="#60FFFFFF" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PowerToastDetail}" Foreground="#A0FFFFFF" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

            </Grid>
            </Grid>
        </Border>

        <!-- ── State 3: PeekExpanded Hub (540 × 240 px) ───────────────────── -->
        <Border x:Name="ExpandedHub"
                Background="#F01A1C20"
                CornerRadius="20"
                BorderBrush="#38FFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="Collapsed">
            <Grid>
                <!-- Animated Border Glow Layer for Outline Presets -->
                <Border x:Name="HubBorderGlow"
                        CornerRadius="20"
                        BorderThickness="1.5"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"/>

                <Grid Margin="12,10,12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                <!-- ── Tab Navigation ────────────────────────────────────── -->
                <TabControl Grid.Row="0"
                            SelectedIndex="{Binding SelectedTabIndex}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0">

                    <!-- Tab 1: Media (Modern Redesign with Enlarged Real Cover Art, Bluetooth Battery, Tactile Progress Knob, Hero Controls) -->
                    <TabItem Header="🎵 Media" Style="{StaticResource FluentSegmentedTabItem}">
                        <Grid Margin="6,10,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Enlarged 140x140 Cover Art with Ambient Shadow & Soundwave Badge -->
                            <Grid Grid.Column="0" Width="140" Height="140" Margin="4,0,20,0" VerticalAlignment="Center">
                                <!-- Ambient Drop Shadow / Glow -->
                                <Border Width="134" Height="134" CornerRadius="16" Background="#35000000" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border.Effect>
                                        <BlurEffect Radius="14"/>
                                    </Border.Effect>
                                </Border>

                                <!-- Real Player Cover Art Container -->
                                <Border CornerRadius="16"
                                        Background="#25FFFFFF"
                                        BorderBrush="#38FFFFFF"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="🎵"
                                                   FontSize="44"
                                                   Foreground="#30FFFFFF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <Image Source="{Binding MediaThumbnail}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>

                                        <!-- Floating Dynamic Island Soundwave Badge on Cover Art -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                                Background="#B0000000" CornerRadius="8" Padding="6,4"
                                                Visibility="{Binding IsMediaPlaying, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="12">
                                                <Rectangle Style="{StaticResource EqualizerBar1}" Width="2.5" RadiusX="1.2" RadiusY="1.2" Margin="0.8,0" Fill="#FF5E36"/>
                                                <Rectangle Style="{StaticResource EqualizerBar2}" Width="2.5" RadiusX="1.2" RadiusY="1.2" Margin="0.8,0" Fill="#FF9100"/>
                                                <Rectangle Style="{StaticResource EqualizerBar3}" Width="2.5" RadiusX="1.2" RadiusY="1.2" Margin="0.8,0" Fill="#FFD600"/>
                                                <Rectangle Style="{StaticResource EqualizerBar4}" Width="2.5" RadiusX="1.2" RadiusY="1.2" Margin="0.8,0" Fill="#FF5E36"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Right: Metadata, Bluetooth Device Pill, Knob Progress Slider, Hero Controls -->
                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,4,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Audio Device Pill + Bluetooth Battery -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <Border Background="#1CFFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1"
                                            CornerRadius="8" Padding="8,4" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎧 " FontSize="11" Foreground="#FF5E36" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ActiveAudioDeviceName}" FontSize="11" FontWeight="SemiBold" Foreground="White" MaxWidth="190" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <!-- Bluetooth Battery Indicator -->
                                            <TextBlock Text="{Binding BluetoothBatteryText}" FontSize="11" FontWeight="Bold" Foreground="#69F0AE" Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding HasBluetoothBattery, Converter={StaticResource BoolToVis}}"/>
                                            <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ToggleAudioDeviceMenuCommand}" Margin="4,0,0,0" Padding="2,0">
                                                <TextBlock Text=" ⌵" Foreground="#80FFFFFF" FontSize="10"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DockPanel>

                                <!-- Audio Device Dropdown Menu Popup -->
                                <Border Grid.Row="0" Grid.RowSpan="4"
                                        Visibility="{Binding IsAudioDeviceMenuOpen, Converter={StaticResource BoolToVis}}"
                                        Background="#F51A1C20" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="8"
                                        Padding="4" Panel.ZIndex="10" VerticalAlignment="Top" HorizontalAlignment="Left"
                                        Margin="0,32,0,0" MinWidth="220">
                                    <StackPanel>
                                        <TextBlock Text="Select Playback Device" Foreground="#70FFFFFF" FontSize="10" FontWeight="SemiBold" Margin="4,2,4,4"/>
                                        <ItemsControl ItemsSource="{Binding AudioDevices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource NotchIconBtn}"
                                                            Command="{Binding DataContext.SelectAudioDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalContentAlignment="Stretch"
                                                            Padding="6,3" Margin="0,1">
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock Text="✓" Foreground="#4CAF50" FontWeight="Bold" FontSize="11" Margin="0,0,6,0"
                                                                       Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"/>
                                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Row 1: Track Title & Artist -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding MediaTitle}"
                                               Foreground="White"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               MaxWidth="410"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding MediaArtist}"
                                               Foreground="#A0FFFFFF"
                                               FontSize="13.5"
                                               Margin="0,2,0,0"
                                               MaxWidth="410"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Row 2: Interactive Timeline Seek Slider with Tactile Knob -->
                                <DockPanel Grid.Row="2" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding MediaPositionText}" Foreground="#80FFFFFF" FontSize="11" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding MediaDurationText}" Foreground="#80FFFFFF" FontSize="11" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <Slider Style="{StaticResource FluentVolumeSlider}"
                                            Value="{Binding MediaProgressPercent, Mode=TwoWay}"
                                            Minimum="0" Maximum="100"
                                            VerticalAlignment="Center"
                                            PreviewMouseLeftButtonUp="OnMediaSliderPreviewMouseLeftButtonUp"/>
                                </DockPanel>

                                <!-- Row 3: Modern Hero Playback Controls (Perfect unclipped circles) -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                                    <!-- Previous -->
                                    <Button Style="{StaticResource MediaControlCircleBtn}"
                                            Command="{Binding PreviousTrackCommand}"
                                            Margin="0,0,10,0"
                                            ToolTip="Previous Track">
                                        <TextBlock Text="⏮" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>

                                    <!-- Play / Pause Hero Button -->
                                    <Button Style="{StaticResource MediaHeroPlayBtn}"
                                            Command="{Binding PlayPauseCommand}"
                                            Margin="0,0,10,0"
                                            ToolTip="Play / Pause">
                                        <TextBlock Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="▶"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                                            <Setter Property="Text" Value="⏸"/>
                                                            <Setter Property="Margin" Value="0,0,0,0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>

                                    <!-- Next -->
                                    <Button Style="{StaticResource MediaControlCircleBtn}"
                                            Command="{Binding NextTrackCommand}"
                                            Margin="0,0,14,0"
                                            ToolTip="Next Track">
                                        <TextBlock Text="⏭" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Tab 2: Shelf & Clipboard -->
                    <TabItem Header="📁 Shelf" Style="{StaticResource FluentSegmentedTabItem}">
                        <Grid Margin="4,6,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Sub-header segment: Files vs Clipboard -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <RadioButton Content="📁 Files"
                                                 Foreground="White" FontSize="11"
                                                 Checked="OnShelfSubTabFilesChecked" x:Name="RadioSubTabFiles"
                                                 IsChecked="True"
                                                 Margin="0,0,8,0"/>
                                    <RadioButton Content="📋 Clipboard"
                                                 Foreground="White" FontSize="11"
                                                 Checked="OnShelfSubTabClipboardChecked" x:Name="RadioSubTabClipboard"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource NotchIconBtn}"
                                            Command="{Binding CaptureScreenCommand}"
                                            Content="📸 Snip" FontSize="11" ToolTip="Capture Screen to Shelf"/>
                                    <Button Style="{StaticResource NotchIconBtn}"
                                            Command="{Binding CopyShelfPathsCommand}"
                                            Content="📋 Copy Paths" FontSize="11" Margin="4,0,0,0"/>
                                    <Button Style="{StaticResource NotchIconBtn}"
                                            Command="{Binding ClearShelfCommand}"
                                            Content="🗑 Clear" FontSize="11" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Content Area -->
                            <Border Grid.Row="1"
                                    Background="#15FFFFFF"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4">
                                <Grid>
                                    <!-- VIEW 1: Staged Files -->
                                    <Grid x:Name="PanelStagedFiles">
                                        <!-- Empty state -->
                                        <TextBlock Text="Drag and drop files here or click 📸 Snip"
                                                   Foreground="#50FFFFFF"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShelfItems.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Files list -->
                                        <ListBox ItemsSource="{Binding ShelfItems}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 PreviewMouseMove="OnShelfListPreviewMouseMove"
                                                 PreviewMouseLeftButtonDown="OnShelfListPreviewMouseLeftButtonDown">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#12FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,2">
                                                        <DockPanel LastChildFill="True">
                                                            <Button Style="{StaticResource NotchIconBtn}"
                                                                    Command="{Binding DataContext.RemoveShelfItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    DockPanel.Dock="Right"
                                                                    Content="✕" FontSize="10" Foreground="#60FFFFFF"
                                                                    Padding="4,2"/>
                                                            <TextBlock Text="{Binding FormattedSize}" DockPanel.Dock="Right"
                                                                       Foreground="#60FFFFFF" FontSize="11" Margin="6,0" VerticalAlignment="Center"/>
                                                            <Border Width="18" Height="18" CornerRadius="4" Background="#15FFFFFF" Margin="0,0,8,0" ClipToBounds="True" VerticalAlignment="Center">
                                                                <Grid>
                                                                    <TextBlock Text="📄" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>

                                    <!-- VIEW 2: Clipboard History -->
                                    <Grid x:Name="PanelClipboard" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Search Bar -->
                                        <Border Grid.Row="0"
                                                Background="#15FFFFFF"
                                                BorderBrush="#25FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="2,0,2,6"
                                                Padding="6,3">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock Text="🔍" FontSize="10" Foreground="#80FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding ClipboardSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="Transparent"
                                                         Foreground="White"
                                                         CaretBrush="White"
                                                         BorderThickness="0"
                                                         FontSize="11"
                                                         VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>

                                        <!-- Empty state -->
                                        <TextBlock Grid.Row="1"
                                                   Text="No clipboard snippets found"
                                                   Foreground="#50FFFFFF"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FilteredClipboardHistory.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Clipboard list -->
                                        <ListBox Grid.Row="1"
                                                 ItemsSource="{Binding FilteredClipboardHistory}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#10FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="6" Margin="0,2" Padding="6,4">
                                                        <DockPanel LastChildFill="True">
                                                            <Button Style="{StaticResource NotchIconBtn}"
                                                                    Command="{Binding DataContext.RemoveClipboardItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    DockPanel.Dock="Right"
                                                                    Content="✕" FontSize="10" Foreground="#60FFFFFF" Padding="4,2"
                                                                    ToolTip="Remove snippet"/>
                                                            <Button Style="{StaticResource NotchIconBtn}"
                                                                    Command="{Binding DataContext.TogglePinClipboardItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    DockPanel.Dock="Right"
                                                                    FontSize="11" Margin="2,0" Padding="4,2"
                                                                    ToolTip="Pin / Unpin">
                                                                <TextBlock>
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="☆"/>
                                                                            <Setter Property="Foreground" Value="#50FFFFFF"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                                    <Setter Property="Text" Value="⭐"/>
                                                                                    <Setter Property="Foreground" Value="#FFD700"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Button>
                                                            <Button Style="{StaticResource NotchIconBtn}"
                                                                    Command="{Binding DataContext.CopyClipboardItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Left"
                                                                    Cursor="Hand">
                                                                <DockPanel LastChildFill="True">
                                                                    <TextBlock Text="✓ Copied!" Foreground="#4CAF50" FontWeight="Bold" FontSize="11"
                                                                               DockPanel.Dock="Right" Margin="6,0,0,0"
                                                                               Visibility="{Binding IsCopied, Converter={StaticResource BoolToVis}}"/>
                                                                    <TextBlock Text="{Binding Preview}" Foreground="White" FontSize="12"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </DockPanel>
                                                            </Button>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Tab 3: System Telemetry & Control Dashboard (Reference-Inspired 4-Card 2x2 Layout) -->
                    <TabItem Header="⚡ Resources" Style="{StaticResource FluentSegmentedTabItem}">
                        <Grid Margin="2,4,2,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ── Card 1: Battery (Top-Left) ────────────────────────── -->
                            <Border Grid.Row="0" Grid.Column="0"
                                    Background="#E61C1E23" BorderBrush="#25FFFFFF" BorderThickness="1"
                                    CornerRadius="14" Margin="3" Padding="14,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header: Category + Health Status -->
                                    <DockPanel Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEBA0;" FontSize="13" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Battery" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding BatteryHealthText}" Foreground="#8E8E93" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- Main Value: Big % + Status -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,8">
                                        <TextBlock Text="{Binding BatteryPercent, StringFormat='{}{0}%'}"
                                                   Foreground="White" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding BatteryStatusText}"
                                                   Foreground="#8E8E93" FontSize="12.5" Margin="10,0,0,3" VerticalAlignment="Bottom"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Sleek Rounded Accent Pill Bar -->
                                    <ProgressBar Grid.Row="2" Style="{StaticResource MetricProgressBarStyle}"
                                                 Value="{Binding BatteryPercent, Mode=OneWay}" Maximum="100"/>
                                </Grid>
                            </Border>

                            <!-- ── Card 2: Network (Top-Right) ───────────────────────── -->
                            <Border Grid.Row="0" Grid.Column="1"
                                    Background="#E61C1E23" BorderBrush="#25FFFFFF" BorderThickness="1"
                                    CornerRadius="14" Margin="3" Padding="14,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header: Category -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE701;" FontSize="13" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Network" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Main Value: Adapter Name + Link Speed -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,2,0,6">
                                        <TextBlock Text="{Binding NetworkName}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding NetworkDetail}" Foreground="#8E8E93" FontSize="11.5" Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <!-- Dual Download & Upload Sparklines -->
                                    <DockPanel Grid.Row="2" VerticalAlignment="Bottom">
                                        <!-- Download -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                            <TextBlock Text="↓ " Foreground="#FF5E36" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DownloadSpeedText}" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Grid Width="56" Height="16" Margin="6,0,0,0" ClipToBounds="True">
                                                <Polyline Points="{Binding DownloadGraphPoints}" Stroke="#FF5E36" StrokeThickness="1.5" Stretch="Fill"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Divider -->
                                        <Border Width="1" Height="14" Background="#20FFFFFF" Margin="10,0" DockPanel.Dock="Left" VerticalAlignment="Center"/>

                                        <!-- Upload -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="↑ " Foreground="#FF5E36" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding UploadSpeedText}" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Grid Width="56" Height="16" Margin="6,0,0,0" ClipToBounds="True">
                                                <Polyline Points="{Binding UploadGraphPoints}" Stroke="#FF5E36" StrokeThickness="1.5" Stretch="Fill"/>
                                            </Grid>
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Border>

                            <!-- ── Card 3: Performance (Bottom-Left) ─────────────────── -->
                            <Border Grid.Row="1" Grid.Column="0"
                                    Background="#E61C1E23" BorderBrush="#25FFFFFF" BorderThickness="1"
                                    CornerRadius="14" Margin="3" Padding="14,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header: Category -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="13" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Performance" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- 3 Metric Columns: CPU, RAM, Disk -->
                                    <Grid Grid.Row="1" VerticalAlignment="Bottom">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- CPU -->
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding CpuPercent, StringFormat='{}{0}%'}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                            <TextBlock Text="CPU" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,1,0,3"/>
                                            <Grid Height="20" ClipToBounds="True">
                                                <Polyline Points="{Binding CpuGraphPoints}" Stroke="#FF5E36" StrokeThickness="1.5" Stretch="Fill"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- RAM (with area fill gradient) -->
                                        <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                            <TextBlock Text="{Binding MemoryPercent, StringFormat='{}{0}%'}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                            <TextBlock Text="RAM" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,1,0,3"/>
                                            <Grid Height="20" ClipToBounds="True">
                                                <Polygon Points="{Binding RamAreaPoints}" Stretch="Fill">
                                                    <Polygon.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#45FF5E36" Offset="0"/>
                                                            <GradientStop Color="#00FF5E36" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Polygon.Fill>
                                                </Polygon>
                                                <Polyline Points="{Binding RamGraphPoints}" Stroke="#FF5E36" StrokeThickness="1.5" Stretch="Fill"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Disk -->
                                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding DiskPercent, StringFormat='{}{0}%'}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                            <TextBlock Text="Disk" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="0,1,0,3"/>
                                            <Grid Height="20" ClipToBounds="True">
                                                <Polyline Points="{Binding DiskGraphPoints}" Stroke="#FF5E36" StrokeThickness="1.5" Stretch="Fill"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- ── Card 4: Storage & Volume Toggleable (Bottom-Right) ────────────────── -->
                            <Border Grid.Row="1" Grid.Column="1"
                                    Background="#E61C1E23" BorderBrush="#25FFFFFF" BorderThickness="1"
                                    CornerRadius="14" Margin="3" Padding="14,12">
                                <Grid>
                                    <!-- ================= VIEW A: STORAGE MODE (DEFAULT) ================= -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsResourceVolumeMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header: Category + Toggle + Drive Dropdown Button -->
                                        <DockPanel Grid.Row="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEDA2;" FontSize="13" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Storage" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <!-- Mode Switcher Pill Button -->
                                                <Button Style="{StaticResource NotchIconBtn}"
                                                        Command="{Binding ToggleResourceCard4ModeCommand}"
                                                        ToolTip="Switch to Volume Control"
                                                        Padding="4,2" Margin="0,0,6,0">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE767;" FontSize="11" Foreground="#70FFFFFF"/>
                                                </Button>

                                                <!-- Drive Dropdown Pill -->
                                                <Button Style="{StaticResource NotchIconBtn}"
                                                        Command="{Binding ToggleDriveMenuCommand}"
                                                        Padding="4,2">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedDrive.DisplayName}" MaxWidth="100" TextTrimming="CharacterEllipsis" Foreground="#8E8E93" FontSize="11"/>
                                                        <TextBlock Text=" ⌵" Foreground="#8E8E93" FontSize="10.5" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Overlaid Drive Dropdown Menu -->
                                        <Border Grid.Row="0" Grid.RowSpan="3"
                                                Visibility="{Binding IsDriveMenuOpen, Converter={StaticResource BoolToVis}}"
                                                Background="#F51A1C20" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="8"
                                                Padding="4" Panel.ZIndex="10" VerticalAlignment="Top" HorizontalAlignment="Right"
                                                Margin="0,22,0,0" MinWidth="160">
                                            <StackPanel>
                                                <TextBlock Text="Select Drive" Foreground="#70FFFFFF" FontSize="9.5" FontWeight="SemiBold" Margin="6,2,4,4"/>
                                                <ItemsControl ItemsSource="{Binding Drives}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource NotchIconBtn}"
                                                                    Command="{Binding DataContext.SelectDriveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Padding="6,3" Margin="0,1">
                                                                <DockPanel LastChildFill="True">
                                                                    <TextBlock Text="{Binding FreeGb, StringFormat='{}{0:F0}GB free'}" Foreground="#80FFFFFF" FontSize="10" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                                                </DockPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Main Value: Big Used % + Free Space -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,8">
                                            <TextBlock Text="{Binding SelectedDrive.UsedPercent, Mode=OneWay, StringFormat='{}{0}%'}"
                                                       Foreground="White" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedDrive.SummaryText, Mode=OneWay}"
                                                       Foreground="#8E8E93" FontSize="12.5" Margin="10,0,0,3" VerticalAlignment="Bottom"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Sleek Rounded Storage Usage Bar -->
                                        <ProgressBar Grid.Row="2" Style="{StaticResource MetricProgressBarStyle}"
                                                     Value="{Binding SelectedDrive.UsedPercent, Mode=OneWay}" Maximum="100"/>
                                    </Grid>

                                    <!-- ================= VIEW B: VOLUME MODE (MATCHES REFERENCE IMAGE) ================= -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsResourceVolumeMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header: Category + Toggle + Device Dropdown Button -->
                                        <DockPanel Grid.Row="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE767;" FontSize="13" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Volume" Foreground="#8E8E93" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <!-- Mode Switcher Pill Button -->
                                                <Button Style="{StaticResource NotchIconBtn}"
                                                        Command="{Binding ToggleResourceCard4ModeCommand}"
                                                        ToolTip="Switch to Storage Monitor"
                                                        Padding="4,2" Margin="0,0,6,0">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEDA2;" FontSize="11" Foreground="#70FFFFFF"/>
                                                </Button>

                                                <!-- Device Dropdown Pill -->
                                                <Button Style="{StaticResource NotchIconBtn}"
                                                        Command="{Binding ToggleAudioDeviceMenuCommand}"
                                                        Padding="4,2">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ActiveAudioDeviceName}" MaxWidth="100" TextTrimming="CharacterEllipsis" Foreground="#8E8E93" FontSize="11"/>
                                                        <TextBlock Text=" ⌵" Foreground="#8E8E93" FontSize="10.5" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Overlaid Audio Device Dropdown Menu -->
                                        <Border Grid.Row="0" Grid.RowSpan="3"
                                                Visibility="{Binding IsAudioDeviceMenuOpen, Converter={StaticResource BoolToVis}}"
                                                Background="#F51A1C20" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="8"
                                                Padding="4" Panel.ZIndex="10" VerticalAlignment="Top" HorizontalAlignment="Right"
                                                Margin="0,22,0,0" MinWidth="170">
                                            <StackPanel>
                                                <TextBlock Text="Select Playback Device" Foreground="#70FFFFFF" FontSize="9.5" FontWeight="SemiBold" Margin="6,2,4,4"/>
                                                <ItemsControl ItemsSource="{Binding AudioDevices}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource NotchIconBtn}"
                                                                    Command="{Binding DataContext.SelectAudioDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Padding="6,4" Margin="0,1">
                                                                <DockPanel LastChildFill="True">
                                                                    <TextBlock Text="✓" Foreground="#4CAF50" FontWeight="Bold" Margin="4,0,0,0" DockPanel.Dock="Right"
                                                                               Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"/>
                                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                                </DockPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Main Value: Big % -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,6">
                                            <TextBlock Text="{Binding MasterVolume, StringFormat='{}{0:F0}%'}"
                                                       Foreground="White" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Horizontal Slider with Knob & Mute Button -->
                                        <DockPanel Grid.Row="2" VerticalAlignment="Bottom">
                                            <Button Style="{StaticResource NotchIconBtn}"
                                                    Command="{Binding ToggleMuteCommand}"
                                                    DockPanel.Dock="Right" Padding="4,0" Margin="6,0,0,0">
                                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#8E8E93" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE767;"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE74F;"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>

                                            <!-- Volume slider with round tactile knob -->
                                            <Slider Style="{StaticResource FluentVolumeSlider}"
                                                    Value="{Binding MasterVolume, Mode=TwoWay}"
                                                    Minimum="0" Maximum="100"
                                                    VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Grid>

                                </Grid>
                            </Border>

                        </Grid>
                    </TabItem>

                    <!-- Tab 4: Tools -->
                    <TabItem Header="🛠 Tools" Style="{StaticResource FluentSegmentedTabItem}">
                        <Grid Margin="4,10,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Stopwatch Card -->
                            <Border Grid.Row="0"
                                    Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                    CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                                <DockPanel LastChildFill="True">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource NotchIconBtn}"
                                                Command="{Binding ToggleStopwatchCommand}"
                                                FontSize="13" Padding="10,4">
                                            <TextBlock Foreground="White">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="▶ Start"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStopwatchRunning}" Value="True">
                                                                <Setter Property="Text" Value="⏸ Pause"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <Button Style="{StaticResource NotchIconBtn}"
                                                Command="{Binding ResetStopwatchCommand}"
                                                Content="↺ Reset"
                                                FontSize="13" Padding="8,4" Margin="6,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Sprint Timer" Foreground="#80FFFFFF" FontSize="11"/>
                                        <TextBlock Text="{Binding StopwatchText}" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Quick Launchers -->
                            <UniformGrid Grid.Row="1" Columns="4" Margin="0,2,0,0">
                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding OpenTaskManagerCommand}" Padding="6,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Task Mgr" Foreground="White" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding OpenSnippingToolCommand}" Padding="6,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="✂" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Snipping" Foreground="White" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding OpenNotepadCommand}" Padding="6,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="📝" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Notepad" Foreground="White" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding OpenCalculatorCommand}" Padding="6,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🧮" FontSize="20" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Calculator" Foreground="White" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <!-- ── Bottom Quick-Actions Bar ──────────────────────────── -->
                <Border Grid.Row="1"
                        Background="#14FFFFFF"
                        BorderBrush="#20FFFFFF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,6"
                        Margin="0,10,0,0">
                    <DockPanel LastChildFill="True">
                        <!-- Global Volume Controls -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <!-- Volume mute button -->
                            <Button Style="{StaticResource NotchIconBtn}"
                                    Command="{Binding ToggleMuteCommand}"
                                    Padding="6,2">
                                <TextBlock Foreground="White" FontSize="15">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="🔊"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                    <Setter Property="Text" Value="🔇"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <!-- Volume slider with modern round tactile knob -->
                            <Slider Style="{StaticResource FluentVolumeSlider}"
                                    Value="{Binding MasterVolume, Mode=TwoWay}"
                                    Minimum="0" Maximum="100"
                                    Width="130"
                                    VerticalAlignment="Center"
                                    Margin="6,0,12,0"/>
                        </StackPanel>

                        <!-- Right Quick Tools -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource NotchIconBtn}"
                                    Command="{Binding CaptureScreenCommand}"
                                    ToolTip="Screen Snip to Shelf" Content="📸"/>
                            <Button Style="{StaticResource NotchIconBtn}"
                                    Command="{Binding OpenTaskManagerCommand}"
                                    ToolTip="Task Manager" Content="⚡"/>
                            <Button Style="{StaticResource NotchIconBtn}"
                                    Command="{Binding OpenSnippingToolCommand}"
                                    ToolTip="Snipping Tool" Content="✂"/>
                            <Button Style="{StaticResource NotchIconBtn}"
                                    Command="{Binding OpenSettingsCommand}"
                                    ToolTip="Settings" Content="⚙"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

            </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
