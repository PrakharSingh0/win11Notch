                        </DockPanel>
                        <ProgressBar Style="{StaticResource MetricProgressBarStyle}" Height="4.5" Foreground="#FFD54F"
                                     Value="{Binding DataContext.DisplayBrightness, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Maximum="100"/>
                    </StackPanel>

                    <DockPanel Grid.Row="2" LastChildFill="True">
                        <Button Command="{Binding DataContext.NavigateToTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="7"
                                DockPanel.Dock="Right" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="4,0,0,0" ToolTip="Open Quick Share">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="shBd" Background="#22FF5E36" BorderBrush="#55FF5E36" BorderThickness="1" CornerRadius="6" Padding="5,2.5">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72D;" FontSize="8.5" Foreground="#FF8A65"/>
                                    </Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="shBd" Property="Background" Value="#3EFF5E36"/></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock Text="{Binding DataContext.HomeScratchpadPreviewText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Foreground="#989EA8" FontSize="9" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HomeQuickActionsTemplate">
            <Grid>
                <Button Style="{StaticResource HomeCardSurfaceBtn}"
                        Command="{Binding DataContext.NavigateToTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="6"
                        ToolTip="Open Tools"/>
                <Grid Margin="11,9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6" IsHitTestVisible="False">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE76C;" Foreground="#48FFFFFF" FontSize="8.5" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" Foreground="#B388FF" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Quick Actions" Foreground="#E8EAEE" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <UniformGrid Grid.Row="1" Columns="2" Rows="2" VerticalAlignment="Center">
                        <Button Command="{Binding DataContext.ToggleStayAwakeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="0,0,4,4" Padding="6,4" ToolTip="Toggle Stay Awake">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NotchIconBtn}">
                                    <Setter Property="Background" Value="#14FFFFFF"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsStayAwakeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="#2CFF5E36"/>
                                            <Setter Property="BorderBrush" Value="#70FF5E36"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7E8;" Foreground="#FF5E36" FontSize="10" Margin="0,0,4,0"/>
                                <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="White">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Awake"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsStayAwakeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Text" Value="Awake On"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding DataContext.CaptureScreenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="#14FFFFFF" Margin="0,0,0,4" Padding="6,4" ToolTip="Screen Snip to Shelf">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE722;" Foreground="#40C4FF" FontSize="10" Margin="0,0,4,0"/>
                                <TextBlock Text="Snip" Foreground="White" FontSize="9.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding DataContext.PickScreenColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="#14FFFFFF" Margin="0,0,4,0" Padding="6,4" ToolTip="Pick Screen Color">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEF3C;" Foreground="#00E5FF" FontSize="10" Margin="0,0,4,0"/>
                                <TextBlock Text="Color" Foreground="White" FontSize="9.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="#14FFFFFF" Padding="6,4" ToolTip="Open Settings">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" Foreground="#B388FF" FontSize="10" Margin="0,0,4,0"/>
                                <TextBlock Text="Prefs" Foreground="White" FontSize="9.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Grid>
        </DataTemplate>

        <controls:HomeWidgetTemplateSelector x:Key="HomeWidgetSelector"
                                             DateClockTemplate="{StaticResource HomeDateClockTemplate}"
                                             MusicPlayerTemplate="{StaticResource HomeMusicPlayerTemplate}"
                                             UpcomingAgendaTemplate="{StaticResource HomeUpcomingAgendaTemplate}"
                                             PowerAndAudioTemplate="{StaticResource HomePowerAndAudioTemplate}"
                                             SystemResourcesTemplate="{StaticResource HomeSystemResourcesTemplate}"
                                             TimersAndWaterTemplate="{StaticResource HomeTimersAndWaterTemplate}"
                                             ShelfAndClipboardTemplate="{StaticResource HomeShelfAndClipboardTemplate}"
                                             ToolsAndBrightnessTemplate="{StaticResource HomeToolsAndBrightnessTemplate}"
                                             QuickActionsTemplate="{StaticResource HomeQuickActionsTemplate}"/>
    </Window.Resources>

    <Grid>

        <!-- ── State 1: Idle Handle (Crafted Hairline Glass Pill & Active Mini Dynamic Island) ── -->
        <Border x:Name="IdlePill"
                Background="#E61A1C20"
                BorderBrush="#28FFFFFF"
                BorderThickness="1"
                CornerRadius="4"
                Cursor="Hand"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <ScaleTransform x:Name="IdleScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Grid>
                <!-- Subtle center specular micro-line / app-mode pulse visible when minimal pill is active -->
                <Border CornerRadius="1.5"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="22"/>
                            <Setter Property="Height" Value="2"/>
                            <Setter Property="Background" Value="#38FFFFFF"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsHorizontalDock}" Value="True"/>
                                        <Condition Binding="{Binding IsMinimalRestingPill}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding HasCompactAppPulse}" Value="True">
                                    <Setter Property="Width" Value="28"/>
                                    <Setter Property="Height" Value="3"/>
                                    <Setter Property="Background" Value="{Binding MediaAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Vertical minimal resting bar / app-mode pulse (Left / Right Edge) -->
                <Border CornerRadius="1.5"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="2"/>
                            <Setter Property="Height" Value="22"/>
                            <Setter Property="Background" Value="#38FFFFFF"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsVerticalDock}" Value="True"/>
                                        <Condition Binding="{Binding IsMinimalRestingPill}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding HasCompactAppPulse}" Value="True">
                                    <Setter Property="Width" Value="3"/>
                                    <Setter Property="Height" Value="28"/>
                                    <Setter Property="Background" Value="{Binding MediaAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Horizontal Idle Content (Top Edge) -->
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0"
                      Visibility="{Binding IsHorizontalDock, Converter={StaticResource BoolToVis}}">
                    <!-- Presentation 1: Dual Activity Split Pill -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsDualActivity, Converter={StaticResource BoolToVis}}">
                        <Border Width="16" Height="16" CornerRadius="4" Background="#25FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="0.5" ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Grid>
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEC4F;" FontSize="8" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding MediaThumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding IdleMediaDisplayText}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" MaxWidth="74" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <ItemsControl ItemsSource="{Binding CompactWaveBars}" Margin="5,0,0,0" Height="11" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Width="2.5" RadiusX="1.25" RadiusY="1.25" Height="{Binding Height}"
                                               Fill="{Binding DataContext.MediaAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                               VerticalAlignment="Bottom" Margin="0.7,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Width="1" Height="11" Background="#32FFFFFF" Margin="8,0" VerticalAlignment="Center"/>

                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE916;" Foreground="#FF5E36" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StopwatchText}" Foreground="#F5FFFFFF" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Presentation 2: Single Music Activity -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsMediaOnlyActivity, Converter={StaticResource BoolToVis}}">
                        <Border Width="16" Height="16" CornerRadius="4" Background="#25FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="0.5" ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Grid>
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEC4F;" FontSize="8" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding MediaThumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding IdleMediaDisplayText}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" MaxWidth="94" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <ItemsControl ItemsSource="{Binding CompactWaveBars}" Margin="6,0,0,0" Height="11" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Width="2.5" RadiusX="1.25" RadiusY="1.25" Height="{Binding Height}"
                                               Fill="{Binding DataContext.MediaAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                               VerticalAlignment="Bottom" Margin="0.8,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Presentation 3: Single Timer Activity -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsTimerOnlyActivity, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE916;" Foreground="#FF5E36" FontSize="10.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StopwatchText}" Foreground="White" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Presentation 4: Desktop Ambient Glance Pill (when resting on Desktop) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsAmbientDesktopActivity, Converter={StaticResource BoolToVis}}">
                        <Ellipse Width="6" Height="6" Fill="{Binding GreetingAccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ClockText}" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="•" Foreground="#45FFFFFF" FontSize="10.5" Margin="6,0" VerticalAlignment="Center"/>

                        <!-- Show upcoming reminder when scheduled, otherwise compact Battery status -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding HasUpcomingReminder, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEA8F;" Foreground="#FFD54F" FontSize="9.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UpcomingReminderText}" Foreground="#E0FFFFFF" FontSize="10" FontWeight="SemiBold" MaxWidth="62" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUpcomingReminder}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEBA0;" FontSize="9.5" Foreground="#69F0AE" Margin="0,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding BatteryPercent, StringFormat='{}{0}%'}" Foreground="#D8FFFFFF" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Vertical Idle Content (Left / Right Edge) -->
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,6"
                            Visibility="{Binding IsVerticalDock, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                Visibility="{Binding ShowFullLiveActivity, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center"
                                    Visibility="{Binding IsMediaPlaying, Converter={StaticResource BoolToVis}}">
                            <Border Width="16" Height="16" CornerRadius="4" Background="#25FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="0.5" ClipToBounds="True" Margin="0,0,0,6">
                                <Grid>
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEC4F;" FontSize="8" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding MediaThumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding CompactWaveBars}" HorizontalAlignment="Center" Height="12" Margin="0,0,0,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="2.5" RadiusX="1.25" RadiusY="1.25" Height="{Binding Height}"
                                                   Fill="{Binding DataContext.MediaAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   VerticalAlignment="Bottom" Margin="0.6,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE916;" Foreground="#FF5E36" FontSize="11" HorizontalAlignment="Center"
                                   ToolTip="{Binding StopwatchText}"
                                   Visibility="{Binding IsStopwatchRunning, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <!-- Vertical Desktop Ambient Glance (Left / Right Edge) -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsAmbientDesktopActivity, Converter={StaticResource BoolToVis}}">
                        <Ellipse Width="6" Height="6" Fill="{Binding GreetingAccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                        <TextBlock Text="{Binding ClockText}" Foreground="White" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEBA0;" Foreground="#69F0AE" FontSize="9" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding BatteryPercent, StringFormat='{}{0}%'}" Foreground="#D0FFFFFF" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── State 2: CollapsedHover Capsule (Unified Frosted Bento Pill) ── -->
        <Border x:Name="HoverCapsule"
                Background="#EC1A1C20"
                CornerRadius="21"
                BorderBrush="#32FFFFFF"
                BorderThickness="1"
                Cursor="Hand"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="Collapsed"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <ScaleTransform x:Name="HoverScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Grid>
                <Border x:Name="HoverBorderGlow"
                        CornerRadius="21"
                        BorderThickness="1.5"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"/>

                <!-- Persistent Active Reminder Coral Accent Rim -->
                <Border CornerRadius="21"
                        BorderBrush="{Binding ActiveReminderAccentBrush}"
                        BorderThickness="1.4"
                        Opacity="0.72"
                        IsHitTestVisible="False"
                        Visibility="{Binding IsReminderAlertActive, Converter={StaticResource BoolToVis}}"/>

                <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="10,0">

                    <!-- 1. Unified Dynamic Island Activity Capsule -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVolumeToastActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPowerToastActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBrightnessToastActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsReminderAlertActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Coral live status dot + crisp clock -->
                        <Ellipse Width="6" Height="6" Fill="#FF5E36" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding ClockText}"
                                   Foreground="White"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- A. Live Music Playing Activity (Art, Title, Fluent Play/Pause, Waveform) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsMediaPlaying, Converter={StaticResource BoolToVis}}">
                                <Border Width="1" Height="14" Background="#28FFFFFF" Margin="9,0" VerticalAlignment="Center"/>

                                <Border Width="20" Height="20"
                                        CornerRadius="6"
                                        Background="#25FFFFFF"
                                        BorderBrush="#38FFFFFF"
                                        BorderThickness="1"
                                        ClipToBounds="True"
                                        VerticalAlignment="Center"
                                        Margin="0,0,7,0">
                                    <Grid>
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEC4F;" FontSize="9.5" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding MediaThumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{Binding MediaTitle}"
                                           Foreground="White"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           MaxWidth="105"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>

                                <!-- In-Place Mini Play/Pause Circle Pill -->
                                <Button Command="{Binding PlayPauseCommand}"
                                        ToolTip="Play / Pause"
                                        Margin="6,0,0,0"
                                        Width="22" Height="22"
                                        Cursor="Hand"
                                        FocusVisualStyle="{x:Null}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#22FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="11">
                                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="9.5" Foreground="#FF5E36" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE769;"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMediaPlaying}" Value="False">
                                                                    <Setter Property="Text" Value="&#xE768;"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#36FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- 4-bar Reactive Waveform (WASAPI-driven real-time audio peaks) -->
                                <ItemsControl ItemsSource="{Binding CompactWaveBars}" VerticalAlignment="Center" Margin="6,0,0,0" Height="13">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Rectangle Width="2.5" RadiusX="1.25" RadiusY="1.25" Height="{Binding Height}" Fill="#FF5E36" VerticalAlignment="Bottom" Margin="1,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- B. Unified Timer Micro-Pill with In-Place Pause -->
                            <Border Style="{StaticResource MicroPillBadge}"
                                    Visibility="{Binding IsStopwatchRunning, Converter={StaticResource BoolToVis}}"
                                    Margin="8,0,0,0" Padding="6,2">
                                <Button Style="{StaticResource NotchIconBtn}"
                                        Command="{Binding ToggleActiveTimerCommand}"
                                        ToolTip="Pause / Resume Timer"
                                        Padding="1,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE916;" Foreground="#FF5E36" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StopwatchText}" Foreground="White" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE769;" Foreground="#90FFFFFF" FontSize="8.5" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Border>

                            <!-- C. Staged Files Micro-Pill -->
                            <Border Style="{StaticResource MicroPillBadge}"
                                    Visibility="{Binding HasStagedFiles, Converter={StaticResource BoolToVis}}"
                                    Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" Foreground="#FF5E36" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ShelfCountText}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- C2. Stay-Awake Micro-Pill -->
                            <Border Style="{StaticResource MicroPillBadge}"
                                    Visibility="{Binding IsStayAwakeEnabled, Converter={StaticResource BoolToVis}}"
                                    Margin="6,0,0,0" Padding="5,2"
                                    ToolTip="Stay Awake Active (Display won't sleep)">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7E8;" Foreground="#FF5E36" FontSize="10" VerticalAlignment="Center"/>
                            </Border>

                            <!-- C3. Bluetooth Device Battery Micro-Pill -->
                            <Border Style="{StaticResource MicroPillBadge}"
                                    Visibility="{Binding HasBluetoothBattery, Converter={StaticResource BoolToVis}}"
                                    Margin="6,0,0,0" Padding="6,2"
                                    ToolTip="{Binding ActiveAudioDeviceName}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEBA0;" Foreground="#69F0AE" FontSize="9.5" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BluetoothBatteryText}" Foreground="#69F0AE" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- D. Idle Date & Optional Upcoming Reminder Pill -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMediaPlaying}" Value="False"/>
                                                    <Condition Binding="{Binding IsStopwatchRunning}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="•" Foreground="#45FFFFFF" Margin="8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DateText}" Foreground="#A8ACB4" FontSize="11.5" VerticalAlignment="Center"/>

                                <Border Style="{StaticResource MicroPillBadge}" Margin="7,0,0,0" Padding="6,2"
                                        Visibility="{Binding HasUpcomingReminder, Converter={StaticResource BoolToVis}}"
                                        ToolTip="{Binding UpcomingReminderText}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEA8F;" Foreground="#FFD54F" FontSize="9.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding UpcomingReminderText}" Foreground="#F0FFFFFF" FontSize="10" FontWeight="SemiBold" MaxWidth="92" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- E. Live Download Speed Micro-Pill -->
                            <Border Style="{StaticResource MicroPillBadge}" Margin="7,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="↓ " Foreground="#FF5E36" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DownloadSpeedText}" Foreground="#E8EAEE" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- 2. Dynamic Island Volume HUD (Coral-Orange Pill Progress) -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="8,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVolumeToastActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#FF5E36" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE767;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter Property="Text" Value="&#xE74F;"/>
                                            <Setter Property="Foreground" Value="#8E9098"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding MasterVolume, StringFormat='{}{0:F0}%'}"
                                   Foreground="White" FontSize="12" FontWeight="Bold"
                                   Width="38" Margin="8,0,6,0" VerticalAlignment="Center"/>

                        <ProgressBar Style="{StaticResource MetricProgressBarStyle}"
                                     Value="{Binding MasterVolume, Mode=OneWay}" Maximum="100"
                                     Width="126" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 3. Dynamic Island Battery & Power Toast Capsule -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="8,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPowerToastActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock FontFamily="Segoe Fluent Icons" Text="{Binding PowerToastIcon}" Foreground="{Binding PowerToastIconBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding PowerToastTitle}" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text=" • " Foreground="#50FFFFFF" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PowerToastDetail}" Foreground="#B0B4BC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 4. Dynamic Island Display Brightness HUD -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="8,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBrightnessToastActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE706;" Foreground="#FFD54F" FontSize="13.5" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisplayBrightness, StringFormat='{}{0}%'}"
                                   Foreground="White" FontSize="12" FontWeight="Bold"
                                   Width="38" Margin="8,0,6,0" VerticalAlignment="Center"/>
                        <ProgressBar Style="{StaticResource MetricProgressBarStyle}"
                                     Foreground="#FFD54F"
                                     Value="{Binding DisplayBrightness, Mode=OneWay}" Maximum="100"
                                     Width="126" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 5. Persistent Due Reminder Pill (stays visible until Done, Snooze, or Dismiss) -->
                    <DockPanel VerticalAlignment="Center" LastChildFill="True">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsReminderAlertActive}" Value="True"/>
                                            <Condition Binding="{Binding IsVolumeToastActive}" Value="False"/>
                                            <Condition Binding="{Binding IsPowerToastActive}" Value="False"/>
                                            <Condition Binding="{Binding IsBrightnessToastActive}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>

                        <!-- Right: Interactive non-focus-stealing Done / Snooze / Dismiss controls -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Button Command="{Binding CompleteActiveReminderCommand}"
                                    ToolTip="Mark Reminder Done"
                                    Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,4,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="doneBd" Background="#2869F0AE" BorderBrush="#7269F0AE" BorderThickness="1" CornerRadius="10" Padding="8,3.5">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE73E;" Foreground="#69F0AE" FontSize="9.5" Margin="0,0,3.5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Done" Foreground="#E8FFF2" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="doneBd" Property="Background" Value="#4469F0AE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Command="{Binding SnoozeActiveReminderCommand}"
                                    ToolTip="Snooze reminder"
                                    Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,4,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="snzBd" Background="#20FFD54F" BorderBrush="#52FFD54F" BorderThickness="1" CornerRadius="10" Padding="7,3.5">
                                            <TextBlock Text="{Binding SnoozeButtonLabel}" Foreground="#FFE89E" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="snzBd" Property="Background" Value="#38FFD54F"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Command="{Binding DismissActiveReminderCommand}"
                                    ToolTip="Dismiss alert (keeps item in Calendar)"
                                    Width="22" Height="22" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="disBd" Background="#1AFFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="11">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" Foreground="#C8CDD6" FontSize="8.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="disBd" Property="Background" Value="#34FF5E36"/>
                                                <Setter TargetName="disBd" Property="BorderBrush" Value="#70FF5E36"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Left: Glowing Bell Icon + Queue Count Badge -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Border Width="24" Height="24" CornerRadius="12" Background="#24FF5E36" BorderBrush="{Binding ActiveReminderAccentBrush}" BorderThickness="1.2">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEA8F;" Foreground="{Binding ActiveReminderAccentBrush}" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Background="#2CFF5E36" BorderBrush="#65FF5E36" BorderThickness="1" CornerRadius="7" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasMultiplePendingAlerts, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding PendingAlertQueueBadge}" Foreground="#FFE2D8" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <!-- Center: Title + Formatted Time / Overdue Status -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveReminderTitle}"
                                       Foreground="White" FontSize="11.5" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ActiveReminderDetailText}"
                                       Foreground="#FFD54F" FontSize="9.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                </Grid>
            </Grid>
        </Border>

        <!-- ── State 3: PeekExpanded Bento Glass Hub (680 × 412 px) ────────── -->
        <Border x:Name="ExpandedHub"
                Background="#F01A1C20"
                CornerRadius="22"
                BorderBrush="#32FFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="Collapsed"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <ScaleTransform x:Name="HubScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Grid>
                <Border x:Name="HubBorderGlow"
                        CornerRadius="22"
                        BorderThickness="1.5"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"/>

                <Grid Margin="14,12,14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ── Top Pill Tab Navigation ────────────────────────── -->
                    <TabControl Grid.Row="0"
                                Style="{StaticResource BentoTabControl}"
                                SelectedIndex="{Binding SelectedTabIndex}">

                        <!-- TAB 0: EDITABLE & RESIZABLE BENTO HOME DASHBOARD -->
                        <TabItem Style="{StaticResource FluentSegmentedTabItem}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE80F;" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Home" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Sleek Edit Mode Toolbar (only visible while editing Home layout) -->
                                <Border Grid.Row="0" Margin="4,0,4,6" Padding="8,5" CornerRadius="10"
                                        Background="#201A1D24" BorderBrush="#48FF5E36" BorderThickness="1"
                                        Visibility="{Binding IsHomeEditMode, Converter={StaticResource BoolToVis}}">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <Button Command="{Binding ResetHomeLayoutCommand}" ToolTip="Restore default Home layout" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,6,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="rstBd" Background="#16FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="7" Padding="8,3">
                                                            <TextBlock Text="Reset" Foreground="#C8CDD6" FontSize="10" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="rstBd" Property="Background" Value="#28FFFFFF"/></Trigger></ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <Button Command="{Binding ToggleHomeEditModeCommand}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="doneBd" Background="#FF5E36" CornerRadius="7" Padding="10,3">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE73E;" Foreground="White" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Done" Foreground="White" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="doneBd" Property="Background" Value="#FF7350"/></Trigger></ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Button Command="{Binding OpenAddHomeWidgetCommand}" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="addBd" Background="#2800E5FF" BorderBrush="#6500E5FF" BorderThickness="1" CornerRadius="7" Padding="8,3">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" Foreground="#6EEFFF" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Add Slot" Foreground="White" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="addBd" Property="Background" Value="#4200E5FF"/></Trigger></ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>

                                        <TextBlock VerticalAlignment="Center" FontSize="9.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding HomeResizeStatusText}"/>
                                                    <Setter Property="Foreground" Value="#6EEFFF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HomeResizeStatusText}" Value="">
                                                            <Setter Property="Text" Value="Drag corner to resize • Drag card or arrows to move"/>
                                                            <Setter Property="Foreground" Value="#8E94A0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </Border>

                                <!-- Empty Layout Prompt (only when all slots are removed) -->
                                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HomeLayout.Slots.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE80F;" FontSize="26" Foreground="#38FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Home layout is empty" Foreground="#D8FFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Add widget slots to build your custom Bento dashboard" Foreground="#7A808C" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,10"/>
                                    <Button Command="{Binding OpenAddHomeWidgetCommand}" HorizontalAlignment="Center" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="#2800E5FF" BorderBrush="#6500E5FF" BorderThickness="1" CornerRadius="9" Padding="12,5">
                                                    <TextBlock Text="+ Add Widget Slot" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#4200E5FF"/></Trigger></ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                                <!-- Dynamic 4-Column Collision-Free Bento Grid -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="HomeBentoItems" ItemsSource="{Binding HomeLayout.Slots}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Grid controls:HomeGridHelper.RowCount="{Binding DataContext.HomeLayout.TotalRows, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Grid.Row" Value="{Binding GridRow}"/>
                                                <Setter Property="Grid.Column" Value="{Binding GridColumn}"/>
                                                <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}"/>
                                                <Setter Property="Grid.ColumnSpan" Value="{Binding ColSpan}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="4" AllowDrop="True"
                                                        PreviewMouseLeftButtonDown="OnHomeSlotPreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="OnHomeSlotPreviewMouseMove"
                                                        DragOver="OnHomeSlotDragOver"
                                                        Drop="OnHomeSlotDrop"
                                                        MouseRightButtonUp="OnHomeSlotRightButtonUp">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource BentoCard}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsHomeEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="#58FF5E36"/>
                                                                    <Setter Property="BorderThickness" Value="1.2"/>
                                                                    <Setter Property="Cursor" Value="SizeAll"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsPreviewResizing}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="#FF00E5FF"/>
                                                                    <Setter Property="BorderThickness" Value="1.8"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Grid>
                                                        <!-- Adaptive Widget Content -->
                                                        <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource HomeWidgetSelector}"/>

                                                        <!-- Edit Mode Interactive Controls Overlay -->
                                                        <Grid Visibility="{Binding DataContext.IsHomeEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                                              Panel.ZIndex="20">
                                                            <!-- Top Bar: Move Left/Right (Left) + Remove (Right) -->
                                                            <DockPanel VerticalAlignment="Top" Margin="5,5,5,0" LastChildFill="False">
                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                                    <Button Command="{Binding DataContext.MoveHomeSlotLeftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            Width="18" Height="18" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="Move Left" Margin="0,0,3,0">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="bd" Background="#D0181B22" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="9">
                                                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE76B;" FontSize="7.5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#FF2E3440"/></Trigger></ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                    <Button Command="{Binding DataContext.MoveHomeSlotRightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            Width="18" Height="18" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="Move Right">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="bd" Background="#D0181B22" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="9">
                                                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE76C;" FontSize="7.5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#FF2E3440"/></Trigger></ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                </StackPanel>

                                                                <Button Command="{Binding DataContext.RemoveHomeSlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        DockPanel.Dock="Right" Width="18" Height="18" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="Remove Slot">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="bd" Background="#CC341C1A" BorderBrush="#88FF5E36" BorderThickness="1" CornerRadius="9">
                                                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" FontSize="7.5" Foreground="#FFD8CE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#FFFF5E36"/></Trigger></ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </DockPanel>

                                                            <!-- Bottom-Right: Clickable Size Badge (S/W/T/L/Full) + Draggable Corner Resize Grip -->
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,4,4">
                                                                <Button Command="{Binding DataContext.CycleHomeSlotSizeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="Click to cycle size (or drag corner grip)" Margin="0,0,3,0">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="bd" Background="#D8161920" BorderBrush="#48FFFFFF" BorderThickness="1" CornerRadius="6" Padding="5,1.5">
                                                                                <TextBlock Text="{Binding SizeLabel}" Foreground="#D8FFFFFF" FontSize="8.5" FontWeight="Bold"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#FF00E5FF"/></Trigger></ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>

                                                                <Thumb Tag="{Binding}" Width="16" Height="16" Cursor="SizeNWSE"
                                                                       ToolTip="Drag corner to resize"
                                                                       DragStarted="OnHomeSlotResizeStarted"
                                                                       DragDelta="OnHomeSlotResizeDelta"
                                                                       DragCompleted="OnHomeSlotResizeCompleted">
                                                                    <Thumb.Template>
                                                                        <ControlTemplate TargetType="Thumb">
                                                                            <Border x:Name="gripBd" Background="#D8161920" BorderBrush="#4800E5FF" BorderThickness="1" CornerRadius="5">
                                                                                <Path Data="M 4,11 L 11,4 M 7.5,11 L 11,7.5" Stroke="#90EEFF" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="gripBd" Property="Background" Value="#3A00E5FF"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Thumb.Template>
                                                                </Thumb>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- In-Place Frosted Widget Gallery Modal Overlay (+ Add Slot) -->
                                <Border Grid.Row="0" Grid.RowSpan="2"
                                        Panel.ZIndex="100"
                                        Background="#B00D0F14"
                                        CornerRadius="14"
                                        MouseLeftButtonDown="OnCloseHomeGalleryBackdropClick"
                                        Visibility="{Binding IsAddHomeWidgetOpen, Converter={StaticResource BoolToVis}}">
                                    <Border Background="#F61A1D24" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="14"
                                            Padding="12,10" Margin="26,12" VerticalAlignment="Stretch">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                                <Button Command="{Binding CloseAddHomeWidgetCommand}" DockPanel.Dock="Right" Width="22" Height="22" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="Close Gallery">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="#18FFFFFF" BorderBrush="#2CFFFFFF" BorderThickness="1" CornerRadius="11">
                                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" FontSize="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#34FF5E36"/></Trigger></ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <StackPanel>
                                                    <TextBlock Text="Add Home Widget Slot" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                                    <TextBlock Text="Choose a widget below to add it cleanly to your Home layout" Foreground="#8E9098" FontSize="9.5"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding HomeLayout.WidgetCatalog}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="2"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#12FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="10" Padding="9,7" Margin="3">
                                                                <DockPanel LastChildFill="True">
                                                                    <Button Command="{Binding DataContext.AddHomeSlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            DockPanel.Dock="Right" Cursor="Hand" FocusVisualStyle="{x:Null}" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="bd" Background="#2800E5FF" BorderBrush="#5800E5FF" BorderThickness="1" CornerRadius="7" Padding="8,4">
                                                                                    <TextBlock Text="{Binding ActionButtonText}" Foreground="White" FontSize="9.5" FontWeight="Bold"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#4800E5FF"/></Trigger></ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>

                                                                    <Border Width="28" Height="28" CornerRadius="8" Background="#18FFFFFF" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="{Binding IconGlyph}" Foreground="{Binding AccentHex}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>

                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                            <Border Background="#18FFFFFF" CornerRadius="4" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding StatusBadgeText}" Foreground="#A8ACB4" FontSize="8" FontWeight="Bold"/>
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding Subtitle}" Foreground="#808590" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,1.5,0,0"/>
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 1: MEDIA HUB -->
                        <TabItem Style="{StaticResource FluentSegmentedTabItem}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEC4F;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Media" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid Margin="2,4,2,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Bento Album Art Pedestal (Clean, unobstructed 176x176 Artwork + Adaptive Ambient Glow) -->
                                <Grid Grid.Column="0" Width="178" Height="178" Margin="2,0,16,0" VerticalAlignment="Center">
                                    <!-- Ambient Album-Adaptive Glow when playing -->
                                    <Border Width="166" Height="166" CornerRadius="22" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#40000000"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                                        <Setter Property="Background" Value="{Binding MediaAccentGlowBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Effect><BlurEffect Radius="22"/></Border.Effect>
                                    </Border>

                                    <Border CornerRadius="20"
                                            Background="#D822252D"
                                            BorderBrush="#36FFFFFF"
                                            BorderThickness="1"
                                            ClipToBounds="True">
                                        <Grid>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEC4F;"
                                                           FontSize="48" Foreground="#28FFFFFF" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <Image Source="{Binding MediaThumbnail}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <!-- Subtle Top Glass Sheen Overlay -->
                                            <Border IsHitTestVisible="False" CornerRadius="20">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#22FFFFFF" Offset="0"/>
                                                        <GradientStop Color="#00FFFFFF" Offset="0.35"/>
                                                        <GradientStop Color="#26000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Right Bento Playback Panel -->
                                <Border Grid.Column="1" Style="{StaticResource BentoCard}" Padding="16,13">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Audio Output Pill + Player Source Switcher + Live Status Pill -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                            <Border DockPanel.Dock="Right" VerticalAlignment="Center"
                                                    CornerRadius="8" Padding="8,3" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#14FFFFFF"/>
                                                        <Setter Property="BorderBrush" Value="#22FFFFFF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                                                <Setter Property="Background" Value="{Binding MediaAccentGlowBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{Binding MediaAccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="5.5" Height="5.5" Margin="0,0,5,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#75FFFFFF"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                                                        <Setter Property="Fill" Value="{Binding MediaAccentBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="PAUSED"/>
                                                                <Setter Property="Foreground" Value="#8E9098"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                                                        <Setter Property="Text" Value="PLAYING"/>
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Border Style="{StaticResource MicroPillBadge}" Padding="8,4" Margin="0,0,6,0">
                                                    <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ToggleAudioDeviceMenuCommand}" Padding="0" ToolTip="Switch Audio Output Device">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7F6;" FontSize="11.5" Foreground="{Binding MediaAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ActiveAudioDeviceName}" FontSize="11" FontWeight="SemiBold" Foreground="White" MaxWidth="125" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0"
                                                                        Visibility="{Binding HasBluetoothBattery, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEBA0;" FontSize="10.5" Foreground="#69F0AE" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding BluetoothBatteryText}" FontSize="10.5" FontWeight="Bold" Foreground="#69F0AE" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70D;" Foreground="#80FFFFFF" FontSize="8.5" Margin="5,1,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Border>

                                                <!-- Multi-Player SMTC Source Switcher Pill -->
                                                <Border Style="{StaticResource MicroPillBadge}" Padding="8,4">
                                                    <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ToggleMediaSourceMenuCommand}" Padding="0" ToolTip="Switch Controlled Media Player">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEC4F;" FontSize="10.5" Foreground="{Binding MediaAccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ActiveMediaSourceName}" FontSize="11" FontWeight="SemiBold" Foreground="#D8FFFFFF" MaxWidth="80" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70D;" Foreground="#80FFFFFF" FontSize="8.5" Margin="4,1,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Multi-Player Source Dropdown Menu -->
                                        <Border Grid.Row="0" Grid.RowSpan="4"
                                                Tag="MenuPopup"
                                                Visibility="{Binding IsMediaSourceMenuOpen, Converter={StaticResource BoolToVis}}"
                                                Background="#F61A1C20" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10"
                                                Padding="5" Panel.ZIndex="22" VerticalAlignment="Top" HorizontalAlignment="Right"
                                                Margin="0,32,0,0" MinWidth="185" MaxHeight="145">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <TextBlock Text="MEDIA PLAYER" Foreground="#65FFFFFF" FontSize="9.5" FontWeight="Bold" Margin="6,2,4,4"/>
                                                    <TextBlock Text="No active players detected" Foreground="#70FFFFFF" FontSize="10.5" Margin="6,2,6,4">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding MediaSessions.Count}" Value="0">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ItemsControl ItemsSource="{Binding MediaSessions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource NotchIconBtn}"
                                                                        Command="{Binding DataContext.SelectMediaSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Padding="7,4" Margin="0,1">
                                                                    <DockPanel LastChildFill="True">
                                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE73E;" Foreground="#FF5E36" FontSize="11" Margin="6,0,0,0" DockPanel.Dock="Right"
                                                                                   Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                                    </DockPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>

                                        <!-- Audio Device Dropdown Menu -->
                                        <Border Grid.Row="0" Grid.RowSpan="4"
                                                Tag="MenuPopup"
                                                Visibility="{Binding IsAudioDeviceMenuOpen, Converter={StaticResource BoolToVis}}"
                                                Background="#F61A1C20" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10"
                                                Padding="5" Panel.ZIndex="20" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                Margin="0,32,0,0" MinWidth="240" MaxHeight="155">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel>
                                                    <TextBlock Text="OUTPUT DEVICE" Foreground="#65FFFFFF" FontSize="9.5" FontWeight="Bold" Margin="6,2,4,4"/>
                                                    <TextBlock Text="No audio outputs available" Foreground="#70FFFFFF" FontSize="10.5" Margin="6,2,6,4">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AudioDevices.Count}" Value="0">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ItemsControl ItemsSource="{Binding AudioDevices}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource NotchIconBtn}"
                                                                        Command="{Binding DataContext.SelectAudioDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Padding="7,4" Margin="0,1">
                                                                    <DockPanel LastChildFill="True">
                                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE73E;" Foreground="#FF5E36" FontSize="11" Margin="6,0,0,0" DockPanel.Dock="Right"
                                                                                   Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"/>
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="6,0,0,0"
                                                                                    Visibility="{Binding HasBluetoothBattery, Converter={StaticResource BoolToVis}}">
                                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEBA0;" Foreground="#69F0AE" FontSize="9.5" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding BluetoothBatteryText}" Foreground="#69F0AE" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                    </DockPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>

                                        <!-- Row 1: Track Title & Artist / Idle Subtitle -->
                                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                            <TextBlock Text="{Binding MediaTitle}"
                                                       Foreground="White"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       MaxWidth="380"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Foreground="#989BA4"
                                                       FontSize="13"
                                                       Margin="0,3,0,0"
                                                       MaxWidth="380"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding MediaArtist}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasMedia}" Value="False">
                                                                <Setter Property="Text" Value="Play audio or video in any app to control playback here"/>
                                                                <Setter Property="Foreground" Value="#60FFFFFF"/>
                                                                <Setter Property="FontSize" Value="12"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Row 2: Seek Slider -->
                                        <DockPanel Grid.Row="2" Margin="0,0,0,14">
                                            <TextBlock Text="{Binding MediaPositionText}" Foreground="#8E9098" FontSize="11" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding MediaDurationText}" Foreground="#8E9098" FontSize="11" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            <Slider Style="{StaticResource FluentVolumeSlider}"
                                                    Value="{Binding MediaProgressPercent, Mode=TwoWay}"
                                                    IsEnabled="{Binding HasMedia}"
                                                    IsMoveToPointEnabled="True"
                                                    ToolTip="Click or drag to seek track"
                                                    Minimum="0" Maximum="100"
                                                    VerticalAlignment="Center"
                                                    PreviewMouseLeftButtonUp="OnMediaSliderPreviewMouseLeftButtonUp"/>
                                        </DockPanel>

                                        <!-- Row 3: Transport Controls (Left) + Big Live Audio Waveform Visualizer Stage (Right) -->
                                        <DockPanel Grid.Row="3" LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource MediaControlCircleBtn}"
                                                        Command="{Binding PreviousTrackCommand}"
                                                        Margin="0,0,10,0" ToolTip="Previous Track">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE892;" FontSize="12" Foreground="White"/>
                                                </Button>

                                                <Button Style="{StaticResource MediaHeroPlayBtn}"
                                                        Command="{Binding PlayPauseCommand}"
                                                        Margin="0,0,10,0" ToolTip="Play / Pause">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="15">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#xE768;"/>
                                                                <Setter Property="Margin" Value="2,0,0,0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMediaPlaying}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE769;"/>
                                                                        <Setter Property="Margin" Value="0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>

                                                <Button Style="{StaticResource MediaControlCircleBtn}"
                                                        Command="{Binding NextTrackCommand}"
                                                        ToolTip="Next Track">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE893;" FontSize="12" Foreground="White"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- Dedicated Enlarged 16-Bar WASAPI Beat-Synced Audio Waveform Stage -->
                                            <Border Background="#11FFFFFF"
                                                    BorderBrush="#20FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="12,4"
                                                    Height="44"
                                                    Margin="16,0,0,0"
                                                    VerticalAlignment="Center">
                                                <ItemsControl ItemsSource="{Binding WaveBars}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="38"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Rectangle Width="4.5"
                                                                       RadiusX="2.25"
                                                                       RadiusY="2.25"
                                                                       Margin="2.2,0"
                                                                       VerticalAlignment="Center"
                                                                       Height="{Binding Height}"
                                                                       Fill="{Binding DataContext.MediaAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 2: TIMERS & HYDRATION -->
                        <TabItem Style="{StaticResource FluentSegmentedTabItem}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE916;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Timers" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid Margin="2,2,2,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="154"/>
                                    <ColumnDefinition Width="196"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Bento Mode Rail -->
                                <Border Grid.Column="0" Style="{StaticResource BentoCard}" Padding="6" Margin="0,0,8,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <!-- Mode 1: Pomodoro -->
                                        <Button Command="{Binding Timer.SelectModeCommand}" CommandParameter="{x:Static services:TimerMode.Pomodoro}"
                                                Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,0,4">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="10" Padding="9,8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE916;" FontSize="14" Foreground="#FF5E36" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="Pomodoro" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                                <TextBlock Foreground="#7A7D85" FontSize="10" Margin="0,1,0,0" TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding StringFormat="{}{0} • {1}">
                                                                            <Binding Path="DataContext.Timer.PomodoroTimeText" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                            <Binding Path="DataContext.Timer.DialPhaseLabel" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.Timer.IsPomodoroMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#20FFFFFF"/>
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="#32FFFFFF"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Mode 2: Countdown -->
                                        <Button Command="{Binding Timer.SelectModeCommand}" CommandParameter="{x:Static services:TimerMode.Countdown}"
                                                Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,0,4">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="10" Padding="9,8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE823;" FontSize="14" Foreground="#00E5FF" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="Countdown" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding DataContext.Timer.CountdownTimeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           Foreground="#7A7D85" FontSize="10" Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.Timer.IsCountdownMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#20FFFFFF"/>
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="#32FFFFFF"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Mode 3: Stopwatch -->
                                        <Button Command="{Binding Timer.SelectModeCommand}" CommandParameter="{x:Static services:TimerMode.Stopwatch}"
                                                Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,0,4">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="10" Padding="9,8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE917;" FontSize="14" Foreground="#FFD600" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="Stopwatch" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding DataContext.Timer.StopwatchTimeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           Foreground="#7A7D85" FontSize="10" Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.Timer.IsStopwatchMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#20FFFFFF"/>
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="#32FFFFFF"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- Mode 4: Water -->
                                        <Button Command="{Binding Timer.SelectModeCommand}" CommandParameter="{x:Static services:TimerMode.Water}"
                                                Cursor="Hand" FocusVisualStyle="{x:Null}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="10" Padding="9,8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEB42;" FontSize="14" Foreground="#29B6F6" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="Hydration" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding DataContext.Timer.WaterText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           Foreground="#7A7D85" FontSize="10" Margin="0,1,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.Timer.IsWaterMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#20FFFFFF"/>
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="#32FFFFFF"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Column 1: Center Recessed Ring Dial -->
                                <Border Grid.Column="1" Style="{StaticResource BentoCard}" Margin="0,0,8,0">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="174" Height="174">
                                        <controls:ArcProgressRing Width="174" Height="174"
                                                                  Progress="{Binding Timer.DialProgressFraction}"
                                                                  StrokeThickness="8.5"
                                                                  BackgroundBrush="#232730">
                                            <controls:ArcProgressRing.Style>
                                                <Style TargetType="controls:ArcProgressRing">
                                                    <Setter Property="StrokeBrush" Value="#FF5E36"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Timer.IsCountdownMode}" Value="True">
                                                            <Setter Property="StrokeBrush" Value="#00E5FF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Timer.IsStopwatchMode}" Value="True">
                                                            <Setter Property="StrokeBrush" Value="#FFD600"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Timer.IsWaterMode}" Value="True">
                                                            <Setter Property="StrokeBrush" Value="#29B6F6"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </controls:ArcProgressRing.Style>
                                        </controls:ArcProgressRing>

                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Timer.DialTimeText}"
                                                       Foreground="White" FontSize="31" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Timer.DialPhaseLabel}"
                                                       Foreground="#8E9098" FontSize="11.5" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Column 2: Bento Mode Controls -->
                                <Border Grid.Column="2" Style="{StaticResource BentoCard}" Padding="12,10">
                                    <Grid VerticalAlignment="Center">
                                        <!-- POMODORO -->
                                        <Grid Visibility="{Binding Timer.IsPomodoroMode, Converter={StaticResource BoolToVis}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Timer.PomodoroStatusText}" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                                    <Ellipse Width="6.5" Height="6.5" Margin="2.5,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#30FFFFFF"/>
                                                                <Style.Triggers><DataTrigger Binding="{Binding Timer.IsCycle1Active}" Value="True"><Setter Property="Fill" Value="#FF5E36"/></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <Ellipse Width="6.5" Height="6.5" Margin="2.5,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#30FFFFFF"/>
                                                                <Style.Triggers><DataTrigger Binding="{Binding Timer.IsCycle2Active}" Value="True"><Setter Property="Fill" Value="#FF5E36"/></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <Ellipse Width="6.5" Height="6.5" Margin="2.5,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#30FFFFFF"/>
                                                                <Style.Triggers><DataTrigger Binding="{Binding Timer.IsCycle3Active}" Value="True"><Setter Property="Fill" Value="#FF5E36"/></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <Ellipse Width="6.5" Height="6.5" Margin="2.5,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#30FFFFFF"/>
                                                                <Style.Triggers><DataTrigger Binding="{Binding Timer.IsCycle4Active}" Value="True"><Setter Property="Fill" Value="#FF5E36"/></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Timer.PomodoroNextPhaseText}" Foreground="#8E9098" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <Button Style="{StaticResource MediaControlCircleBtn}" Command="{Binding Timer.ResetPomodoroCommand}" ToolTip="Reset Cycle">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="12" Foreground="White"/>
                                                </Button>

                                                <Button Style="{StaticResource MediaHeroPlayBtn}" Command="{Binding Timer.TogglePomodoroCommand}" Margin="12,0" ToolTip="Start / Pause">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="15">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#xE768;"/>
                                                                <Setter Property="Margin" Value="2,0,0,0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Timer.IsPomodoroRunning}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE769;"/>
                                                                        <Setter Property="Margin" Value="0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>

                                                <Button Style="{StaticResource MediaControlCircleBtn}" Command="{Binding Timer.SkipPomodoroCommand}" ToolTip="Skip Phase">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE893;" FontSize="12" Foreground="White"/>
                                                </Button>
                                            </StackPanel>

                                            <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,8">
                                                <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="9" Padding="6,3" Margin="2.5">
                                                    <DockPanel LastChildFill="True">
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.AdjustFocusCommand}" CommandParameter="-5" Content="−" FontSize="12" DockPanel.Dock="Left" Padding="4,0"/>
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.AdjustFocusCommand}" CommandParameter="5" Content="+" FontSize="12" DockPanel.Dock="Right" Padding="4,0"/>
                                                        <TextBlock Text="{Binding Timer.FocusMinutes, StringFormat='{}Focus {0}m'}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Border>

                                                <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="9" Padding="6,3" Margin="2.5">
                                                    <DockPanel LastChildFill="True">
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.AdjustShortBreakCommand}" CommandParameter="-1" Content="−" FontSize="12" DockPanel.Dock="Left" Padding="4,0"/>
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.AdjustShortBreakCommand}" CommandParameter="1" Content="+" FontSize="12" DockPanel.Dock="Right" Padding="4,0"/>
                                                        <TextBlock Text="{Binding Timer.ShortBreakMinutes, StringFormat='{}Break {0}m'}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Border>

                                                <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="9" Padding="6,3" Margin="2.5">
                                                    <DockPanel LastChildFill="True">
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.AdjustLongBreakCommand}" CommandParameter="-5" Content="−" FontSize="12" DockPanel.Dock="Left" Padding="4,0"/>
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.AdjustLongBreakCommand}" CommandParameter="5" Content="+" FontSize="12" DockPanel.Dock="Right" Padding="4,0"/>
                                                        <TextBlock Text="{Binding Timer.LongBreakMinutes, StringFormat='{}Long {0}m'}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Border>

                                                <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="9" Padding="6,3" Margin="2.5">
                                                    <DockPanel LastChildFill="True">
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.AdjustTargetCyclesCommand}" CommandParameter="-1" Content="−" FontSize="12" DockPanel.Dock="Left" Padding="4,0"/>
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.AdjustTargetCyclesCommand}" CommandParameter="1" Content="+" FontSize="12" DockPanel.Dock="Right" Padding="4,0"/>
                                                        <TextBlock Text="{Binding Timer.TargetCycles, StringFormat='{}Cycles {0}'}" Foreground="White" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </Border>
                                            </UniformGrid>

                                            <DockPanel Grid.Row="3" Margin="4,0">
                                                <TextBlock Text="{Binding Timer.CompletedTodayCount, StringFormat='{}{0} done'}" Foreground="#65FFFFFF" FontSize="10.5" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="Auto-next" Foreground="#90FFFFFF" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <CheckBox Style="{StaticResource PillToggleSwitch}" IsChecked="{Binding Timer.AutoStartNext, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Grid>

                                        <!-- COUNTDOWN -->
                                        <Grid Visibility="{Binding Timer.IsCountdownMode, Converter={StaticResource BoolToVis}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <WrapPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                <Button Style="{StaticResource BentoTileBtn}" Command="{Binding Timer.SetCountdownDurationCommand}" CommandParameter="5" Content="5m" FontSize="11" Margin="2" Padding="9,4"/>
                                                <Button Style="{StaticResource BentoTileBtn}" Command="{Binding Timer.SetCountdownDurationCommand}" CommandParameter="10" Content="10m" FontSize="11" Margin="2" Padding="9,4"/>
                                                <Button Style="{StaticResource BentoTileBtn}" Command="{Binding Timer.SetCountdownDurationCommand}" CommandParameter="15" Content="15m" FontSize="11" Margin="2" Padding="9,4"/>
                                                <Button Style="{StaticResource BentoTileBtn}" Command="{Binding Timer.SetCountdownDurationCommand}" CommandParameter="25" Content="25m" FontSize="11" Margin="2" Padding="9,4"/>
                                                <Button Style="{StaticResource BentoTileBtn}" Command="{Binding Timer.SetCountdownDurationCommand}" CommandParameter="30" Content="30m" FontSize="11" Margin="2" Padding="9,4"/>
                                                <Button Style="{StaticResource BentoTileBtn}" Command="{Binding Timer.SetCountdownDurationCommand}" CommandParameter="45" Content="45m" FontSize="11" Margin="2" Padding="9,4"/>
                                                <Button Style="{StaticResource BentoTileBtn}" Command="{Binding Timer.SetCountdownDurationCommand}" CommandParameter="60" Content="60m" FontSize="11" Margin="2" Padding="9,4"/>
                                            </WrapPanel>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,12">
                                                <Button Style="{StaticResource MediaControlCircleBtn}" Command="{Binding Timer.ResetCountdownCommand}" ToolTip="Reset">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="12" Foreground="White"/>
                                                </Button>

                                                <Button Style="{StaticResource MediaHeroPlayBtn}" Command="{Binding Timer.ToggleCountdownCommand}" Margin="12,0" Background="#00E5FF" ToolTip="Start / Pause Countdown">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Foreground="#101216" FontSize="15">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#xE768;"/>
                                                                <Setter Property="Margin" Value="2,0,0,0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Timer.IsCountdownRunning}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE769;"/>
                                                                        <Setter Property="Margin" Value="0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>

                                                <Button Style="{StaticResource MediaControlCircleBtn}" Command="{Binding Timer.AddOneMinuteToCountdownCommand}" ToolTip="+1 Minute">
                                                    <TextBlock Text="+1m" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                                                </Button>
                                            </StackPanel>

                                            <TextBlock Grid.Row="2" Text="Chime plays on completion" Foreground="#70FFFFFF" FontSize="10.5" HorizontalAlignment="Center"/>
                                        </Grid>

                                        <!-- STOPWATCH -->
                                        <Grid Visibility="{Binding Timer.IsStopwatchMode, Converter={StaticResource BoolToVis}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                <Button Style="{StaticResource MediaControlCircleBtn}" Command="{Binding Timer.ResetStopwatchCommand}" ToolTip="Reset">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="12" Foreground="White"/>
                                                </Button>

                                                <Button Style="{StaticResource MediaHeroPlayBtn}" Command="{Binding Timer.ToggleStopwatchCommand}" Margin="12,0" Background="#FFD600" ToolTip="Start / Pause Stopwatch">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Foreground="#101216" FontSize="15">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#xE768;"/>
                                                                <Setter Property="Margin" Value="2,0,0,0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Timer.IsStopwatchRunning}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE769;"/>
                                                                        <Setter Property="Margin" Value="0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>

                                                <Button Style="{StaticResource MediaControlCircleBtn}" Command="{Binding Timer.RecordLapCommand}" ToolTip="Record Lap">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7C1;" FontSize="12" Foreground="White"/>
                                                </Button>
                                            </StackPanel>

                                            <Border Grid.Row="1" Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Padding="6,4" Height="112">
                                                <Grid>
                                                    <TextBlock Text="Tap flag icon to record lap splits" Foreground="#58FFFFFF" FontSize="10.5"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Timer.Laps.Count}" Value="0">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ListBox ItemsSource="{Binding Timer.Laps}" Background="Transparent" BorderThickness="0"
                                                             ItemContainerStyle="{StaticResource NoHighlightListBoxItem}"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" Foreground="#E8FFFFFF" FontSize="11" Margin="4,2"/>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- WATER -->
                                        <Grid Visibility="{Binding Timer.IsWaterMode, Converter={StaticResource BoolToVis}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding Timer.WaterVolumeText}" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                                                <Button Style="{StaticResource BentoTileBtn}" Command="{Binding Timer.RemoveWaterCupCommand}" Content="− 1 Cup" FontSize="11.5" Padding="12,8" Margin="0,0,8,0"/>
                                                <Button Style="{StaticResource BentoTileBtn}" Command="{Binding Timer.AddWaterCupCommand}" Content="+ 1 Cup (250ml)" FontSize="11.5" FontWeight="Bold" Padding="14,8" Background="#2529B6F6" BorderBrush="#5029B6F6"/>
                                            </StackPanel>

                                            <DockPanel Grid.Row="2">
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.ResetWaterCommand}" DockPanel.Dock="Right" Padding="6,3" ToolTip="Reset today">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="10" Foreground="#80FFFFFF" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Reset" Foreground="#80FFFFFF" FontSize="10.5"/>
                                                    </StackPanel>
                                                </Button>
                                                <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="9" Padding="6,3" HorizontalAlignment="Left">
                                                    <DockPanel LastChildFill="True">
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.AdjustWaterTargetCommand}" CommandParameter="-1" Content="−" FontSize="11" DockPanel.Dock="Left" Padding="4,0"/>
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding Timer.AdjustWaterTargetCommand}" CommandParameter="1" Content="+" FontSize="11" DockPanel.Dock="Right" Padding="4,0"/>
                                                        <TextBlock Text="{Binding Timer.WaterCupsTarget, StringFormat='{}Goal {0} cups'}" Foreground="#B0FFFFFF" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0"/>
                                                    </DockPanel>
                                                </Border>
                                            </DockPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 3: SHELF (SPLIT DOCK + SMART CLIPBOARD) -->
                        <TabItem Style="{StaticResource FluentSegmentedTabItem}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Shelf" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid Margin="2,2,2,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="244"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT PANEL: DOCK (Drag-in to stage, Drag-out to remove) -->
                                <Border Grid.Column="0" Style="{StaticResource BentoCard}" Padding="10,9">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" FontSize="12" Foreground="#FF5E36" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Dock" Foreground="White" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Border Background="#20FFFFFF" CornerRadius="7" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ShelfItems.Count}" Foreground="#E0FFFFFF" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding CaptureScreenCommand}" Background="#14FFFFFF" Padding="6,3" ToolTip="Capture Screen to Dock">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE722;" FontSize="10.5" Foreground="#FF5E36" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Snip" FontSize="10.5" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ShareDockDirectlyCommand}" IsEnabled="{Binding HasStagedFiles}" Background="#22FF5E36" Padding="5,3" Margin="4,0,0,0" ToolTip="Send Dock Files via Google Quick Share">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72D;" FontSize="10.5" Foreground="#FF5E36"/>
                                                </Button>
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding CopyShelfPathsCommand}" IsEnabled="{Binding HasStagedFiles}" Background="#14FFFFFF" Padding="5,3" Margin="4,0,0,0" ToolTip="Copy File Paths">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="10.5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#xE8C8;"/>
                                                                <Setter Property="Foreground" Value="#C0FFFFFF"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShelfCopied}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE73E;"/>
                                                                        <Setter Property="Foreground" Value="#69F0AE"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ClearShelfCommand}" IsEnabled="{Binding HasStagedFiles}" Background="#14FFFFFF" Padding="5,3" Margin="4,0,0,0" ToolTip="Clear Dock">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" FontSize="10.5" Foreground="#B0FFFFFF"/>
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <TextBlock Grid.Row="1" Text="Drop files here • Drag out to remove" Foreground="#68FFFFFF" FontSize="10" Margin="0,0,0,6"/>

                                        <!-- Empty Drop Target -->
                                        <Border Grid.Row="2" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="10" Background="#0AFFFFFF" Padding="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShelfItems.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE898;" FontSize="24" Foreground="#45FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                <TextBlock Text="Drop files to stage" Foreground="#88FFFFFF" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Drag a file back out to pop it off the dock" Foreground="#50FFFFFF" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Staged Files List -->
                                        <ListBox Grid.Row="2" ItemsSource="{Binding ShelfItems}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ItemContainerStyle="{StaticResource NoHighlightListBoxItem}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 PreviewMouseMove="OnShelfListPreviewMouseMove"
                                                 PreviewMouseLeftButtonDown="OnShelfListPreviewMouseLeftButtonDown">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#12FFFFFF" BorderBrush="#1EFFFFFF" BorderThickness="1" CornerRadius="9" Padding="7,5" Margin="0,2" Cursor="Hand">
                                                        <DockPanel LastChildFill="True">
                                                            <Button Style="{StaticResource NotchIconBtn}"
                                                                    Command="{Binding DataContext.RemoveShelfItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    DockPanel.Dock="Right" Padding="4,2" ToolTip="Remove">
                                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" FontSize="9.5" Foreground="#70FFFFFF"/>
                                                            </Button>
                                                            <TextBlock Text="{Binding FormattedSize}" DockPanel.Dock="Right"
                                                                       Foreground="#70FFFFFF" FontSize="10" Margin="4,0" VerticalAlignment="Center"/>
                                                            <Border Width="20" Height="20" CornerRadius="5" Background="#18FFFFFF" Margin="0,0,7,0" ClipToBounds="True" VerticalAlignment="Center">
                                                                <Grid>
                                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" FontSize="10" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="11.5" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <!-- RIGHT PANEL: SMART CLIPBOARD (Text, Images & URLs) -->
                                <Border Grid.Column="2" Style="{StaticResource BentoCard}" Padding="10,9">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header: Clipboard Title + Type Filters + Clear -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                            <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ClearClipboardHistoryCommand}"
                                                    Background="#12FFFFFF" Padding="6,3" DockPanel.Dock="Right" ToolTip="Clear unpinned clipboard items">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" FontSize="10.5" Foreground="#9A9CA2"/>
                                            </Button>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE77F;" FontSize="12" Foreground="#FF5E36" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Clipboard" Foreground="White" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                <!-- Filter Pills -->
                                                <Button Command="{Binding SetClipboardFilterCommand}" CommandParameter="0" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,3,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" CornerRadius="7" Padding="7,2.5" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                                                <TextBlock x:Name="txt" Text="All" FontSize="10" FontWeight="SemiBold" Foreground="#9A9CA2"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding ClipboardFilterIndex}" Value="0">
                                                                    <Setter TargetName="bd" Property="Background" Value="#2CFF5E36"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#FF5E36"/>
                                                                    <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Button Command="{Binding SetClipboardFilterCommand}" CommandParameter="1" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,3,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" CornerRadius="7" Padding="7,2.5" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                                                <TextBlock x:Name="txt" Text="Text" FontSize="10" FontWeight="SemiBold" Foreground="#9A9CA2"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding ClipboardFilterIndex}" Value="1">
                                                                    <Setter TargetName="bd" Property="Background" Value="#2CFF5E36"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#FF5E36"/>
                                                                    <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Button Command="{Binding SetClipboardFilterCommand}" CommandParameter="2" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,3,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" CornerRadius="7" Padding="7,2.5" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                                                <TextBlock x:Name="txt" Text="Images" FontSize="10" FontWeight="SemiBold" Foreground="#9A9CA2"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding ClipboardFilterIndex}" Value="2">
                                                                    <Setter TargetName="bd" Property="Background" Value="#2CFF5E36"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#FF5E36"/>
                                                                    <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Button Command="{Binding SetClipboardFilterCommand}" CommandParameter="3" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" CornerRadius="7" Padding="7,2.5" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                                                <TextBlock x:Name="txt" Text="URLs" FontSize="10" FontWeight="SemiBold" Foreground="#9A9CA2"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding ClipboardFilterIndex}" Value="3">
                                                                    <Setter TargetName="bd" Property="Background" Value="#2CFF5E36"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#FF5E36"/>
                                                                    <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Search Box -->
                                        <Border Grid.Row="1" Background="#10FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                                CornerRadius="8" Margin="0,0,0,6" Padding="8,4">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE721;" FontSize="10.5" Foreground="#70FFFFFF" Margin="0,0,7,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ClearClipboardSearchCommand}"
                                                        Visibility="{Binding HasClipboardSearchText, Converter={StaticResource BoolToVis}}"
                                                        DockPanel.Dock="Right" Padding="3,1" Margin="4,0,0,0" ToolTip="Clear search">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" FontSize="9" Foreground="#80FFFFFF"/>
                                                </Button>
                                                <Grid>
                                                    <TextBlock Text="Search copied text, links, or domains..." Foreground="#50FFFFFF" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ClipboardSearchText}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBox Text="{Binding ClipboardSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="Transparent" Foreground="White" CaretBrush="#FF5E36"
                                                             BorderThickness="0" FontSize="11.5" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DockPanel>
                                        </Border>

                                        <!-- Empty State -->
                                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FilteredClipboardHistory.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE77F;" FontSize="22" Foreground="#40FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                            <TextBlock Foreground="#60FFFFFF" FontSize="11.5" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="No matching clipboard items"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ClipboardHistory.Count}" Value="0">
                                                                <Setter Property="Text" Value="Copy text, URLs, or images anywhere"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Smart Clipboard List -->
                                        <ListBox Grid.Row="2" ItemsSource="{Binding FilteredClipboardHistory}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ItemContainerStyle="{StaticResource NoHighlightListBoxItem}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#10FFFFFF" BorderBrush="#1EFFFFFF" BorderThickness="1" CornerRadius="9" Margin="0,2" Padding="6,4">
                                                        <DockPanel LastChildFill="True">
                                                            <Button Style="{StaticResource NotchIconBtn}"
                                                                    Command="{Binding DataContext.RemoveClipboardItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    DockPanel.Dock="Right" Padding="4,3" ToolTip="Remove">
                                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" FontSize="9.5" Foreground="#65FFFFFF"/>
                                                            </Button>
                                                            <Button Style="{StaticResource NotchIconBtn}"
                                                                    Command="{Binding DataContext.TogglePinClipboardItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    DockPanel.Dock="Right" Margin="1,0" Padding="4,3" ToolTip="Pin / Unpin">
                                                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="10.5">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="&#xE734;"/>
                                                                            <Setter Property="Foreground" Value="#55FFFFFF"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                                    <Setter Property="Text" Value="&#xE735;"/>
                                                                                    <Setter Property="Foreground" Value="#FF5E36"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Button>
                                                            <Button Style="{StaticResource NotchIconBtn}"
                                                                    Command="{Binding DataContext.OpenClipboardUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding IsUrl, Converter={StaticResource BoolToVis}}"
                                                                    DockPanel.Dock="Right" Margin="1,0" Padding="4,3" ToolTip="Open Link in Browser">
                                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A7;" FontSize="10.5" Foreground="#00E5FF"/>
                                                            </Button>

                                                            <Button Style="{StaticResource NotchIconBtn}"
                                                                    Command="{Binding DataContext.CopyClipboardItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Padding="4,2">
                                                                <DockPanel LastChildFill="True">
                                                                    <TextBlock Text="Copied" Foreground="#69F0AE" FontWeight="Bold" FontSize="10"
                                                                               DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                               Visibility="{Binding IsCopied, Converter={StaticResource BoolToVis}}"/>

                                                                    <!-- Image Thumbnail Preview -->
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                                Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                                                        <Border Width="42" Height="28" CornerRadius="5" Background="#22000000" BorderBrush="#2CFFFFFF" BorderThickness="1" ClipToBounds="True" Margin="0,0,8,0">
                                                                            <Image Source="{Binding ImageThumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                        </Border>
                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <TextBlock Text="Copied Image" Foreground="White" FontSize="11.5" FontWeight="SemiBold"/>
                                                                            <TextBlock Text="{Binding BadgeText}" Foreground="#78FFFFFF" FontSize="9.5"/>
                                                                        </StackPanel>
                                                                    </StackPanel>

                                                                    <!-- URL Preview -->
                                                                    <DockPanel LastChildFill="True" VerticalAlignment="Center"
                                                                               Visibility="{Binding IsUrl, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE71B;" FontSize="11" Foreground="#00E5FF" Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                                                        <Border Background="#1800E5FF" BorderBrush="#3500E5FF" BorderThickness="1" CornerRadius="5" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center" DockPanel.Dock="Left">
                                                                            <TextBlock Text="{Binding BadgeText}" Foreground="#00E5FF" FontSize="9.5" FontWeight="SemiBold" MaxWidth="90" TextTrimming="CharacterEllipsis"/>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Preview}" Foreground="#E8FFFFFF" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                    </DockPanel>

                                                                    <!-- Text Preview -->
                                                                    <DockPanel LastChildFill="True" VerticalAlignment="Center"
                                                                               Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" FontSize="10.5" Foreground="#80FFFFFF" Margin="0,0,7,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                                                        <TextBlock Text="{Binding Preview}" Foreground="White" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                    </DockPanel>
                                                                </DockPanel>
                                                            </Button>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 4: REWORKED CALENDAR, EVENTS & PERSISTENT REMINDERS -->
                        <TabItem Style="{StaticResource FluentSegmentedTabItem}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE787;" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Calendar" VerticalAlignment="Center"/>
                                    <Ellipse Width="5.5" Height="5.5" Fill="#FF5E36" Margin="5,0,0,0" VerticalAlignment="Center"
                                             Visibility="{Binding Calendar.HasOverdueToday, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid Margin="2,2,2,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="314"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Card: Whole-Month Calendar Grid + Split Event/Reminder Indicators -->
                                <Border Grid.Column="0" Style="{StaticResource BentoCard}" Padding="10,9">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Month Header & Navigation -->
                                        <DockPanel Grid.Row="0" Margin="2,0,2,7">
                                            <TextBlock Text="{Binding Calendar.MonthYearLabel}" Foreground="White" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding CalendarTodayCommand}" Background="#14FFFFFF" Padding="7,2.5" Margin="0,0,4,0">
                                                    <TextBlock Text="Today" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF5E36"/>
                                                </Button>
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding CalendarPreviousMonthCommand}" Background="#12FFFFFF" Padding="6,3" Margin="0,0,3,0" ToolTip="Previous Month">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE76B;" FontSize="9.5" Foreground="White"/>
                                                </Button>
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding CalendarNextMonthCommand}" Background="#12FFFFFF" Padding="6,3" ToolTip="Next Month">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE76C;" FontSize="9.5" Foreground="White"/>
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Weekday Labels -->
                                        <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,4">
                                            <TextBlock Text="SUN" Foreground="#FF7E5A" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="MON" Foreground="#8E9098" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="TUE" Foreground="#8E9098" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="WED" Foreground="#8E9098" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="THU" Foreground="#8E9098" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="FRI" Foreground="#8E9098" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="SAT" Foreground="#8E9098" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </UniformGrid>

                                        <!-- 6x7 Month Days Grid with Split Event (Solid) vs Reminder (Ring) Dots -->
                                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Calendar.MonthDays}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7" Rows="6"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.CalendarSelectDateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="1">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="cellBd" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.2">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="*"/>
                                                                            <RowDefinition Height="7"/>
                                                                        </Grid.RowDefinitions>

                                                                        <Border x:Name="todayCircle" Width="21" Height="21" CornerRadius="10.5" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                                                                            <TextBlock x:Name="dayTxt" Text="{Binding DayNumber}" FontSize="11.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>

                                                                        <!-- Split Indicator Row: Solid Dots (Events) + Hollow Rings (Reminders) -->
                                                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                                                                            <ItemsControl ItemsSource="{Binding EventDotColors}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Ellipse Width="4" Height="4" Fill="{Binding}" Margin="1,0"/>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>

                                                                            <ItemsControl ItemsSource="{Binding ReminderDotColors}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Border Width="4.5" Height="4.5" CornerRadius="2.25" Background="Transparent" BorderBrush="{Binding}" BorderThickness="1.15" Margin="1,0"/>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="cellBd" Property="Background" Value="#16FFFFFF"/>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                        <Setter TargetName="dayTxt" Property="Foreground" Value="#48FFFFFF"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HasOverdueReminder}" Value="True">
                                                                        <Setter TargetName="cellBd" Property="BorderBrush" Value="#55FF5E36"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter TargetName="cellBd" Property="Background" Value="#20FF5E36"/>
                                                                        <Setter TargetName="cellBd" Property="BorderBrush" Value="#AAFF5E36"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                        <Setter TargetName="todayCircle" Property="Background" Value="#FF5E36"/>
                                                                        <Setter TargetName="dayTxt" Property="Foreground" Value="White"/>
                                                                        <Setter TargetName="dayTxt" Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Compact Bottom Legend & Clock Format Pill -->
                                        <DockPanel Grid.Row="3" Margin="2,5,2,0" LastChildFill="False">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                                <Ellipse Width="5" Height="5" Fill="#00E5FF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="Event" Foreground="#8E9098" FontSize="9.5" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <Border Width="5.5" Height="5.5" CornerRadius="2.75" BorderBrush="#FF5E36" BorderThickness="1.2" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="Reminder" Foreground="#8E9098" FontSize="9.5" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <Border Background="#12FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="6" Padding="5,1.5" DockPanel.Dock="Right">
                                                <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="#B0B4BC">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="12H AM/PM"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Use24HourClock}" Value="True">
                                                                    <Setter Property="Text" Value="24H CLOCK"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DockPanel>
                                    </Grid>
                                </Border>

                                <!-- Right Card: Selected Day Agenda, Filters, Overdue Rescue & 12-Hour Composer -->
                                <Border Grid.Column="2" Style="{StaticResource BentoCard}" Padding="11,9">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,7">
                                            <Button Command="{Binding ToggleAddCalendarEventCommand}" DockPanel.Dock="Right" Cursor="Hand" FocusVisualStyle="{x:Null}" VerticalAlignment="Top">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="newBd" CornerRadius="8" Padding="9,4" Background="#FF5E36">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock x:Name="newIco" FontFamily="Segoe Fluent Icons" Text="&#xE710;" FontSize="9.5" Foreground="White" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="newTxt" Text="New" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.IsAddingCalendarEvent, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter TargetName="newBd" Property="Background" Value="#24FFFFFF"/>
                                                                <Setter TargetName="newIco" Property="Text" Value="&#xE711;"/>
                                                                <Setter TargetName="newTxt" Property="Text" Value="Cancel"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE787;" FontSize="12" Foreground="#FF5E36" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Calendar.SelectedDateHeader}" Foreground="White" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Calendar.AgendaSummaryText}" Foreground="#8E9098" FontSize="10" Margin="18,1,0,0"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Dedicated Differentiated Event & Reminder Composer View -->
                                        <ScrollViewer Grid.Row="1"
                                                      Visibility="{Binding IsAddingCalendarEvent, Converter={StaticResource BoolToVis}}"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <Border Background="#14FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="10" Padding="9,8">
                                                <StackPanel>
                                                    <!-- Type Segmented Toggle + Mode Caption -->
                                                    <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                                        <Border Background="#12FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="8" Padding="2" DockPanel.Dock="Left">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Command="{Binding SetCalendarTypeCommand}" CommandParameter="True" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="pill" CornerRadius="6" Padding="9,3.5" Background="Transparent">
                                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEA8F;" FontSize="10" Foreground="#FF5E36" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="Reminder" Foreground="#E0FFFFFF" FontSize="10.5" FontWeight="SemiBold"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <DataTrigger Binding="{Binding DataContext.NewCalendarIsReminder, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                                    <Setter TargetName="pill" Property="Background" Value="#34FF5E36"/>
                                                                                </DataTrigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                                <Button Command="{Binding SetCalendarTypeCommand}" CommandParameter="False" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="2,0,0,0">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="pill" CornerRadius="6" Padding="9,3.5" Background="Transparent">
                                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE787;" FontSize="10" Foreground="#00E5FF" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="Event" Foreground="#E0FFFFFF" FontSize="10.5" FontWeight="SemiBold"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <DataTrigger Binding="{Binding DataContext.NewCalendarIsEvent, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                                    <Setter TargetName="pill" Property="Background" Value="#2C00E5FF"/>
                                                                                </DataTrigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>

                                                        <Button Command="{Binding ToggleCalendarAllDayCommand}" DockPanel.Dock="Right" Cursor="Hand" FocusVisualStyle="{x:Null}" VerticalAlignment="Center">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="allBd" Background="#16FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="7" Padding="8,3.5">
                                                                        <TextBlock x:Name="allTxt" Text="All Day" Foreground="#B0B4BC" FontSize="10" FontWeight="SemiBold"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.NewCalendarIsAllDay, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                            <Setter TargetName="allBd" Property="Background" Value="#2CFF5E36"/>
                                                                            <Setter TargetName="allBd" Property="BorderBrush" Value="#80FF5E36"/>
                                                                            <Setter TargetName="allTxt" Property="Foreground" Value="White"/>
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DockPanel>

                                                    <TextBlock Text="{Binding ComposerModeHintText}" Foreground="#7E848E" FontSize="9.5" Margin="2,0,0,6"/>

                                                    <!-- Title Input -->
                                                    <Border Background="#18000000" BorderBrush="#2CFFFFFF" BorderThickness="1" CornerRadius="8" Padding="8,4.5" Margin="0,0,0,7">
                                                        <Grid>
                                                            <TextBlock Foreground="#58FFFFFF" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Setter Property="Text" Value="Remind me to... (e.g. Call Alex, Take meds)"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding NewCalendarTitle}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding NewCalendarIsEvent}" Value="True">
                                                                                <Setter Property="Text" Value="Event title... (e.g. Team Standup, Focus Block)"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBox Text="{Binding NewCalendarTitle, UpdateSourceTrigger=PropertyChanged}"
                                                                     Background="Transparent" Foreground="White" CaretBrush="#FF5E36" BorderThickness="0" FontSize="11.5"/>
                                                        </Grid>
                                                    </Border>

                                                    <!-- 12-Hour AM/PM Stepper Time Picker + Quick Presets -->
                                                    <StackPanel Margin="0,0,0,7">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding NewCalendarIsAllDay}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>

                                                        <DockPanel Margin="0,0,0,5" LastChildFill="False">
                                                            <!-- Editable + Stepper Hour & Minute Time Input -->
                                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                                <Border Background="#1A000000" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="7" Padding="2,1.5">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding StepCalendarHourCommand}" CommandParameter="-1" Padding="4,1" ToolTip="Hour -1">
                                                                            <TextBlock Text="−" FontSize="11" FontWeight="Bold" Foreground="#A8ACB4"/>
                                                                        </Button>
                                                                        <TextBox x:Name="CalendarHourBox"
                                                                                 Text="{Binding NewCalendarHourInput, UpdateSourceTrigger=PropertyChanged}"
                                                                                 MaxLength="2" Width="23" Padding="0"
                                                                                 Background="Transparent" Foreground="White" CaretBrush="#FF5E36"
                                                                                 BorderThickness="0" FontSize="12" FontWeight="Bold"
                                                                                 TextAlignment="Center" VerticalAlignment="Center"
                                                                                 ToolTip="Type hour or scroll wheel"
                                                                                 GotKeyboardFocus="OnCalendarTimeBoxGotFocus"
                                                                                 PreviewMouseLeftButtonDown="OnCalendarTimeBoxMouseDown"
                                                                                 PreviewMouseWheel="OnCalendarHourMouseWheel"
                                                                                 LostFocus="OnCalendarTimeBoxLostFocus"/>
                                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding StepCalendarHourCommand}" CommandParameter="1" Padding="4,1" ToolTip="Hour +1">
                                                                            <TextBlock Text="+" FontSize="11" FontWeight="Bold" Foreground="#A8ACB4"/>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Border>

                                                                <TextBlock Text=":" Foreground="#8E9098" FontSize="13" FontWeight="Bold" Margin="4,0" VerticalAlignment="Center"/>

                                                                <Border Background="#1A000000" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="7" Padding="2,1.5">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding StepCalendarMinuteCommand}" CommandParameter="-5" Padding="4,1" ToolTip="Minute -5">
                                                                            <TextBlock Text="−" FontSize="11" FontWeight="Bold" Foreground="#A8ACB4"/>
                                                                        </Button>
                                                                        <TextBox x:Name="CalendarMinuteBox"
                                                                                 Text="{Binding NewCalendarMinuteInput, UpdateSourceTrigger=PropertyChanged}"
                                                                                 MaxLength="2" Width="23" Padding="0"
                                                                                 Background="Transparent" Foreground="White" CaretBrush="#FF5E36"
                                                                                 BorderThickness="0" FontSize="12" FontWeight="Bold"
                                                                                 TextAlignment="Center" VerticalAlignment="Center"
                                                                                 ToolTip="Type minutes (00-59) or scroll wheel"
                                                                                 GotKeyboardFocus="OnCalendarTimeBoxGotFocus"
                                                                                 PreviewMouseLeftButtonDown="OnCalendarTimeBoxMouseDown"
                                                                                 PreviewMouseWheel="OnCalendarMinuteMouseWheel"
                                                                                 LostFocus="OnCalendarTimeBoxLostFocus"/>
                                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding StepCalendarMinuteCommand}" CommandParameter="5" Padding="4,1" ToolTip="Minute +5">
                                                                            <TextBlock Text="+" FontSize="11" FontWeight="Bold" Foreground="#A8ACB4"/>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- AM / PM Segmented Pill Toggle (12-Hr Mode) -->
                                                            <Border Background="#12FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="7" Padding="2" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Use24HourClock}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Button Command="{Binding SetCalendarMeridiemCommand}" CommandParameter="False" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="amBd" CornerRadius="5" Padding="8,3" Background="#32FF5E36">
                                                                                    <TextBlock x:Name="amTxt" Text="AM" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <DataTrigger Binding="{Binding DataContext.NewCalendarIsPm, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                                        <Setter TargetName="amBd" Property="Background" Value="Transparent"/>
                                                                                        <Setter TargetName="amTxt" Property="Foreground" Value="#8E9098"/>
                                                                                    </DataTrigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                    <Button Command="{Binding SetCalendarMeridiemCommand}" CommandParameter="True" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="2,0,0,0">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="pmBd" CornerRadius="5" Padding="8,3" Background="Transparent">
                                                                                    <TextBlock x:Name="pmTxt" Text="PM" FontSize="10" FontWeight="Bold" Foreground="#8E9098"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <DataTrigger Binding="{Binding DataContext.NewCalendarIsPm, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                                        <Setter TargetName="pmBd" Property="Background" Value="#32FF5E36"/>
                                                                                        <Setter TargetName="pmTxt" Property="Foreground" Value="White"/>
                                                                                    </DataTrigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DockPanel>

                                                        <!-- Quick Time Preset Chips -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ApplyTimePresetCommand}" CommandParameter="+15m" Background="#14FFFFFF" Padding="6,2.5" Margin="0,0,4,0">
                                                                <TextBlock Text="+15m" FontSize="9.5" FontWeight="SemiBold" Foreground="#D0D4DC"/>
                                                            </Button>
                                                            <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ApplyTimePresetCommand}" CommandParameter="+1h" Background="#14FFFFFF" Padding="6,2.5" Margin="0,0,4,0">
                                                                <TextBlock Text="+1h" FontSize="9.5" FontWeight="SemiBold" Foreground="#D0D4DC"/>
                                                            </Button>
                                                            <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ApplyTimePresetCommand}" CommandParameter="Morning" Background="#14FFFFFF" Padding="6,2.5" Margin="0,0,4,0">
                                                                <TextBlock Text="9 AM" FontSize="9.5" FontWeight="SemiBold" Foreground="#D0D4DC"/>
                                                            </Button>
                                                            <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ApplyTimePresetCommand}" CommandParameter="Evening" Background="#14FFFFFF" Padding="6,2.5" Margin="0,0,4,0">
                                                                <TextBlock Text="5 PM" FontSize="9.5" FontWeight="SemiBold" Foreground="#D0D4DC"/>
                                                            </Button>
                                                            <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ApplyTimePresetCommand}" CommandParameter="Tonight" Background="#14FFFFFF" Padding="6,2.5">
                                                                <TextBlock Text="8 PM" FontSize="9.5" FontWeight="SemiBold" Foreground="#D0D4DC"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- MODE A: Reminder Specific Options (Repeat + High Priority + Chime) -->
                                                    <Border Background="#14FF5E36" BorderBrush="#28FF5E36" BorderThickness="1" CornerRadius="8" Padding="7,5.5" Margin="0,0,0,7"
                                                            Visibility="{Binding NewCalendarIsReminder, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel>
                                                            <DockPanel Margin="0,0,0,5" LastChildFill="False">
                                                                <TextBlock Text="Repeat" Foreground="#B8BCC4" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                                    <Button Command="{Binding SetReminderRepeatRuleCommand}" CommandParameter="Once" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,3,0">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="bd" CornerRadius="5" Padding="6,2" Background="#18FFFFFF">
                                                                                    <TextBlock Text="Once" FontSize="9.5" Foreground="White"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <DataTrigger Binding="{Binding DataContext.NewCalendarRepeatRule, RelativeSource={RelativeSource AncestorType=Window}}" Value="Once">
                                                                                        <Setter TargetName="bd" Property="Background" Value="#48FF5E36"/>
                                                                                    </DataTrigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                    <Button Command="{Binding SetReminderRepeatRuleCommand}" CommandParameter="Daily" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,3,0">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="bd" CornerRadius="5" Padding="6,2" Background="#18FFFFFF">
                                                                                    <TextBlock Text="Daily" FontSize="9.5" Foreground="White"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <DataTrigger Binding="{Binding DataContext.NewCalendarRepeatRule, RelativeSource={RelativeSource AncestorType=Window}}" Value="Daily">
                                                                                        <Setter TargetName="bd" Property="Background" Value="#48FF5E36"/>
                                                                                    </DataTrigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                    <Button Command="{Binding SetReminderRepeatRuleCommand}" CommandParameter="Weekdays" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,3,0">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="bd" CornerRadius="5" Padding="6,2" Background="#18FFFFFF">
                                                                                    <TextBlock Text="Wkdays" FontSize="9.5" Foreground="White"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <DataTrigger Binding="{Binding DataContext.NewCalendarRepeatRule, RelativeSource={RelativeSource AncestorType=Window}}" Value="Weekdays">
                                                                                        <Setter TargetName="bd" Property="Background" Value="#48FF5E36"/>
                                                                                    </DataTrigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                    <Button Command="{Binding SetReminderRepeatRuleCommand}" CommandParameter="Weekly" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="bd" CornerRadius="5" Padding="6,2" Background="#18FFFFFF">
                                                                                    <TextBlock Text="Weekly" FontSize="9.5" Foreground="White"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <DataTrigger Binding="{Binding DataContext.NewCalendarRepeatRule, RelativeSource={RelativeSource AncestorType=Window}}" Value="Weekly">
                                                                                        <Setter TargetName="bd" Property="Background" Value="#48FF5E36"/>
                                                                                    </DataTrigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                </StackPanel>
                                                            </DockPanel>

                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Command="{Binding ToggleCalendarHighPriorityCommand}" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,5,0" ToolTip="Mark Reminder as Urgent">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="bd" CornerRadius="6" Padding="7,2.5" Background="#16FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1">
                                                                                <TextBlock x:Name="txt" Text="★ Urgent" FontSize="9.5" FontWeight="SemiBold" Foreground="#B0B4BC"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <DataTrigger Binding="{Binding DataContext.NewCalendarIsHighPriority, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                                    <Setter TargetName="bd" Property="Background" Value="#34FFD54F"/>
                                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#80FFD54F"/>
                                                                                    <Setter TargetName="txt" Property="Foreground" Value="#FFE89E"/>
                                                                                </DataTrigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>

                                                                <Button Command="{Binding ToggleCalendarPlayChimeCommand}" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="Play sound chime when due">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="bd" CornerRadius="6" Padding="7,2.5" Background="#16FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1">
                                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <TextBlock x:Name="ico" FontFamily="Segoe Fluent Icons" Text="&#xEA8F;" FontSize="9.5" Foreground="#B0B4BC" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                                    <TextBlock x:Name="txt" Text="Chime Alert" FontSize="9.5" FontWeight="SemiBold" Foreground="#B0B4BC" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <DataTrigger Binding="{Binding DataContext.NewCalendarPlayChime, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                                    <Setter TargetName="bd" Property="Background" Value="#2A69F0AE"/>
                                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#6869F0AE"/>
                                                                                    <Setter TargetName="ico" Property="Foreground" Value="#69F0AE"/>
                                                                                    <Setter TargetName="txt" Property="Foreground" Value="#D8FFE8"/>
                                                                                </DataTrigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- MODE B: Event Specific Options (Duration + Location / Meeting Link) -->
                                                    <Border Background="#1200E5FF" BorderBrush="#2800E5FF" BorderThickness="1" CornerRadius="8" Padding="7,5.5" Margin="0,0,0,7"
                                                            Visibility="{Binding NewCalendarIsEvent, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel>
                                                            <DockPanel Margin="0,0,0,5" LastChildFill="False">
                                                                <TextBlock Text="Duration" Foreground="#B8BCC4" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                                    <Button Command="{Binding SelectEventDurationCommand}" CommandParameter="15" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,3,0">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="bd" CornerRadius="5" Padding="6,2" Background="#18FFFFFF">
                                                                                    <TextBlock Text="15m" FontSize="9.5" Foreground="White"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <DataTrigger Binding="{Binding DataContext.NewCalendarDurationMinutes, RelativeSource={RelativeSource AncestorType=Window}}" Value="15">
                                                                                        <Setter TargetName="bd" Property="Background" Value="#4000E5FF"/>
                                                                                    </DataTrigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                    <Button Command="{Binding SelectEventDurationCommand}" CommandParameter="30" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,3,0">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="bd" CornerRadius="5" Padding="6,2" Background="#18FFFFFF">
                                                                                    <TextBlock Text="30m" FontSize="9.5" Foreground="White"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <DataTrigger Binding="{Binding DataContext.NewCalendarDurationMinutes, RelativeSource={RelativeSource AncestorType=Window}}" Value="30">
                                                                                        <Setter TargetName="bd" Property="Background" Value="#4000E5FF"/>
                                                                                    </DataTrigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                    <Button Command="{Binding SelectEventDurationCommand}" CommandParameter="60" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,3,0">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="bd" CornerRadius="5" Padding="6,2" Background="#18FFFFFF">
                                                                                    <TextBlock Text="1h" FontSize="9.5" Foreground="White"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <DataTrigger Binding="{Binding DataContext.NewCalendarDurationMinutes, RelativeSource={RelativeSource AncestorType=Window}}" Value="60">
                                                                                        <Setter TargetName="bd" Property="Background" Value="#4000E5FF"/>
                                                                                    </DataTrigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                    <Button Command="{Binding SelectEventDurationCommand}" CommandParameter="120" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="bd" CornerRadius="5" Padding="6,2" Background="#18FFFFFF">
                                                                                    <TextBlock Text="2h" FontSize="9.5" Foreground="White"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <DataTrigger Binding="{Binding DataContext.NewCalendarDurationMinutes, RelativeSource={RelativeSource AncestorType=Window}}" Value="120">
                                                                                        <Setter TargetName="bd" Property="Background" Value="#4000E5FF"/>
                                                                                    </DataTrigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                </StackPanel>
                                                            </DockPanel>

                                                            <Border Background="#18000000" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="6" Padding="7,3">
                                                                <Grid>
                                                                    <TextBlock Text="Location or meeting link (optional)..." Foreground="#52FFFFFF" FontSize="10" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding NewCalendarLocation}" Value="">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBox Text="{Binding NewCalendarLocation, UpdateSourceTrigger=PropertyChanged}"
                                                                             Background="Transparent" Foreground="White" CaretBrush="#00E5FF" BorderThickness="0" FontSize="10.5"/>
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Accent Color Tag & Save Action -->
                                                    <DockPanel LastChildFill="False">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                                            <Button Command="{Binding SelectCalendarAccentCommand}" CommandParameter="#FF5E36" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,4,0">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="ring" Width="19" Height="19" CornerRadius="9.5" BorderThickness="1.5" BorderBrush="Transparent" Padding="2">
                                                                            <Ellipse Fill="#FF5E36"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.NewCalendarAccentHex, RelativeSource={RelativeSource AncestorType=Window}}" Value="#FF5E36">
                                                                                <Setter TargetName="ring" Property="BorderBrush" Value="White"/>
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                            <Button Command="{Binding SelectCalendarAccentCommand}" CommandParameter="#00E5FF" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,4,0">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="ring" Width="19" Height="19" CornerRadius="9.5" BorderThickness="1.5" BorderBrush="Transparent" Padding="2">
                                                                            <Ellipse Fill="#00E5FF"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.NewCalendarAccentHex, RelativeSource={RelativeSource AncestorType=Window}}" Value="#00E5FF">
                                                                                <Setter TargetName="ring" Property="BorderBrush" Value="White"/>
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                            <Button Command="{Binding SelectCalendarAccentCommand}" CommandParameter="#69F0AE" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,4,0">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="ring" Width="19" Height="19" CornerRadius="9.5" BorderThickness="1.5" BorderBrush="Transparent" Padding="2">
                                                                            <Ellipse Fill="#69F0AE"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.NewCalendarAccentHex, RelativeSource={RelativeSource AncestorType=Window}}" Value="#69F0AE">
                                                                                <Setter TargetName="ring" Property="BorderBrush" Value="White"/>
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                            <Button Command="{Binding SelectCalendarAccentCommand}" CommandParameter="#FFD600" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="ring" Width="19" Height="19" CornerRadius="9.5" BorderThickness="1.5" BorderBrush="Transparent" Padding="2">
                                                                            <Ellipse Fill="#FFD600"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.NewCalendarAccentHex, RelativeSource={RelativeSource AncestorType=Window}}" Value="#FFD600">
                                                                                <Setter TargetName="ring" Property="BorderBrush" Value="White"/>
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </StackPanel>

                                                        <Button Command="{Binding SaveNewCalendarItemCommand}" IsEnabled="{Binding CanSaveCalendarItem}" DockPanel.Dock="Right" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="saveBd" CornerRadius="8" Padding="14,4.5" Background="#FF5E36">
                                                                        <TextBlock Text="{Binding DataContext.ComposerSaveButtonText, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="saveBd" Property="Background" Value="#FF7048"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter TargetName="saveBd" Property="Background" Value="#26FFFFFF"/>
                                                                            <Setter Property="Opacity" Value="0.45"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                        </ScrollViewer>

                                        <!-- Day Schedule View (visible when composer is closed) -->
                                        <Grid Grid.Row="1">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAddingCalendarEvent}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Sticky Overdue Today Rescue Banner -->
                                            <Border Grid.Row="0" Background="#24FF5E36" BorderBrush="#65FF5E36" BorderThickness="1" CornerRadius="8" Padding="8,4.5" Margin="0,0,0,6"
                                                    Visibility="{Binding Calendar.HasOverdueToday, Converter={StaticResource BoolToVis}}">
                                                <DockPanel LastChildFill="True">
                                                    <Button Command="{Binding SnoozeAllOverdueCommand}" DockPanel.Dock="Right" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="6,0,0,0">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="snzAll" Background="#32FFD54F" BorderBrush="#75FFD54F" BorderThickness="1" CornerRadius="6" Padding="7,2">
                                                                    <TextBlock Text="Snooze All" Foreground="#FFE89E" FontSize="9.5" FontWeight="Bold"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="snzAll" Property="Background" Value="#4CFFD54F"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEA8F;" Foreground="#FF7E5A" FontSize="10.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Calendar.OverdueBannerText}" Foreground="#FFE6DE" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>

                                            <!-- Agenda Filter Chips (All | Reminders | Events) -->
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                                                <Button Command="{Binding SetCalendarAgendaFilterCommand}" CommandParameter="0" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,4,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="fBd" CornerRadius="7" Padding="8,3" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                                                <TextBlock x:Name="fTxt" Text="All" FontSize="10" FontWeight="SemiBold" Foreground="#A8ACB4"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.CalendarAgendaFilterIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="0">
                                                                    <Setter TargetName="fBd" Property="Background" Value="#2CFFFFFF"/>
                                                                    <Setter TargetName="fTxt" Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Command="{Binding SetCalendarAgendaFilterCommand}" CommandParameter="1" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,4,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="fBd" CornerRadius="7" Padding="8,3" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                                                <TextBlock x:Name="fTxt" Text="Reminders" FontSize="10" FontWeight="SemiBold" Foreground="#A8ACB4"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.CalendarAgendaFilterIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="1">
                                                                    <Setter TargetName="fBd" Property="Background" Value="#2EFF5E36"/>
                                                                    <Setter TargetName="fBd" Property="BorderBrush" Value="#70FF5E36"/>
                                                                    <Setter TargetName="fTxt" Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Command="{Binding SetCalendarAgendaFilterCommand}" CommandParameter="2" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="fBd" CornerRadius="7" Padding="8,3" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                                                <TextBlock x:Name="fTxt" Text="Events" FontSize="10" FontWeight="SemiBold" Foreground="#A8ACB4"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.CalendarAgendaFilterIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="2">
                                                                    <Setter TargetName="fBd" Property="Background" Value="#2A00E5FF"/>
                                                                    <Setter TargetName="fBd" Property="BorderBrush" Value="#6800E5FF"/>
                                                                    <Setter TargetName="fTxt" Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>

                                            <!-- Empty Day Agenda State -->
                                            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Calendar.SelectedDayItems.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE787;" FontSize="22" Foreground="#38FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                <TextBlock Foreground="#75FFFFFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="No matching items"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CalendarAgendaFilterIndex}" Value="0">
                                                                    <Setter Property="Text" Value="Nothing scheduled here"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="Tap + New for a Reminder or Event" Foreground="#48FFFFFF" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Differentiated Events & Reminders List -->
                                            <ListBox Grid.Row="2" ItemsSource="{Binding Calendar.SelectedDayItems}"
                                                     Background="Transparent" BorderThickness="0"
                                                     ItemContainerStyle="{StaticResource NoHighlightListBoxItem}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="10" Padding="8,6" Margin="0,2.5" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#12FFFFFF"/>
                                                                    <Setter Property="BorderBrush" Value="#1EFFFFFF"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEvent}" Value="True">
                                                                            <Setter Property="Background" Value="#12182430"/>
                                                                            <Setter Property="BorderBrush" Value="#2400E5FF"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                            <Setter Property="Background" Value="#1CFF5E36"/>
                                                                            <Setter Property="BorderBrush" Value="#60FF5E36"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsHappeningNow}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#7069F0AE"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>

                                                            <DockPanel LastChildFill="True">
                                                                <!-- Right: Edit + Delete Actions -->
                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                    <Button Style="{StaticResource NotchIconBtn}"
                                                                            Command="{Binding DataContext.EditCalendarItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            Padding="4,2" ToolTip="Edit">
                                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70F;" FontSize="9.5" Foreground="#78FFFFFF"/>
                                                                    </Button>
                                                                    <Button Style="{StaticResource NotchIconBtn}"
                                                                            Command="{Binding DataContext.RemoveCalendarItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            Padding="4,2" ToolTip="Delete">
                                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" FontSize="9.5" Foreground="#68FFFFFF"/>
                                                                    </Button>
                                                                </StackPanel>

                                                                <!-- Circular Interactive Reminder Checkbox -->
                                                                <Button Command="{Binding DataContext.ToggleCalendarItemCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Visibility="{Binding IsReminder, Converter={StaticResource BoolToVis}}"
                                                                        DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="chk" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" BorderBrush="{Binding AccentHex}" Background="Transparent">
                                                                                <TextBlock x:Name="tick" FontFamily="Segoe Fluent Icons" Text="&#xE73E;" FontSize="9.5" Foreground="#101216" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                    <Setter TargetName="chk" Property="Background" Value="{Binding AccentHex}"/>
                                                                                    <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>

                                                                <!-- Vertical Accent Block Strip for Calendar Events -->
                                                                <Border Width="4" Height="24" CornerRadius="2" Background="{Binding AccentHex}" Margin="0,0,8,0" DockPanel.Dock="Left" VerticalAlignment="Center"
                                                                        Visibility="{Binding IsEvent, Converter={StaticResource BoolToVis}}"/>

                                                                <StackPanel VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="★ " Foreground="#FFD54F" FontSize="10.5" FontWeight="Bold"
                                                                                   Visibility="{Binding IsHighPriority, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="155" VerticalAlignment="Center">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="White"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                            <Setter Property="Foreground" Value="#60FFFFFF"/>
                                                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>

                                                                        <!-- Live Countdown / Overdue Pill -->
                                                                        <Border CornerRadius="5" Padding="5,1" Margin="6,0,0,0" Background="#1EFFFFFF"
                                                                                Visibility="{Binding HasRelativeStatus, Converter={StaticResource BoolToVis}}">
                                                                            <TextBlock Text="{Binding RelativeStatusText}" Foreground="{Binding StatusBadgeBrushHex}" FontSize="8.5" FontWeight="Bold"/>
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <StackPanel Orientation="Horizontal" Margin="0,1.5,0,0">
                                                                        <TextBlock Text="{Binding DisplayTime}" Foreground="#A0A5B0" FontSize="9.5" FontWeight="Medium"/>
                                                                        <TextBlock Text=" • " Foreground="#45FFFFFF" FontSize="9.5"/>
                                                                        <TextBlock Text="{Binding TypeTagText}" Foreground="{Binding AccentHex}" FontSize="9.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="115"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 5: REDESIGNED SYSTEM TELEMETRY (Compute & GPU Top + Battery/Network/Storage Bottom) -->
                        <TabItem Style="{StaticResource FluentSegmentedTabItem}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D9;" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Resources" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid Margin="0,2,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1.15*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- TOP ROW: Compute (CPU + RAM + Disk) | Graphics Adapters (Per-GPU Name, Active State & Separate VRAM) -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.96*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1.28*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Card A: Compute (CPU & RAM + Disk pill) -->
                                    <Border Grid.Column="0" Style="{StaticResource BentoCard}" Padding="13,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE950;" FontSize="12" Foreground="#FF5E36" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Compute &amp; Memory" Foreground="#9A9CA2" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- CPU Column -->
                                                <Grid Grid.Column="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                        <TextBlock Text="{Binding CpuPercent, StringFormat='{}{0}%'}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                                        <TextBlock Text="CPU" Foreground="#8E9098" FontSize="10.5" FontWeight="SemiBold" Margin="6,0,0,3" VerticalAlignment="Bottom"/>
                                                    </StackPanel>
                                                    <Grid Grid.Row="1" Height="30" VerticalAlignment="Bottom" ClipToBounds="True">
                                                        <Polygon Points="{Binding CpuAreaPoints}" Stretch="Fill">
                                                            <Polygon.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#45FF5E36" Offset="0"/>
                                                                    <GradientStop Color="#00FF5E36" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Polygon.Fill>
                                                        </Polygon>
                                                        <Polyline Points="{Binding CpuGraphPoints}" Stroke="#FF5E36" StrokeThickness="1.7" Stretch="Fill"/>
                                                    </Grid>
                                                </Grid>

                                                <!-- RAM Column -->
                                                <Grid Grid.Column="2">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                            <TextBlock Text="{Binding MemoryPercent, StringFormat='{}{0}%'}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                                            <TextBlock Text="RAM" Foreground="#8E9098" FontSize="10.5" FontWeight="SemiBold" Margin="6,0,0,3" VerticalAlignment="Bottom"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding RamText}" Foreground="#78FFFFFF" FontSize="9.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,-1,0,0"/>
                                                    </StackPanel>
                                                    <Grid Grid.Row="1" Height="30" VerticalAlignment="Bottom" ClipToBounds="True">
                                                        <Polygon Points="{Binding RamAreaPoints}" Stretch="Fill">
                                                            <Polygon.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#4500E5FF" Offset="0"/>
                                                                    <GradientStop Color="#0000E5FF" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Polygon.Fill>
                                                        </Polygon>
                                                        <Polyline Points="{Binding RamGraphPoints}" Stroke="#00E5FF" StrokeThickness="1.7" Stretch="Fill"/>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Card B: Graphics Adapters (Shows Both GPUs with Name, Active Indicator & Separate VRAM) -->
                                    <Border Grid.Column="2" Style="{StaticResource BentoCard}" Padding="13,10">
                                        <Grid>
                                            <!-- Multi-GPU View (e.g. Discrete + Integrated GPU) -->
                                            <Grid Visibility="{Binding HasMultipleGpus, Converter={StaticResource BoolToVis}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7F4;" FontSize="12" Foreground="#FF5E36" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Graphics Adapters" Foreground="#9A9CA2" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Active Load &amp; VRAM" Foreground="#60FFFFFF" FontSize="9.5" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                                </DockPanel>

                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding GpuAdapters}" VerticalAlignment="Center">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#0EFFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="9" Padding="8,5" Margin="0,2">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>

                                                                        <DockPanel Grid.Row="0" LastChildFill="True">
                                                                            <TextBlock Text="{Binding GpuPercent, StringFormat='{}{0}%'}"
                                                                                       Foreground="White" FontSize="13.5" FontWeight="Bold"
                                                                                       DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                                            <Border DockPanel.Dock="Right" Margin="6,0,0,0" Padding="5,1" CornerRadius="5"
                                                                                    Background="#24FF5E36" BorderBrush="#60FF5E36" BorderThickness="0.8"
                                                                                    VerticalAlignment="Center"
                                                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                                                <TextBlock Text="IN USE" Foreground="#FF5E36" FontSize="8.5" FontWeight="Bold"/>
                                                                            </Border>
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <Border Background="#1FFFFFFF" CornerRadius="4" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding RoleLabel}" FontSize="8.5" FontWeight="Bold" VerticalAlignment="Center">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="Foreground" Value="#40C4FF"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsDiscrete}" Value="True">
                                                                                                        <Setter Property="Foreground" Value="#69F0AE"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                </Border>
                                                                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}"
                                                                                           Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                                                           MaxWidth="175" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </DockPanel>

                                                                        <Grid Grid.Row="1" Margin="0,3,0,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="8"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding VramText}" Foreground="#69F0AE" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                            <ProgressBar Grid.Column="2" Height="4" Background="#22252C" VerticalAlignment="Center"
                                                                                         Value="{Binding GpuPercent, Mode=OneWay}" Maximum="100">
                                                                                <ProgressBar.Style>
                                                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource MetricProgressBarStyle}">
                                                                                        <Setter Property="Height" Value="4"/>
                                                                                        <Setter Property="Foreground" Value="#40C4FF"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsDiscrete}" Value="True">
                                                                                                <Setter Property="Foreground" Value="#69F0AE"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </ProgressBar.Style>
                                                                            </ProgressBar>
                                                                        </Grid>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>

                                            <!-- Single-GPU Hero View -->
                                            <Grid Visibility="{Binding HasSingleGpu, Converter={StaticResource BoolToVis}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7F4;" FontSize="12" Foreground="#FF5E36" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ActiveGpuName}" ToolTip="{Binding ActiveGpuName}" Foreground="#D8FFFFFF" FontSize="11.5" FontWeight="SemiBold"
                                                                   MaxWidth="175" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Border Style="{StaticResource MicroPillBadge}" DockPanel.Dock="Right" Padding="8,2" Background="#1E69F0AE" BorderBrush="#4069F0AE">
                                                        <TextBlock Text="{Binding VramText}" Foreground="#69F0AE" FontSize="10.5" FontWeight="Bold"/>
                                                    </Border>
                                                </DockPanel>

                                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GpuPercent, StringFormat='{}{0}%'}" Foreground="White" FontSize="25" FontWeight="Bold"/>
                                                    <TextBlock Text="3D / Compute Load" Foreground="#8E9098" FontSize="10.5" Margin="9,0,0,4" VerticalAlignment="Bottom"/>
                                                </StackPanel>

                                                <Grid Grid.Row="2" Height="30" VerticalAlignment="Bottom" ClipToBounds="True">
                                                    <Polygon Points="{Binding GpuAreaPoints}" Stretch="Fill">
                                                        <Polygon.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#4569F0AE" Offset="0"/>
                                                                <GradientStop Color="#0069F0AE" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Polygon.Fill>
                                                    </Polygon>
                                                    <Polyline Points="{Binding GpuGraphPoints}" Stroke="#69F0AE" StrokeThickness="1.7" Stretch="Fill"/>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- BOTTOM ROW: 2 Bento Cards (Network | Storage & Volume) — Battery moved to bottom bar -->
                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Card 4: Network -->
                                    <Border Grid.Column="0" Style="{StaticResource BentoCard}" Padding="12,9">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE701;" FontSize="12" Foreground="#FF5E36" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding NetworkName}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                <DockPanel LastChildFill="True" Margin="0,1">
                                                    <Grid Width="48" Height="14" ClipToBounds="True" DockPanel.Dock="Right">
                                                        <Polygon Points="{Binding DownloadAreaPoints}" Stretch="Fill">
                                                            <Polygon.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#45FF5E36" Offset="0"/>
                                                                    <GradientStop Color="#00FF5E36" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Polygon.Fill>
                                                        </Polygon>
                                                        <Polyline Points="{Binding DownloadGraphPoints}" Stroke="#FF5E36" StrokeThickness="1.4" Stretch="Fill"/>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="↓ " Foreground="#FF5E36" FontSize="11" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding DownloadSpeedText}" Foreground="White" FontSize="11.5" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <DockPanel LastChildFill="True" Margin="0,4,0,0">
                                                    <Grid Width="48" Height="14" ClipToBounds="True" DockPanel.Dock="Right">
                                                        <Polygon Points="{Binding UploadAreaPoints}" Stretch="Fill">
                                                            <Polygon.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#40FF8A65" Offset="0"/>
                                                                    <GradientStop Color="#00FF8A65" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Polygon.Fill>
                                                        </Polygon>
                                                        <Polyline Points="{Binding UploadGraphPoints}" Stroke="#FF8A65" StrokeThickness="1.4" Stretch="Fill"/>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="↑ " Foreground="#FF8A65" FontSize="11" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding UploadSpeedText}" Foreground="#D8FFFFFF" FontSize="11.5" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Row="2" Text="{Binding NetworkDetail}" Foreground="#75FFFFFF" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>

                                    <!-- Card 5: Storage & Volume Toggleable -->
                                    <Border Grid.Column="2" Style="{StaticResource BentoCard}" Padding="12,9">
                                        <Grid>
                                            <!-- Storage Mode -->
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsResourceVolumeMode}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <DockPanel Grid.Row="0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEDA2;" FontSize="12" Foreground="#FF5E36" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Storage" Foreground="#9A9CA2" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ToggleResourceCard4ModeCommand}" ToolTip="Switch to Volume Control" Padding="4,2" Margin="0,0,2,0">
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE767;" FontSize="10.5" Foreground="#80FFFFFF"/>
                                                        </Button>
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ToggleDriveMenuCommand}" Padding="4,2">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SelectedDrive.DisplayName}" MaxWidth="62" TextTrimming="CharacterEllipsis" Foreground="#B0B4BC" FontSize="10"/>
                                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70D;" Foreground="#80FFFFFF" FontSize="8" Margin="3,1,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </DockPanel>

                                                <Border Grid.Row="0" Grid.RowSpan="3"
                                                        Tag="MenuPopup"
                                                        Visibility="{Binding IsDriveMenuOpen, Converter={StaticResource BoolToVis}}"
                                                        Background="#F61A1C20" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10"
                                                        Padding="5" Panel.ZIndex="10" VerticalAlignment="Top" HorizontalAlignment="Right"
                                                        Margin="0,22,0,0" MinWidth="160" MaxHeight="135">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                        <StackPanel>
                                                            <TextBlock Text="SELECT DRIVE" Foreground="#65FFFFFF" FontSize="9" FontWeight="Bold" Margin="5,2,4,3"/>
                                                            <ItemsControl ItemsSource="{Binding Drives}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Style="{StaticResource NotchIconBtn}"
                                                                                Command="{Binding DataContext.SelectDriveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"
                                                                                HorizontalContentAlignment="Stretch"
                                                                                Padding="5,3" Margin="0,1">
                                                                            <DockPanel LastChildFill="True">
                                                                                <TextBlock Text="{Binding FreeGb, StringFormat='{}{0:F0}G free'}" Foreground="#80FFFFFF" FontSize="9.5" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                                                                <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                                                                            </DockPanel>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Border>

                                                <DockPanel Grid.Row="1" VerticalAlignment="Center" LastChildFill="True">
                                                    <Border Style="{StaticResource MicroPillBadge}"
                                                            DockPanel.Dock="Right"
                                                            VerticalAlignment="Top"
                                                            Padding="7,2"
                                                            Margin="8,2,0,0"
                                                            ToolTip="Physical Disk Active Time">
                                                        <TextBlock Text="{Binding DiskPercent, StringFormat='{}Disk {0}%'}" Foreground="#D8FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedDrive.UsedPercent, Mode=OneWay, StringFormat='{}{0}%'}"
                                                                   Foreground="White" FontSize="22" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding SelectedDrive.SummaryText, Mode=OneWay}"
                                                                   Foreground="#9A9CA2" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <ProgressBar Grid.Row="2" Style="{StaticResource MetricProgressBarStyle}"
                                                             Value="{Binding SelectedDrive.UsedPercent, Mode=OneWay}" Maximum="100"/>
                                            </Grid>

                                            <!-- Volume Mode -->
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsResourceVolumeMode}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <DockPanel Grid.Row="0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE767;" FontSize="12" Foreground="#FF5E36" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Volume" Foreground="#9A9CA2" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ToggleResourceCard4ModeCommand}" ToolTip="Switch to Storage Monitor" Padding="4,2" Margin="0,0,2,0">
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEDA2;" FontSize="10.5" Foreground="#80FFFFFF"/>
                                                        </Button>
                                                        <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ToggleAudioDeviceMenuCommand}" Padding="4,2">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ActiveAudioDeviceName}" MaxWidth="62" TextTrimming="CharacterEllipsis" Foreground="#B0B4BC" FontSize="10"/>
                                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70D;" Foreground="#80FFFFFF" FontSize="8" Margin="3,1,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </DockPanel>

                                                <Border Grid.Row="0" Grid.RowSpan="3"
                                                        Tag="MenuPopup"
                                                        Visibility="{Binding IsAudioDeviceMenuOpen, Converter={StaticResource BoolToVis}}"
                                                        Background="#F61A1C20" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10"
                                                        Padding="5" Panel.ZIndex="10" VerticalAlignment="Top" HorizontalAlignment="Right"
                                                        Margin="0,22,0,0" MinWidth="175" MaxHeight="135">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                        <StackPanel>
                                                            <TextBlock Text="PLAYBACK DEVICE" Foreground="#65FFFFFF" FontSize="9" FontWeight="Bold" Margin="5,2,4,3"/>
                                                            <ItemsControl ItemsSource="{Binding AudioDevices}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Style="{StaticResource NotchIconBtn}"
                                                                                Command="{Binding DataContext.SelectAudioDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"
                                                                                HorizontalContentAlignment="Stretch"
                                                                                Padding="5,3" Margin="0,1">
                                                                            <DockPanel LastChildFill="True">
                                                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE73E;" Foreground="#FF5E36" FontSize="10" Margin="5,0,0,0" DockPanel.Dock="Right"
                                                                                           Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"/>
                                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="5,0,0,0"
                                                                                            Visibility="{Binding HasBluetoothBattery, Converter={StaticResource BoolToVis}}">
                                                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEBA0;" Foreground="#69F0AE" FontSize="9" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding BluetoothBatteryText}" Foreground="#69F0AE" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="10.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                            </DockPanel>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Border>

                                                <TextBlock Grid.Row="1" Text="{Binding MasterVolume, StringFormat='{}{0:F0}%'}" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>

                                                <DockPanel Grid.Row="2" VerticalAlignment="Bottom">
                                                    <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ToggleMuteCommand}" DockPanel.Dock="Right" Padding="4,0" Margin="6,0,0,0">
                                                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="#9A9CA2" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="&#xE767;"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                            <Setter Property="Text" Value="&#xE74F;"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>

                                                    <Slider Style="{StaticResource FluentVolumeSlider}"
                                                            Value="{Binding MasterVolume, Mode=TwoWay}" Minimum="0" Maximum="100" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 6: TOOLS & QUICK SCRATCHPAD -->
                        <TabItem Style="{StaticResource FluentSegmentedTabItem}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEC7A;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tools" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid Margin="2,2,2,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="262"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Bento Control Center: Brightness Slider + Utility Actions + Quick Launchers -->
                                <Border Grid.Column="0" Style="{StaticResource BentoCard}" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top Display Brightness Control Card -->
                                        <Border Grid.Row="0" Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="10" Padding="9,7" Margin="0,0,0,8"
                                                ToolTip="{Binding BrightnessTooltip}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBrightnessSupported}" Value="False">
                                                            <Setter Property="Opacity" Value="0.45"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE706;" FontSize="13" Foreground="#FFD54F" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DisplayBrightness, StringFormat='{}{0}%'}" Foreground="White" FontSize="11.5" FontWeight="Bold" DockPanel.Dock="Right" Width="34" TextAlignment="Right" VerticalAlignment="Center"/>
                                                <Slider Style="{StaticResource FluentVolumeSlider}"
                                                        Value="{Binding DisplayBrightness, Mode=TwoWay}"
                                                        IsEnabled="{Binding IsBrightnessSupported}"
                                                        Minimum="0" Maximum="100"
                                                        VerticalAlignment="Center"
                                                        Margin="2,0,4,0"/>
                                            </DockPanel>
                                        </Border>

                                        <!-- Middle 2x2 Smart Action Tiles -->
                                        <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="0,0,0,8">
                                            <!-- Eyedropper Color Picker -->
                                            <Button Style="{StaticResource BentoTileBtn}" Command="{Binding PickScreenColorCommand}" Margin="0,0,6,6" ToolTip="Sample any screen pixel &amp; copy #RRGGBB">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEF3C;" FontSize="13.5" Foreground="#00E5FF" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Color Pick" Foreground="White" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Stay Awake Toggle -->
                                            <Button Command="{Binding ToggleStayAwakeCommand}" Margin="0,0,0,6">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BentoTileBtn}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStayAwakeEnabled}" Value="True">
                                                                <Setter Property="Background" Value="#28FF5E36"/>
                                                                <Setter Property="BorderBrush" Value="#70FF5E36"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7E8;" FontSize="13.5" Margin="0,0,7,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#8E9098"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsStayAwakeEnabled}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FF5E36"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Awake Off"/>
                                                                <Setter Property="Foreground" Value="#D0FFFFFF"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsStayAwakeEnabled}" Value="True">
                                                                        <Setter Property="Text" Value="Awake On"/>
                                                                        <Setter Property="Foreground" Value="White"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>

                                            <!-- Saved Snips Folder -->
                                            <Button Style="{StaticResource BentoTileBtn}" Command="{Binding OpenScreenshotsFolderCommand}" Margin="0,0,6,0" ToolTip="Open Saved Snips Folder">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" FontSize="13.5" Foreground="#69F0AE" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Snips" Foreground="White" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Lock PC -->
                                            <Button Style="{StaticResource BentoTileBtn}" Command="{Binding LockWorkstationCommand}" Margin="0" ToolTip="Lock Screen (Win + L)">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72E;" FontSize="13.5" Foreground="#FF5E36" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Lock PC" Foreground="White" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>

                                        <!-- Bottom Compact Quick Launch Strip -->
                                        <UniformGrid Grid.Row="2" Columns="4">
                                            <Button Style="{StaticResource BentoTileBtn}" Command="{Binding OpenTaskManagerCommand}" Padding="6,7" Margin="0,0,4,0" ToolTip="Task Manager">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D9;" FontSize="13.5" Foreground="#D8FFFFFF" HorizontalAlignment="Center"/>
                                            </Button>
                                            <Button Style="{StaticResource BentoTileBtn}" Command="{Binding OpenTerminalCommand}" Padding="6,7" Margin="0,0,4,0" ToolTip="Windows Terminal">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE756;" FontSize="13.5" Foreground="#D8FFFFFF" HorizontalAlignment="Center"/>
                                            </Button>
                                            <Button Style="{StaticResource BentoTileBtn}" Command="{Binding OpenBluetoothSettingsCommand}" Padding="6,7" Margin="0,0,4,0" ToolTip="Bluetooth &amp; Devices">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE702;" FontSize="13.5" Foreground="#40C4FF" HorizontalAlignment="Center"/>
                                            </Button>
                                            <Button Style="{StaticResource BentoTileBtn}" Command="{Binding OpenCalculatorCommand}" Padding="6,7" Margin="0" ToolTip="Calculator">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8EF;" FontSize="13.5" Foreground="#D8FFFFFF" HorizontalAlignment="Center"/>
                                            </Button>
                                        </UniformGrid>
                                    </Grid>
                                </Border>

                                <!-- Right Bento Deck: Persistent Quick Scratchpad -->
                                <Border Grid.Column="2" Style="{StaticResource BentoCard}" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70F;" FontSize="12.5" Foreground="#FF5E36" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Quick Scratchpad" Foreground="White" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Text=" • Auto-saved" Foreground="#60FFFFFF" FontSize="10.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding CopyScratchpadCommand}" Padding="6,3" Margin="0,0,4,0" ToolTip="Copy Scratchpad">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="11.5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#xE8C8;"/>
                                                                <Setter Property="Foreground" Value="#B0FFFFFF"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ScratchpadCopied}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE73E;"/>
                                                                        <Setter Property="Foreground" Value="#69F0AE"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ClearScratchpadCommand}" Padding="6,3" ToolTip="Clear Scratchpad">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" FontSize="11.5" Foreground="#80FFFFFF"/>
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <Border Grid.Row="1" Background="#0EFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10" Padding="4">
                                            <Grid>
                                                <TextBlock Text="Jot down quick notes, links, or snippets..." Foreground="#48FFFFFF" FontSize="12" Margin="9,7,9,0"
                                                           VerticalAlignment="Top" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ScratchpadText}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox Text="{Binding ScratchpadText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Background="Transparent"
                                                         Foreground="White"
                                                         CaretBrush="#FF5E36"
                                                         BorderThickness="0"
                                                         Padding="6"
                                                         FontSize="12"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 7: FILE SHARE (GOOGLE QUICK SHARE INTEGRATION) -->
                        <TabItem Style="{StaticResource FluentSegmentedTabItem}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72D;" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Share" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid Margin="2,2,2,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="0.85*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Send Queue + Drop Zone + CTA -->
                                <Border Grid.Column="0" Style="{StaticResource BentoCard}" Padding="11,9">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header + Action Pills -->
                                        <DockPanel Grid.Row="0" Margin="0,0,0,7">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72D;" FontSize="12" Foreground="#FF5E36" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Send Queue" Foreground="White" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Border Background="#20FFFFFF" CornerRadius="7" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ShareQueue.Count}" Foreground="#E0FFFFFF" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding BrowseShareFilesCommand}" Background="#16FFFFFF" Padding="6,3" ToolTip="Browse Files">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" FontSize="9.5" Foreground="#FF5E36" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Files" FontSize="10" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding PullDockToShareCommand}" Background="#14FFFFFF" Padding="6,3" Margin="4,0,0,0" ToolTip="Import Staged Dock Files">
                                                    <TextBlock Text="Dock" FontSize="10" FontWeight="SemiBold" Foreground="#D8FFFFFF"/>
                                                </Button>
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding AddClipboardToShareCommand}" Background="#14FFFFFF" Padding="6,3" Margin="4,0,0,0" ToolTip="Share Latest Clipboard Text/Image">
                                                    <TextBlock Text="Clip" FontSize="10" FontWeight="SemiBold" Foreground="#D8FFFFFF"/>
                                                </Button>
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ClearShareQueueCommand}" IsEnabled="{Binding HasShareQueueItems}" Background="#14FFFFFF" Padding="5,3" Margin="4,0,0,0" ToolTip="Clear Queue">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" FontSize="10" Foreground="#A0FFFFFF"/>
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Empty Drop State -->
                                        <Border Grid.Row="1" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="10" Background="#0AFFFFFF" Padding="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasShareQueueItems}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE898;" FontSize="24" Foreground="#48FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                <TextBlock Text="Drop files or folders to share" Foreground="#90FFFFFF" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Or pick Files / pull from Dock / share Clipboard" Foreground="#58FFFFFF" FontSize="10" TextAlignment="Center" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Queued Items List -->
                                        <ListBox Grid.Row="1" ItemsSource="{Binding ShareQueue}"
                                                 Visibility="{Binding HasShareQueueItems, Converter={StaticResource BoolToVis}}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ItemContainerStyle="{StaticResource NoHighlightListBoxItem}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#12FFFFFF" BorderBrush="#1EFFFFFF" BorderThickness="1" CornerRadius="9" Padding="7,5" Margin="0,2">
                                                        <DockPanel LastChildFill="True">
                                                            <Button Style="{StaticResource NotchIconBtn}"
                                                                    Command="{Binding DataContext.RemoveShareItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    DockPanel.Dock="Right" Padding="4,2" ToolTip="Remove from queue">
                                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" FontSize="9.5" Foreground="#75FFFFFF"/>
                                                            </Button>
                                                            <TextBlock Text="{Binding FormattedSize}" DockPanel.Dock="Right"
                                                                       Foreground="#75FFFFFF" FontSize="10" Margin="6,0" VerticalAlignment="Center"/>
                                                            <Border Width="22" Height="22" CornerRadius="5" Background="#18FFFFFF" Margin="0,0,8,0" ClipToBounds="True" VerticalAlignment="Center">
                                                                <Grid>
                                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" FontSize="10" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="11.5" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Status feedback -->
                                        <TextBlock Grid.Row="2" Text="{Binding ShareActionFeedback}" Foreground="#989BA4" FontSize="10"
                                                   Margin="2,5,2,4" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShareActionFeedback}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Hero Send Button -->
                                        <Button Grid.Row="3" Command="{Binding SendWithQuickShareCommand}"
                                                IsEnabled="{Binding HasShareQueueItems}"
                                                Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,6,0,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="btnBd" Background="#FF5E36" CornerRadius="10" Padding="12,8">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72D;" Foreground="White" FontSize="12.5" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ShareQueueSummaryText}" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="btnBd" Property="Background" Value="#FF7048"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="btnBd" Property="Background" Value="#24FFFFFF"/>
                                                            <Setter Property="Opacity" Value="0.55"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Right Column: Google Quick Share Engine Status + Recent Transfers -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Quick Share Hub Status & Controls -->
                                    <Border Grid.Row="0" Style="{StaticResource BentoCard}" Padding="11,9">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#FFB300"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsQuickShareInstalled}" Value="True">
                                                                        <Setter Property="Fill" Value="#69F0AE"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="Google Quick Share" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <TextBlock Text="{Binding QuickShareStatusText}" Foreground="#989BA4" FontSize="10.5"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0" Style="{StaticResource BentoTileBtn}" Command="{Binding OpenQuickShareAppCommand}" Padding="9,6"
                                                        ToolTip="Open or download Google Quick Share">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE896;" FontSize="11.5" Foreground="#69F0AE" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Get Quick Share"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsQuickShareInstalled}" Value="True">
                                                                            <Setter Property="Text" Value="Receive / Open App"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Button>

                                                <Button Grid.Column="2" Style="{StaticResource BentoTileBtn}" Command="{Binding OpenDownloadsFolderCommand}" Padding="9,6"
                                                        ToolTip="Open Downloads Folder">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" FontSize="12" Foreground="#FF5E36"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Recent Shares History -->
                                    <Border Grid.Row="2" Style="{StaticResource BentoCard}" Padding="11,9">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                                <TextBlock Text="RECENT SHARES" Foreground="#75FFFFFF" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ClearShareHistoryCommand}"
                                                        DockPanel.Dock="Right" Padding="4,2" ToolTip="Clear Share History"
                                                        Visibility="{Binding HasShareHistory, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE74D;" FontSize="10" Foreground="#80FFFFFF"/>
                                                </Button>
                                            </DockPanel>

                                            <TextBlock Grid.Row="1" Text="Sent files appear here for one-click resend."
                                                       Foreground="#55FFFFFF" FontSize="10.5" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasShareHistory}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <ListBox Grid.Row="1" ItemsSource="{Binding ShareHistory}"
                                                     Visibility="{Binding HasShareHistory, Converter={StaticResource BoolToVis}}"
                                                     Background="Transparent" BorderThickness="0"
                                                     ItemContainerStyle="{StaticResource NoHighlightListBoxItem}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#10FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="8" Padding="7,5" Margin="0,2">
                                                            <DockPanel LastChildFill="True">
                                                                <Button Style="{StaticResource NotchIconBtn}"
                                                                        Command="{Binding DataContext.ResendHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        DockPanel.Dock="Right" Padding="5,3" ToolTip="Resend via Quick Share">
                                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="10.5" Foreground="#FF5E36"/>
                                                                </Button>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Foreground="#78FFFFFF" FontSize="9.5" TextTrimming="CharacterEllipsis">
                                                                        <TextBlock.Text>
                                                                            <MultiBinding StringFormat="{}{0} • {1}">
                                                                                <Binding Path="SummaryText"/>
                                                                                <Binding Path="TimestampText"/>
                                                                            </MultiBinding>
                                                                        </TextBlock.Text>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <!-- ── Persistent Bottom Control Bar ──────────────────────── -->
                    <Border Grid.Row="1"
                            Background="#D81D2026"
                            BorderBrush="#24FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10,5"
                            Margin="0,8,0,0">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding ToggleMuteCommand}" Padding="6,3" ToolTip="Mute / Unmute">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE767;"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                        <Setter Property="Text" Value="&#xE74F;"/>
                                                        <Setter Property="Foreground" Value="#8E9098"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>

                                <Slider Style="{StaticResource FluentVolumeSlider}"
                                        Value="{Binding MasterVolume, Mode=TwoWay}"
                                        Minimum="0" Maximum="100"
                                        Width="112"
                                        VerticalAlignment="Center"
                                        Margin="6,0,10,0"/>

                                <!-- Audio Output Switcher Pill -->
                                <Border Style="{StaticResource MicroPillBadge}" Padding="7,3">
                                    <Button Style="{StaticResource NotchIconBtn}"
                                            Command="{Binding ToggleBottomAudioMenuCommand}"
                                            ToolTip="Switch Audio Output Device"
                                            Padding="1,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7F6;" FontSize="11" Foreground="#FF5E36" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ActiveAudioDeviceName}" FontSize="10.5" FontWeight="SemiBold" Foreground="White" MaxWidth="120" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0"
                                                        Visibility="{Binding HasBluetoothBattery, Converter={StaticResource BoolToVis}}">
                                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEBA0;" FontSize="9.5" Foreground="#69F0AE" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding BluetoothBatteryText}" FontSize="10" FontWeight="Bold" Foreground="#69F0AE" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70D;" Foreground="#80FFFFFF" FontSize="8.5" VerticalAlignment="Center" Margin="6,1,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Edit / Customize Home Layout trigger (visible on Home tab when not editing) -->
                                <Button Command="{Binding ToggleHomeEditModeCommand}"
                                        Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="0,0,6,0"
                                        ToolTip="Customize, resize, add, or remove Home widgets">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding SelectedTabIndex}" Value="0"/>
                                                        <Condition Binding="{Binding IsHomeEditMode}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="editBd" Background="#16FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="9" Padding="8,3">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="editIco" FontFamily="Segoe Fluent Icons" Text="&#xE70F;" Foreground="#D0FFFFFF" FontSize="9.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="editTxt" Text="Edit Home" Foreground="#E8EAEE" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="editBd" Property="Background" Value="#28FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- System Battery Micro-Pill (moved from Resources tab, beside Settings) -->
                                <Border Style="{StaticResource MicroPillBadge}" Padding="7,3" Margin="0,0,6,0"
                                        ToolTip="{Binding BatteryTooltip}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontFamily="Segoe Fluent Icons" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xEBA0;"/>
                                                    <Setter Property="Foreground" Value="#D8FFFFFF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                                            <Setter Property="Text" Value="&#xE945;"/>
                                                            <Setter Property="Foreground" Value="#69F0AE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBatteryLow}" Value="True">
                                                            <Setter Property="Foreground" Value="#FF5E36"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding BatteryPercent, StringFormat='{}{0}%'}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#E8EAEE"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                                            <Setter Property="Foreground" Value="#69F0AE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBatteryLow}" Value="True">
                                                            <Setter Property="Foreground" Value="#FF5E36"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding CaptureScreenCommand}" ToolTip="Screen Snip to Shelf" Padding="7,4">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE722;" FontSize="13.5" Foreground="#D8FFFFFF"/>
                                </Button>
                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding OpenTaskManagerCommand}" ToolTip="Task Manager" Padding="7,4" Margin="2,0,0,0">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D9;" FontSize="13.5" Foreground="#D8FFFFFF"/>
                                </Button>
                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding OpenSnippingToolCommand}" ToolTip="Snipping Tool" Padding="7,4" Margin="2,0,0,0">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8C6;" FontSize="13.5" Foreground="#D8FFFFFF"/>
                                </Button>
                                <Button Style="{StaticResource NotchIconBtn}" Command="{Binding OpenSettingsCommand}" ToolTip="Settings" Padding="7,4" Margin="2,0,0,0">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="13.5" Foreground="#FF5E36"/>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Bottom Bar Audio Output Switcher Flyout -->
                    <Border Tag="MenuPopup"
                            Visibility="{Binding IsBottomAudioMenuOpen, Converter={StaticResource BoolToVis}}"
                            Background="#F61A1C20" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="12"
                            Padding="6" Panel.ZIndex="200" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                            Margin="10,0,0,46" MinWidth="275" MaxHeight="160">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="SELECT PLAYBACK DEVICE" Foreground="#65FFFFFF" FontSize="9.5" FontWeight="Bold" Margin="6,2,4,4"/>
                                <ItemsControl ItemsSource="{Binding AudioDevices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource NotchIconBtn}"
                                                    Command="{Binding DataContext.SelectAudioDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="7,5" Margin="0,1">
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE73E;" Foreground="#FF5E36" FontSize="11" Margin="8,0,0,0" DockPanel.Dock="Right"
                                                               Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"/>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="8,0,0,0"
                                                                Visibility="{Binding HasBluetoothBattery, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xEBA0;" Foreground="#69F0AE" FontSize="9.5" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding BluetoothBatteryText}" Foreground="#69F0AE" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Smart Split Drag-and-Drop Overlay (Stage to Dock vs Send via Quick Share) -->
                    <Border Grid.Row="0" Grid.RowSpan="2"
                            Panel.ZIndex="300"
                            Visibility="{Binding IsFileDragOverlayVisible, Converter={StaticResource BoolToVis}}"
                            Background="#F216181D"
                            BorderBrush="#34FFFFFF"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header Banner / Pending Choice Bar -->
                            <DockPanel Grid.Row="0" Margin="2,0,2,10">
                                <Button DockPanel.Dock="Right"
                                        Content="Cancel"
                                        Click="OnCancelDropChoiceClick"
                                        Visibility="{Binding HasPendingDropChoice, Converter={StaticResource BoolToVis}}"
                                        Cursor="Hand" FocusVisualStyle="{x:Null}"
                                        Foreground="#C0FFFFFF" FontSize="11" FontWeight="SemiBold"
                                        Padding="10,4" Background="#18FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Text="{Binding PendingDropSummary}"
                                           Foreground="#E8EAEE" FontSize="12" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DockPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Zone: Stage in Shelf Dock -->
                                <Border x:Name="DockDropTarget"
                                        Grid.Column="0"
                                        AllowDrop="True"
                                        Cursor="Hand"
                                        DragEnter="OnDockDropTargetDragOver"
                                        DragOver="OnDockDropTargetDragOver"
                                        DragLeave="OnDockDropTargetDragLeave"
                                        Drop="OnDockDropTargetDrop"
                                        MouseLeftButtonUp="OnDockChoiceClick"
                                        CornerRadius="14"
                                        BorderThickness="1.5"
                                        Padding="18">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#14FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#2CFFFFFF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDropDockHovered}" Value="True">
                                                    <Setter Property="Background" Value="#2640C4FF"/>
                                                    <Setter Property="BorderBrush" Value="#9040C4FF"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#2640C4FF"/>
                                                    <Setter Property="BorderBrush" Value="#9040C4FF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Border Width="52" Height="52" CornerRadius="16" Background="#2040C4FF" BorderBrush="#4040C4FF" BorderThickness="1" Margin="0,0,0,12" HorizontalAlignment="Center">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" FontSize="22" Foreground="#40C4FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Stage in Dock" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Hold files on the Shelf Dock for quick access &amp; drag-out" Foreground="#88FFFFFF" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="8,5,8,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Right Zone: Instant Google Quick Share -->
                                <Border x:Name="ShareDropTarget"
                                        Grid.Column="2"
                                        AllowDrop="True"
                                        Cursor="Hand"
                                        DragEnter="OnShareDropTargetDragOver"
                                        DragOver="OnShareDropTargetDragOver"
                                        DragLeave="OnShareDropTargetDragLeave"
                                        Drop="OnShareDropTargetDrop"
                                        MouseLeftButtonUp="OnShareChoiceClick"
                                        CornerRadius="14"
                                        BorderThickness="1.5"
                                        Padding="18">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#16FF5E36"/>
                                            <Setter Property="BorderBrush" Value="#40FF5E36"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDropShareHovered}" Value="True">
                                                    <Setter Property="Background" Value="#34FF5E36"/>
                                                    <Setter Property="BorderBrush" Value="#CCFF5E36"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#34FF5E36"/>
                                                    <Setter Property="BorderBrush" Value="#CCFF5E36"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <Border Width="52" Height="52" CornerRadius="16" Background="#28FF5E36" BorderBrush="#55FF5E36" BorderThickness="1" Margin="0,0,0,12" HorizontalAlignment="Center">
                                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72D;" FontSize="22" Foreground="#FF5E36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Send with Quick Share" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Send immediately via Google Quick Share" Foreground="#98FFFFFF" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="8,5,8,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
