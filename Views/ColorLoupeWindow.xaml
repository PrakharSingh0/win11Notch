<Window x:Class="Win11Notch.Views.ColorLoupeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="Cross">
    <Grid>
        <!-- Frozen crisp desktop screenshot backdrop -->
        <Image x:Name="BackdropImage" Stretch="Fill" SnapsToDevicePixels="True" IsHitTestVisible="False"/>

        <!-- Floating Magnifier Loupe HUD positioned dynamically beside cursor -->
        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
            <Border x:Name="LoupeCard"
                    Background="#EE16181D"
                    BorderBrush="#48FFFFFF"
                    BorderThickness="1.2"
                    CornerRadius="14"
                    Padding="7">
                <StackPanel>
                    <!-- 11x11 Nearest-Neighbor Pixel Grid + Center Crosshair (99x99 exact inner canvas) -->
                    <Border Width="101" Height="101" CornerRadius="9" ClipToBounds="True"
                            BorderBrush="#35FFFFFF" BorderThickness="1" Background="#101216">
                        <Grid>
                            <Image x:Name="ZoomImage"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   Stretch="Fill"/>
                            <!-- Center Target Reticle (9x9px single zoomed pixel outline) -->
                            <Border x:Name="ReticleBox" Width="9" Height="9" BorderBrush="#FFFFFFFF" BorderThickness="1.2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ReticleShift"/>
                                </Border.RenderTransform>
                                <Border BorderBrush="#90000000" BorderThickness="0.8"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Swatch + HEX + RGB readout -->
                    <StackPanel Orientation="Horizontal" Margin="2,6,2,1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="ColorSwatch" Width="16" Height="16" CornerRadius="5"
                                BorderBrush="#60FFFFFF" BorderThickness="1" Margin="0,0,6,0"/>
                        <StackPanel>
                            <TextBlock x:Name="HexText" Text="#FF5E36" Foreground="White" FontSize="11.5" FontWeight="Bold"/>
                            <TextBlock x:Name="RgbText" Text="255, 94, 54" Foreground="#989BA4" FontSize="9.5"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Click copy • Esc cancel" Foreground="#60FFFFFF" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
